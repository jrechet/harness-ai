{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/cli/harness.py\" progress check \"$CLAUDE_PROJECT_DIR\" --hook"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/cli/harness.py\" progress remind"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/cli/harness.py\" fresh \"$CLAUDE_PROJECT_DIR\" --hook"
          }
        ]
      }
    ]
  }
}
