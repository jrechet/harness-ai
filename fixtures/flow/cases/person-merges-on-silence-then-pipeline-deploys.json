{"about": "As person-merges-then-pipeline-deploys, and the merge also happens when the person's deadline passes. That silent merge is nobody's decision: it is refused, and it does not guard the deploy after it, which is refused too.",
 "definition": "definitions/feature.json",
 "remove": ["states.human_review", "states.rework", "states.merge_auth", "states.merging.checks_premise", "states.merging.survives", "states.merging.units", "states.merging.repositories"],
 "set": {"stop_at": "deployed",
         "states.mark_ready.on.marked_ready": {"to": "merging", "reaches": "ready_pr"},
         "states.merging.type": "human", "states.merging.deadline_hours": 1,
         "states.merging.on.deadline_passed": {"to": "delivery", "reaches": "merged"}},
 "check": [{"code": "irreversible_without_gate", "where": "states.merging.on.deadline_passed"}, {"code": "irreversible_without_gate", "where": "states.delivery.on.deployed"}]}
