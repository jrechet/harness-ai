 "check": [{"code": "irreversible_without_gate", "where": "states.merging.on.merged"}, {"code": "irreversible_without_gate", "where": "states.delivery.on.deployed"}, {"code": "irreversible_without_gate", "where": "states.merging_b.on.merged"}, {"code": "irreversible_without_gate", "where": "states.delivery_b.on.deployed"}],
