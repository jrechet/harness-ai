         "states.merge_auth.on": {"merge_authorised": {"to": "merging"}, "merge_refused": {"to": "merging_b"}},
         "states.merging_b": {"type": "code", "does": "Checks the pull request is still the one approved, then puts it in the merge queue", "checks_premise": true, "survives": "restart", "units": "one", "repositories": "one", "writes": [{"what": "the merge", "key": "merge-{ticket}"}], "on": {"merged": {"to": "delivery_b", "reaches": "merged"}, "head_moved": {"to": "stopped", "reason": "head_moved"}, "merge_failed": {"to": "stopped", "reason": "merge_failed"}}},
