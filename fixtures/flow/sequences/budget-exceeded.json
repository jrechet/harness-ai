{"about": "With a budget of 2 dollars and 30 minutes: an event that lands exactly on the budget moves, the next one passes it in minutes alone and stops the run, although its transition was legal.",
 "definition": "template:feature",
 "override": {"budget": {"dollars": 2, "minutes": 30}},
 "start": "new",
 "events": [
  {"event": {"id": "e1", "type": "claimed", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "planning", "spent": {"dollars": 0, "minutes": 1}, "remaining": {"dollars": 2, "minutes": 29}, "over_budget": false}},
  {"event": {"id": "e2", "type": "plan_written", "payload": {"dollars": 0.5, "minutes": 4}},
   "expect": {"outcome": "moved", "reason": null, "state": "plan_size", "spent": {"dollars": 0.5, "minutes": 5}, "remaining": {"dollars": 1.5, "minutes": 25}, "over_budget": false}},
  {"event": {"id": "e3", "type": "plan_small", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "coding", "spent": {"dollars": 0.5, "minutes": 6}, "remaining": {"dollars": 1.5, "minutes": 24}, "over_budget": false}},
  {"note": "Exactly on the budget, in dollars and in minutes: equal is within budget.",
   "event": {"id": "e4", "type": "code_written", "payload": {"dollars": 1.5, "minutes": 24}},
   "expect": {"outcome": "moved", "reason": null, "state": "checks", "visits": {"checks": 1}, "spent": {"dollars": 2, "minutes": 30}, "remaining": {"dollars": 0, "minutes": 0}, "over_budget": false}},
  {"note": "Rule 12: 35 minutes against 30, the dollars still equal to the budget. The cost is counted, draft_pr is not entered, and what remains never goes below 0.",
   "event": {"id": "e5", "type": "checks_passed", "payload": {"dollars": 0, "minutes": 5}},
   "expect": {"outcome": "stopped", "reason": "budget_exceeded", "state": "stopped", "visits": {"checks": 1, "draft_pr": 0}, "spent": {"dollars": 2, "minutes": 35}, "remaining": {"dollars": 0, "minutes": 0}, "over_budget": true}},
  {"event": {"id": "e6", "type": "pr_opened", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "refused", "reason": "run_ended", "state": "stopped", "spent": {"dollars": 2, "minutes": 35}, "remaining": {"dollars": 0, "minutes": 0}, "over_budget": true}}]}
