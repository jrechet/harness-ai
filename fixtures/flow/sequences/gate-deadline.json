{"about": "A deadline must say which state and which round it is about: without that it is ill formed, for another state it is stale, and for the gate the run is waiting in it stops the run.",
 "definition": "template:feature",
 "start": "new",
 "events": [
  {"event": {"id": "e1", "type": "claimed", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "planning", "spent": {"dollars": 0, "minutes": 1}}},
  {"note": "Rule 1: deadline_passed without 'at'.",
   "event": {"id": "e2", "type": "deadline_passed"},
   "expect": {"outcome": "refused", "reason": "malformed_event", "state": "planning", "visits": {"planning": 1}, "spent": {"dollars": 0, "minutes": 1}}},
  {"note": "Rule 7: a deadline belongs in every state, but this one names plan_review and the run is in planning.",
   "event": {"id": "e3", "type": "deadline_passed", "at": {"state": "plan_review", "visit": 1}},
   "expect": {"outcome": "refused", "reason": "stale_event", "state": "planning", "visits": {"planning": 1, "plan_review": 0}, "spent": {"dollars": 0, "minutes": 1}}},
  {"event": {"id": "e4", "type": "plan_written", "payload": {"dollars": 0.5, "minutes": 4}},
   "expect": {"outcome": "moved", "reason": null, "state": "plan_size", "spent": {"dollars": 0.5, "minutes": 5}}},
  {"event": {"id": "e5", "type": "plan_large", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "plan_review", "visits": {"plan_review": 1}, "spent": {"dollars": 0.5, "minutes": 6}}},
  {"note": "Rule 9: the approver stayed silent past the deadline of plan_review, visit 1. The gate does not declare deadline_passed, so the run stops.",
   "event": {"id": "e3", "type": "deadline_passed", "at": {"state": "plan_review", "visit": 1}},
   "expect": {"outcome": "stopped", "reason": "deadline_passed", "state": "stopped", "visits": {"plan_review": 1, "coding": 0}, "spent": {"dollars": 0.5, "minutes": 6}, "remaining": {"dollars": 19.5, "minutes": 234}, "over_budget": false}}]}
