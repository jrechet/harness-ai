{"about": "The reviewer of the plan rejects it: the run goes back to planning. Planning may be entered three times, so the third rejection stops the run instead of paying a fourth plan.",
 "definition": "template:feature",
 "start": "new",
 "events": [
  {"event": {"id": "e1", "type": "claimed", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "planning", "visits": {"planning": 1}, "spent": {"dollars": 0, "minutes": 1}}},
  {"event": {"id": "e2", "type": "plan_written", "payload": {"dollars": 0.5, "minutes": 4}},
   "expect": {"outcome": "moved", "reason": null, "state": "plan_size", "spent": {"dollars": 0.5, "minutes": 5}}},
  {"event": {"id": "e3", "type": "plan_large", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "plan_review", "spent": {"dollars": 0.5, "minutes": 6}}},
  {"note": "A gate's answer moves the run back to a step that costs: planning is entered a second time.",
   "event": {"id": "e4", "type": "plan_rejected", "at": {"state": "plan_review", "visit": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "planning", "visits": {"planning": 2, "plan_review": 1}, "spent": {"dollars": 0.5, "minutes": 6}}},
  {"event": {"id": "e5", "type": "plan_written", "payload": {"dollars": 0.5, "minutes": 4}},
   "expect": {"outcome": "moved", "reason": null, "state": "plan_size", "spent": {"dollars": 1, "minutes": 10}}},
  {"event": {"id": "e6", "type": "plan_large", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "plan_review", "spent": {"dollars": 1, "minutes": 11}}},
  {"event": {"id": "e7", "type": "plan_rejected", "at": {"state": "plan_review", "visit": 2}},
   "expect": {"outcome": "moved", "reason": null, "state": "planning", "visits": {"planning": 3, "plan_review": 2}, "spent": {"dollars": 1, "minutes": 11}}},
  {"event": {"id": "e8", "type": "plan_written", "payload": {"dollars": 0.5, "minutes": 4}},
   "expect": {"outcome": "moved", "reason": null, "state": "plan_size", "spent": {"dollars": 1.5, "minutes": 15}}},
  {"event": {"id": "e9", "type": "plan_large", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "plan_review", "spent": {"dollars": 1.5, "minutes": 16}}},
  {"note": "Rule 13: planning has a cap of 3 and was entered 3 times.",
   "event": {"id": "e10", "type": "plan_rejected", "at": {"state": "plan_review", "visit": 3}},
   "expect": {"outcome": "stopped", "reason": "cap_reached", "state": "stopped", "visits": {"planning": 3, "plan_review": 3}, "spent": {"dollars": 1.5, "minutes": 16}}}]}
