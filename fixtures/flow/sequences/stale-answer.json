{"about": "An approval given to the first version of the pull request arrives while the second is under review: it answers an earlier round and is refused; the approval of the current round moves.",
 "definition": "template:feature",
 "override": {"stop_at": "merged"},
 "start": "new",
 "events": [
  {"event": {"id": "e1", "type": "claimed", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "planning", "visits": {"ready": 1, "planning": 1}, "spent": {"dollars": 0, "minutes": 1}}},
  {"event": {"id": "e2", "type": "plan_written", "payload": {"dollars": 0.5, "minutes": 4}},
   "expect": {"outcome": "moved", "reason": null, "state": "plan_size", "spent": {"dollars": 0.5, "minutes": 5}}},
  {"event": {"id": "e3", "type": "plan_small", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "coding", "visits": {"coding": 1, "plan_review": 0}, "spent": {"dollars": 0.5, "minutes": 6}}},
  {"event": {"id": "e4", "type": "code_written", "payload": {"dollars": 2, "minutes": 20}},
   "expect": {"outcome": "moved", "reason": null, "state": "checks", "spent": {"dollars": 2.5, "minutes": 26}}},
  {"event": {"id": "e5", "type": "checks_passed", "payload": {"dollars": 0, "minutes": 5}},
   "expect": {"outcome": "moved", "reason": null, "state": "draft_pr", "spent": {"dollars": 2.5, "minutes": 31}}},
  {"event": {"id": "e6", "type": "pr_opened", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "ci_wait", "visits": {"ci_wait": 1}, "spent": {"dollars": 2.5, "minutes": 32}}},
  {"event": {"id": "e7", "type": "ci_finished", "at": {"state": "ci_wait", "visit": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "ci_check", "spent": {"dollars": 2.5, "minutes": 32}}},
  {"event": {"id": "e8", "type": "ci_green", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "review_checks", "spent": {"dollars": 2.5, "minutes": 33}}},
  {"event": {"id": "e9", "type": "review_done", "payload": {"dollars": 1, "minutes": 10}},
   "expect": {"outcome": "moved", "reason": null, "state": "mark_ready", "spent": {"dollars": 3.5, "minutes": 43}}},
  {"note": "With stop_at overridden to 'merged', reaching 'ready_pr' no longer ends the run.",
   "event": {"id": "e10", "type": "marked_ready", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "human_review", "visits": {"human_review": 1}, "spent": {"dollars": 3.5, "minutes": 44}}},
  {"event": {"id": "e11", "type": "changes_requested", "at": {"state": "human_review", "visit": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "rework", "visits": {"rework": 1}, "spent": {"dollars": 3.5, "minutes": 44}}},
  {"event": {"id": "e12", "type": "comments_collected", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "coding", "visits": {"coding": 2}, "spent": {"dollars": 3.5, "minutes": 45}}},
  {"event": {"id": "e13", "type": "code_written", "payload": {"dollars": 1, "minutes": 10}},
   "expect": {"outcome": "moved", "reason": null, "state": "checks", "visits": {"checks": 2}, "spent": {"dollars": 4.5, "minutes": 55}}},
  {"event": {"id": "e14", "type": "checks_passed", "payload": {"dollars": 0, "minutes": 5}},
   "expect": {"outcome": "moved", "reason": null, "state": "draft_pr", "visits": {"draft_pr": 2}, "spent": {"dollars": 4.5, "minutes": 60}}},
  {"event": {"id": "e15", "type": "pr_opened", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "ci_wait", "visits": {"ci_wait": 2}, "spent": {"dollars": 4.5, "minutes": 61}}},
  {"event": {"id": "e16", "type": "ci_finished", "at": {"state": "ci_wait", "visit": 2}},
   "expect": {"outcome": "moved", "reason": null, "state": "ci_check", "visits": {"ci_check": 2}, "spent": {"dollars": 4.5, "minutes": 61}}},
  {"event": {"id": "e17", "type": "ci_green", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "review_checks", "visits": {"review_checks": 2}, "spent": {"dollars": 4.5, "minutes": 62}}},
  {"event": {"id": "e18", "type": "review_done", "payload": {"dollars": 1, "minutes": 10}},
   "expect": {"outcome": "moved", "reason": null, "state": "mark_ready", "visits": {"mark_ready": 2}, "spent": {"dollars": 5.5, "minutes": 72}}},
  {"event": {"id": "e19", "type": "marked_ready", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "human_review", "visits": {"human_review": 2}, "spent": {"dollars": 5.5, "minutes": 73}}},
  {"note": "Rule 7: the type belongs here, but it answers visit 1 and the run is in visit 2.",
   "event": {"id": "e20", "type": "approved", "at": {"state": "human_review", "visit": 1}},
   "expect": {"outcome": "refused", "reason": "stale_event", "state": "human_review", "visits": {"human_review": 2, "merge_auth": 0}, "spent": {"dollars": 5.5, "minutes": 73}}},
  {"event": {"id": "e21", "type": "approved", "at": {"state": "human_review", "visit": 2}},
   "expect": {"outcome": "moved", "reason": null, "state": "merge_auth", "visits": {"human_review": 2, "merge_auth": 1}, "spent": {"dollars": 5.5, "minutes": 73}}}]}
