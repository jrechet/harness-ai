{"about": "On the bug flow taken past its default stop point: a CI result for an older commit sends the run back to wait, two CI fixes are paid, and a third red result stops the run instead of paying a third fix.",
 "definition": "template:bug",
 "override": {"stop_at": "merged"},
 "start": "new",
 "events": [
  {"event": {"id": "e1", "type": "ticket_ready", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "premise", "spent": {"dollars": 0, "minutes": 1}}},
  {"event": {"id": "e2", "type": "still_fails", "payload": {"dollars": 1, "minutes": 8}},
   "expect": {"outcome": "moved", "reason": null, "state": "root_cause", "visits": {"root_cause": 1}, "spent": {"dollars": 1, "minutes": 9}}},
  {"event": {"id": "e3", "type": "cause_written", "payload": {"dollars": 2, "minutes": 15}},
   "expect": {"outcome": "moved", "reason": null, "state": "notify", "spent": {"dollars": 3, "minutes": 24}}},
  {"note": "With stop_at overridden to 'merged', reaching 'root_cause' no longer ends the run.",
   "event": {"id": "e4", "type": "confident", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "repro", "visits": {"repro": 1}, "spent": {"dollars": 3, "minutes": 25}}},
  {"event": {"id": "e5", "type": "repro_written", "payload": {"dollars": 1, "minutes": 10}},
   "expect": {"outcome": "moved", "reason": null, "state": "fix", "spent": {"dollars": 4, "minutes": 35}}},
  {"event": {"id": "e6", "type": "fix_written", "payload": {"dollars": 1, "minutes": 10}},
   "expect": {"outcome": "moved", "reason": null, "state": "verify", "spent": {"dollars": 5, "minutes": 45}}},
  {"event": {"id": "e7", "type": "verified", "payload": {"dollars": 0, "minutes": 5}},
   "expect": {"outcome": "moved", "reason": null, "state": "draft_pr", "spent": {"dollars": 5, "minutes": 50}}},
  {"event": {"id": "e8", "type": "pr_opened", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "ci_wait", "visits": {"ci_wait": 1}, "spent": {"dollars": 5, "minutes": 51}}},
  {"event": {"id": "e9", "type": "ci_finished", "at": {"state": "ci_wait", "visit": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "ci_check", "visits": {"ci_check": 1}, "spent": {"dollars": 5, "minutes": 51}}},
  {"note": "The result was for a commit that is no longer the head: back to the wait, no fix paid.",
   "event": {"id": "e10", "type": "ci_stale", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "ci_wait", "visits": {"ci_wait": 2, "ci_fix": 0}, "spent": {"dollars": 5, "minutes": 52}}},
  {"event": {"id": "e11", "type": "ci_finished", "at": {"state": "ci_wait", "visit": 2}},
   "expect": {"outcome": "moved", "reason": null, "state": "ci_check", "visits": {"ci_check": 2}, "spent": {"dollars": 5, "minutes": 52}}},
  {"event": {"id": "e12", "type": "ci_red", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "ci_fix", "visits": {"ci_fix": 1}, "spent": {"dollars": 5, "minutes": 53}}},
  {"event": {"id": "e13", "type": "fix_pushed", "payload": {"dollars": 0.5, "minutes": 5}},
   "expect": {"outcome": "moved", "reason": null, "state": "ci_wait", "visits": {"ci_wait": 3}, "spent": {"dollars": 5.5, "minutes": 58}}},
  {"event": {"id": "e14", "type": "ci_finished", "at": {"state": "ci_wait", "visit": 3}},
   "expect": {"outcome": "moved", "reason": null, "state": "ci_check", "visits": {"ci_check": 3}, "spent": {"dollars": 5.5, "minutes": 58}}},
  {"event": {"id": "e15", "type": "ci_red", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "ci_fix", "visits": {"ci_fix": 2}, "spent": {"dollars": 5.5, "minutes": 59}}},
  {"note": "The fourth entry into ci_wait, whose cap is 4: allowed, the cap is the most, not one less.",
   "event": {"id": "e16", "type": "fix_pushed", "payload": {"dollars": 0.5, "minutes": 5}},
   "expect": {"outcome": "moved", "reason": null, "state": "ci_wait", "visits": {"ci_wait": 4}, "spent": {"dollars": 6, "minutes": 64}}},
  {"event": {"id": "e17", "type": "ci_finished", "at": {"state": "ci_wait", "visit": 4}},
   "expect": {"outcome": "moved", "reason": null, "state": "ci_check", "visits": {"ci_check": 4}, "spent": {"dollars": 6, "minutes": 64}}},
  {"note": "Rule 13: ci_fix has a cap of 2 and was entered twice.",
   "event": {"id": "e18", "type": "ci_red", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "stopped", "reason": "cap_reached", "state": "stopped", "visits": {"ci_fix": 2, "ci_wait": 4, "ci_check": 4}, "spent": {"dollars": 6, "minutes": 65}, "remaining": {"dollars": 4, "minutes": 55}, "over_budget": false}}]}
