{"about": "A run that comes back already in the human review, past the default stop point, goes on to the closed ticket: approval, merge authorisation, merge, deploy, closing. The stop point is a transition, so a run past it is not stopped again; the other stop points on the way (merged, deployed) are passed through.",
 "definition": "template:feature",
 "start": {"state": "human_review", "visits": {"ready": 1, "planning": 1, "plan_size": 1, "coding": 1, "checks": 1, "draft_pr": 1, "ci_wait": 1, "ci_check": 1, "review_checks": 1, "mark_ready": 1, "human_review": 1}, "spent": {"dollars": 6, "minutes": 70}, "seen": ["e1", "e2", "e3", "e4", "e5", "e6", "e7", "e8", "e9", "e10"], "reason": null},
 "events": [
  {"note": "A gate costs nothing: no payload is asked (rule 8 is for programs and agents).",
   "event": {"id": "a1", "type": "approved", "at": {"state": "human_review", "visit": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "merge_auth", "visits": {"merge_auth": 1}, "spent": {"dollars": 6, "minutes": 70}}},
  {"event": {"id": "a2", "type": "merge_authorised", "at": {"state": "merge_auth", "visit": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "merging", "visits": {"merging": 1}, "spent": {"dollars": 6, "minutes": 70}}},
  {"note": "Rule 11 does not apply: this transition reaches merged, and stop_at is ready_pr.",
   "event": {"id": "a3", "type": "merged", "payload": {"dollars": 0, "minutes": 2}},
   "expect": {"outcome": "moved", "reason": null, "state": "delivery", "visits": {"delivery": 1}, "spent": {"dollars": 6, "minutes": 72}}},
  {"event": {"id": "a4", "type": "deployed"},
   "expect": {"outcome": "moved", "reason": null, "state": "closing", "visits": {"closing": 1}, "spent": {"dollars": 6, "minutes": 72}}},
  {"note": "Rule 10: a transition to done ends with its own reason.",
   "event": {"id": "a5", "type": "closed", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "done", "reason": "delivered", "state": "done", "spent": {"dollars": 6, "minutes": 73}, "remaining": {"dollars": 14, "minutes": 167}, "over_budget": false, "seen": ["e1", "e2", "e3", "e4", "e5", "e6", "e7", "e8", "e9", "e10", "a1", "a2", "a3", "a4", "a5"]}},
  {"event": {"id": "a6", "type": "deployed"},
   "expect": {"outcome": "refused", "reason": "run_ended", "state": "done", "spent": {"dollars": 6, "minutes": 73}}}]}
