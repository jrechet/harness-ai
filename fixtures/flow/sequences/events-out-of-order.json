{"about": "Events that arrive where they do not belong are refused and change nothing, as often as they are sent; an event type nobody declares is told apart; the right event then moves, and a refused event sent again once it fits moves too.",
 "definition": "template:feature",
 "start": "new",
 "events": [
  {"event": {"id": "e1", "type": "claimed", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "planning", "spent": {"dollars": 0, "minutes": 1}}},
  {"note": "Rule 6: ci_green is declared by ci_check, not by planning.",
   "event": {"id": "e2", "type": "ci_green", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "refused", "reason": "event_not_expected", "state": "planning", "visits": {"planning": 1}, "spent": {"dollars": 0, "minutes": 1}}},
  {"note": "A refused event is not remembered: sent again, it is refused again, not called a duplicate.",
   "event": {"id": "e2", "type": "ci_green", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "refused", "reason": "event_not_expected", "state": "planning", "spent": {"dollars": 0, "minutes": 1}}},
  {"note": "Rule 6: no state declares this type and it is not built in.",
   "event": {"id": "e3", "type": "tests_exploded", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "refused", "reason": "unknown_event", "state": "planning", "spent": {"dollars": 0, "minutes": 1}}},
  {"event": {"id": "e3", "type": "tests_exploded", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "refused", "reason": "unknown_event", "state": "planning", "spent": {"dollars": 0, "minutes": 1}}},
  {"note": "The refused events cost nothing: only this cost is added.",
   "event": {"id": "e4", "type": "plan_written", "payload": {"dollars": 0.5, "minutes": 4}},
   "expect": {"outcome": "moved", "reason": null, "state": "plan_size", "spent": {"dollars": 0.5, "minutes": 5}}},
  {"event": {"id": "e5", "type": "plan_small", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "coding", "spent": {"dollars": 0.5, "minutes": 6}}},
  {"note": "checks_passed before code_written. The type does not belong here, and that is said before 'at' is read: event_not_expected, not stale_event.",
   "event": {"id": "e6", "type": "checks_passed", "at": {"state": "checks", "visit": 1}, "payload": {"dollars": 0, "minutes": 5}},
   "expect": {"outcome": "refused", "reason": "event_not_expected", "state": "coding", "visits": {"coding": 1, "checks": 0}, "spent": {"dollars": 0.5, "minutes": 6}}},
  {"event": {"id": "e6", "type": "checks_passed", "at": {"state": "checks", "visit": 1}, "payload": {"dollars": 0, "minutes": 5}},
   "expect": {"outcome": "refused", "reason": "event_not_expected", "state": "coding", "spent": {"dollars": 0.5, "minutes": 6}}},
  {"event": {"id": "e7", "type": "code_written", "payload": {"dollars": 2, "minutes": 20}},
   "expect": {"outcome": "moved", "reason": null, "state": "checks", "visits": {"checks": 1}, "spent": {"dollars": 2.5, "minutes": 26}}},
  {"note": "The event that came early, delivered again after the run moved: it now fits and moves.",
   "event": {"id": "e6", "type": "checks_passed", "at": {"state": "checks", "visit": 1}, "payload": {"dollars": 0, "minutes": 5}},
   "expect": {"outcome": "moved", "reason": null, "state": "draft_pr", "visits": {"draft_pr": 1}, "spent": {"dollars": 2.5, "minutes": 31}}}]}
