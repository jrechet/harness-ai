  {"event": {"id": "e6", "type": "code_written", "at": {"state": "coding", "visit": 2}, "payload": {"dollars": 1, "minutes": 10}},
   "expect": {"outcome": "moved", "reason": null, "state": "checks", "visits": {"coding": 2, "checks": 2}, "spent": {"dollars": 2.5, "minutes": 31}}},
  {"event": {"id": "e7", "type": "checks_failed", "at": {"state": "checks", "visit": 2}, "payload": {"dollars": 0, "minutes": 5}},
   "expect": {"outcome": "moved", "reason": null, "state": "coding", "visits": {"coding": 3, "checks": 2}, "spent": {"dollars": 2.5, "minutes": 36}}},
  {"event": {"id": "e8", "type": "code_written", "at": {"state": "coding", "visit": 3}, "payload": {"dollars": 1, "minutes": 10}},
   "expect": {"outcome": "moved", "reason": null, "state": "checks", "visits": {"coding": 3, "checks": 3}, "spent": {"dollars": 3.5, "minutes": 46}}},
  {"event": {"id": "e9", "type": "checks_failed", "at": {"state": "checks", "visit": 3}, "payload": {"dollars": 0, "minutes": 5}},
   "expect": {"outcome": "moved", "reason": null, "state": "coding", "visits": {"coding": 4, "checks": 3}, "spent": {"dollars": 3.5, "minutes": 51}}},
  {"event": {"id": "e10", "type": "code_written", "at": {"state": "coding", "visit": 4}, "payload": {"dollars": 1, "minutes": 10}},
   "expect": {"outcome": "moved", "reason": null, "state": "checks", "visits": {"coding": 4, "checks": 4}, "spent": {"dollars": 4.5, "minutes": 61}}},
  {"event": {"id": "e11", "type": "checks_failed", "at": {"state": "checks", "visit": 4}, "payload": {"dollars": 0, "minutes": 5}},
   "expect": {"outcome": "moved", "reason": null, "state": "coding", "visits": {"coding": 5, "checks": 4}, "spent": {"dollars": 4.5, "minutes": 66}}},
  {"event": {"id": "e12", "type": "code_written", "at": {"state": "coding", "visit": 5}, "payload": {"dollars": 1, "minutes": 10}},
   "expect": {"outcome": "moved", "reason": null, "state": "checks", "visits": {"coding": 5, "checks": 5}, "spent": {"dollars": 5.5, "minutes": 76}}},
  {"event": {"id": "e13", "type": "checks_failed", "at": {"state": "checks", "visit": 5}, "payload": {"dollars": 0, "minutes": 5}},
   "expect": {"outcome": "moved", "reason": null, "state": "coding", "visits": {"coding": 6, "checks": 5}, "spent": {"dollars": 5.5, "minutes": 81}}},
  {"event": {"id": "e14", "type": "code_written", "at": {"state": "coding", "visit": 6}, "payload": {"dollars": 1, "minutes": 10}},
   "expect": {"outcome": "moved", "reason": null, "state": "checks", "visits": {"coding": 6, "checks": 6}, "spent": {"dollars": 6.5, "minutes": 91}}},
  {"note": "Rule 13: coding has a cap of 6 and was entered six times. The cost of this last check is counted; coding is not entered.",
