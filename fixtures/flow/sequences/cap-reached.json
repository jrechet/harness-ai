   "expect": {"outcome": "stopped", "reason": "cap_reached", "state": "stopped", "visits": {"coding": 6, "checks": 6}, "spent": {"dollars": 6.5, "minutes": 96}, "remaining": {"dollars": 13.5, "minutes": 144}, "over_budget": false}},
  {"event": {"id": "e16", "type": "code_written", "at": {"state": "coding", "visit": 7}, "payload": {"dollars": 1, "minutes": 10}},
   "expect": {"outcome": "refused", "reason": "run_ended", "state": "stopped", "visits": {"coding": 6}, "spent": {"dollars": 6.5, "minutes": 96}}}]}
