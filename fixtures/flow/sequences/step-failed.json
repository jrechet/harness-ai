{"about": "A step that crashed must still say what it cost: step_failed without both costs is refused, with them it stops the run and the cost is counted.",
 "definition": "template:feature",
 "start": "new",
 "events": [
  {"event": {"id": "e1", "type": "claimed", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "planning", "visits": {"ready": 1, "planning": 1}, "spent": {"dollars": 0, "minutes": 1}}},
  {"event": {"id": "e2", "type": "plan_written", "payload": {"dollars": 0.5, "minutes": 4}},
   "expect": {"outcome": "moved", "reason": null, "state": "plan_size", "spent": {"dollars": 0.5, "minutes": 5}}},
  {"event": {"id": "e3", "type": "plan_small", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "coding", "visits": {"coding": 1, "plan_review": 0}, "spent": {"dollars": 0.5, "minutes": 6}}},
  {"note": "Rule 8: an event that ends an agent step carries dollars and minutes.",
   "event": {"id": "e4", "type": "step_failed", "at": {"state": "coding", "visit": 1}},
   "expect": {"outcome": "refused", "reason": "cost_missing", "state": "coding", "visits": {"coding": 1}, "spent": {"dollars": 0.5, "minutes": 6}}},
  {"note": "One of the two costs is not enough.",
   "event": {"id": "e4", "type": "step_failed", "at": {"state": "coding", "visit": 1}, "payload": {"dollars": 1.5}},
   "expect": {"outcome": "refused", "reason": "cost_missing", "state": "coding", "spent": {"dollars": 0.5, "minutes": 6}}},
  {"note": "Rule 9: coding does not declare step_failed. The same id as the two refused deliveries: a refused event stays out of 'seen'.",
   "event": {"id": "e4", "type": "step_failed", "at": {"state": "coding", "visit": 1}, "payload": {"dollars": 1.5, "minutes": 15}},
   "expect": {"outcome": "stopped", "reason": "step_failed", "state": "stopped", "visits": {"coding": 1, "checks": 0}, "spent": {"dollars": 2, "minutes": 21}, "remaining": {"dollars": 18, "minutes": 219}, "over_budget": false}},
  {"note": "The agent's late answer finds the run ended; its cost is not counted.",
   "event": {"id": "e5", "type": "code_written", "at": {"state": "coding", "visit": 1}, "payload": {"dollars": 2, "minutes": 20}},
   "expect": {"outcome": "refused", "reason": "run_ended", "state": "stopped", "spent": {"dollars": 2, "minutes": 21}}}]}
