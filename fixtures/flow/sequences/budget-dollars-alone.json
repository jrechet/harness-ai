{"about": "The twin of budget-exceeded, in dollars: landing exactly on the budget moves; one quarter more stops the run although almost all its minutes are left.",
 "definition": "template:feature",
 "override": {"budget": {"dollars": 2, "minutes": 240}},
 "start": "new",
 "events": [
  {"event": {"id": "e1", "type": "claimed", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "planning", "spent": {"dollars": 0, "minutes": 1}}},
  {"note": "Equal is within budget.",
   "event": {"id": "e2", "type": "plan_written", "payload": {"dollars": 2, "minutes": 4}},
   "expect": {"outcome": "moved", "reason": null, "state": "plan_size", "spent": {"dollars": 2, "minutes": 5}, "remaining": {"dollars": 0, "minutes": 235}, "over_budget": false}},
  {"note": "Rule 12, by dollars alone.",
   "event": {"id": "e3", "type": "plan_small", "payload": {"dollars": 0.25, "minutes": 1}},
   "expect": {"outcome": "stopped", "reason": "budget_exceeded", "state": "stopped", "visits": {"coding": 0}, "spent": {"dollars": 2.25, "minutes": 6}, "remaining": {"dollars": 0, "minutes": 234}, "over_budget": true}}]}
