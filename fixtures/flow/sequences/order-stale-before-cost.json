{"about": "A failure reported for another round is refused as stale before anyone asks what it cost: rule 7 comes before rule 8.",
 "definition": "template:feature",
 "start": "new",
 "events": [
  {"event": {"id": "e1", "type": "claimed", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "planning", "spent": {"dollars": 0, "minutes": 1}}},
  {"event": {"id": "e2", "type": "plan_written", "payload": {"dollars": 0.5, "minutes": 4}},
   "expect": {"outcome": "moved", "reason": null, "state": "plan_size", "spent": {"dollars": 0.5, "minutes": 5}}},
  {"event": {"id": "e3", "type": "plan_small", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "coding", "visits": {"coding": 1}, "spent": {"dollars": 0.5, "minutes": 6}}},
  {"note": "Rule 7 before rule 8: wrong round and no cost. The answer is stale_event.",
   "event": {"id": "e4", "type": "step_failed", "at": {"state": "coding", "visit": 2}},
   "expect": {"outcome": "refused", "reason": "stale_event", "state": "coding", "spent": {"dollars": 0.5, "minutes": 6}}},
  {"note": "Rule 8: the right round, still no cost.",
   "event": {"id": "e4", "type": "step_failed", "at": {"state": "coding", "visit": 1}},
   "expect": {"outcome": "refused", "reason": "cost_missing", "state": "coding", "spent": {"dollars": 0.5, "minutes": 6}}},
  {"note": "Rule 6 before rule 8: an event that does not belong here is told so, cost or not.",
   "event": {"id": "e5", "type": "checks_passed"},
   "expect": {"outcome": "refused", "reason": "event_not_expected", "state": "coding", "spent": {"dollars": 0.5, "minutes": 6}, "seen": ["e1", "e2", "e3"]}}]}
