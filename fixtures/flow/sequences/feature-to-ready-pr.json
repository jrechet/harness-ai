{"about": "The whole feature path, with a large plan approved by a person, until the pull request is marked ready: the flow ends there on purpose, and one more event finds the run ended.",
 "definition": "template:feature",
 "start": "new",
 "events": [
  {"event": {"id": "e1", "type": "claimed", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "planning", "visits": {"ready": 1, "planning": 1}, "spent": {"dollars": 0, "minutes": 1}, "remaining": {"dollars": 20, "minutes": 239}, "over_budget": false}},
  {"event": {"id": "e2", "type": "plan_written", "payload": {"dollars": 0.5, "minutes": 4}},
   "expect": {"outcome": "moved", "reason": null, "state": "plan_size", "spent": {"dollars": 0.5, "minutes": 5}}},
  {"note": "This transition reaches the stop point 'plan', which is not where this flow stops: the run goes on.",
   "event": {"id": "e3", "type": "plan_large", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "plan_review", "visits": {"plan_review": 1, "coding": 0}, "spent": {"dollars": 0.5, "minutes": 6}}},
  {"note": "A gate costs nothing: the event carries no cost and none is asked.",
   "event": {"id": "e4", "type": "plan_approved", "at": {"state": "plan_review", "visit": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "coding", "visits": {"coding": 1}, "spent": {"dollars": 0.5, "minutes": 6}}},
  {"event": {"id": "e5", "type": "code_written", "payload": {"dollars": 2.5, "minutes": 30}},
   "expect": {"outcome": "moved", "reason": null, "state": "checks", "spent": {"dollars": 3, "minutes": 36}}},
  {"event": {"id": "e6", "type": "checks_passed", "payload": {"dollars": 0, "minutes": 6}},
   "expect": {"outcome": "moved", "reason": null, "state": "draft_pr", "spent": {"dollars": 3, "minutes": 42}}},
  {"event": {"id": "e7", "type": "pr_opened", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "ci_wait", "visits": {"ci_wait": 1}, "spent": {"dollars": 3, "minutes": 43}}},
  {"event": {"id": "e8", "type": "ci_finished", "at": {"state": "ci_wait", "visit": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "ci_check", "spent": {"dollars": 3, "minutes": 43}}},
  {"event": {"id": "e9", "type": "ci_green", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "review_checks", "visits": {"ci_fix": 0}, "spent": {"dollars": 3, "minutes": 44}}},
  {"event": {"id": "e10", "type": "review_done", "payload": {"dollars": 1.5, "minutes": 12}},
   "expect": {"outcome": "moved", "reason": null, "state": "mark_ready", "spent": {"dollars": 4.5, "minutes": 56}}},
  {"note": "Rule 11: the transition reaches 'ready_pr', the flow's stop point. The run is done and human_review is not entered.",
   "event": {"id": "e11", "type": "marked_ready", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "done", "reason": "stop_point", "state": "done", "visits": {"mark_ready": 1, "human_review": 0}, "spent": {"dollars": 4.5, "minutes": 57}, "remaining": {"dollars": 15.5, "minutes": 183}, "over_budget": false}},
  {"note": "Rule 2: once ended, a run never moves.",
   "event": {"id": "e12", "type": "approved", "at": {"state": "human_review", "visit": 1}},
   "expect": {"outcome": "refused", "reason": "run_ended", "state": "done", "spent": {"dollars": 4.5, "minutes": 57}}}]}
