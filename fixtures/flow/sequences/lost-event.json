{"about": "An event that arrives before its state is refused and must be delivered again; a step whose job never answers is ended by its deadline, visibly.",
 "definition": "template:feature",
 "start": "new",
 "events": [
  {"event": {"id": "e1", "type": "claimed", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "planning", "visits": {"ready": 1, "planning": 1}, "spent": {"dollars": 0, "minutes": 1}}},
  {"event": {"id": "e2", "type": "plan_written", "payload": {"dollars": 0.5, "minutes": 4}},
   "expect": {"outcome": "moved", "reason": null, "state": "plan_size", "spent": {"dollars": 0.5, "minutes": 5}}},
  {"event": {"id": "e3", "type": "plan_small", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "coding", "visits": {"coding": 1, "plan_review": 0}, "spent": {"dollars": 0.5, "minutes": 6}}},
  {"event": {"id": "e4", "type": "code_written", "payload": {"dollars": 2, "minutes": 20}},
   "expect": {"outcome": "moved", "reason": null, "state": "checks", "spent": {"dollars": 2.5, "minutes": 26}}},
  {"event": {"id": "e5", "type": "checks_passed", "payload": {"dollars": 0, "minutes": 5}},
   "expect": {"outcome": "moved", "reason": null, "state": "draft_pr", "spent": {"dollars": 2.5, "minutes": 31}}},
  {"note": "CI answered before the run recorded that the pull request was opened. Refused, not lost: the caller keeps it.",
   "event": {"id": "e6", "type": "ci_finished", "at": {"state": "ci_wait", "visit": 1}},
   "expect": {"outcome": "refused", "reason": "event_not_expected", "state": "draft_pr", "visits": {"ci_wait": 0}, "spent": {"dollars": 2.5, "minutes": 31}}},
  {"event": {"id": "e7", "type": "pr_opened", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "ci_wait", "visits": {"ci_wait": 1}, "spent": {"dollars": 2.5, "minutes": 32}}},
  {"note": "The same event, delivered again after the run moved.",
   "event": {"id": "e6", "type": "ci_finished", "at": {"state": "ci_wait", "visit": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "ci_check", "visits": {"ci_check": 1}, "spent": {"dollars": 2.5, "minutes": 32}}},
  {"event": {"id": "e8", "type": "ci_red", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "ci_fix", "visits": {"ci_fix": 1}, "spent": {"dollars": 2.5, "minutes": 33}}},
  {"note": "Rule 9: ci_fix does not declare deadline_passed, so the run stops with that reason. A deadline carries no cost and none is asked, even in an agent step.",
   "event": {"id": "e9", "type": "deadline_passed", "at": {"state": "ci_fix", "visit": 1}},
   "expect": {"outcome": "stopped", "reason": "deadline_passed", "state": "stopped", "visits": {"ci_fix": 1, "ci_wait": 1}, "spent": {"dollars": 2.5, "minutes": 33}, "remaining": {"dollars": 17.5, "minutes": 207}, "over_budget": false}}]}
