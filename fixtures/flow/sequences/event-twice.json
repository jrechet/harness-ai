{"about": "An event delivered twice, right away and again three events later, changes nothing and costs nothing the second time; the same id with another type and another cost is still the same event.",
 "definition": "template:feature",
 "start": "new",
 "events": [
  {"event": {"id": "e1", "type": "claimed", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "planning", "visits": {"ready": 1, "planning": 1}, "spent": {"dollars": 0, "minutes": 1}}},
  {"note": "Rule 4: delivered again right away.",
   "event": {"id": "e1", "type": "claimed", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "duplicate", "reason": "already_seen", "state": "planning", "visits": {"ready": 1, "planning": 1}, "spent": {"dollars": 0, "minutes": 1}, "remaining": {"dollars": 20, "minutes": 239}, "over_budget": false}},
  {"event": {"id": "e2", "type": "plan_written", "payload": {"dollars": 0.5, "minutes": 4}},
   "expect": {"outcome": "moved", "reason": null, "state": "plan_size", "spent": {"dollars": 0.5, "minutes": 5}}},
  {"event": {"id": "e3", "type": "plan_small", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "moved", "reason": null, "state": "coding", "spent": {"dollars": 0.5, "minutes": 6}}},
  {"event": {"id": "e4", "type": "code_written", "payload": {"dollars": 2, "minutes": 20}},
   "expect": {"outcome": "moved", "reason": null, "state": "checks", "visits": {"coding": 1, "checks": 1}, "spent": {"dollars": 2.5, "minutes": 26}}},
  {"note": "Rule 4 again, three events later: the id is compared before the state is looked at, so this is a duplicate, not an event out of place.",
   "event": {"id": "e1", "type": "claimed", "payload": {"dollars": 0, "minutes": 1}},
   "expect": {"outcome": "duplicate", "reason": "already_seen", "state": "checks", "visits": {"planning": 1, "coding": 1, "checks": 1}, "spent": {"dollars": 2.5, "minutes": 26}}},
  {"note": "Only the id is compared: another type that would fit here, and another cost, are still a duplicate.",
   "event": {"id": "e1", "type": "checks_passed", "payload": {"dollars": 9, "minutes": 99}},
   "expect": {"outcome": "duplicate", "reason": "already_seen", "state": "checks", "visits": {"checks": 1, "draft_pr": 0}, "spent": {"dollars": 2.5, "minutes": 26}, "remaining": {"dollars": 17.5, "minutes": 214}, "over_budget": false}},
  {"note": "The real answer of the checks, under its own id, moves the run.",
   "event": {"id": "e5", "type": "checks_passed", "payload": {"dollars": 0, "minutes": 5}},
   "expect": {"outcome": "moved", "reason": null, "state": "draft_pr", "visits": {"draft_pr": 1}, "spent": {"dollars": 2.5, "minutes": 31}}}]}
