{"about": "An agent step that declares its deadline back to itself is started again when the deadline passes. Each such round says what it cost, so the budget sees the retries and ends them.",
 "definition": "definitions/retry-on-deadline.json",
 "start": "new",
 "events": [
  {"note": "Rule 8: a declared deadline that leads to a step is a retry, and a retry reports its costs.",
   "event": {"id": "d1", "type": "deadline_passed", "at": {"state": "fetch", "visit": 1}},
   "expect": {"outcome": "refused", "reason": "cost_missing", "state": "fetch", "visits": {"fetch": 1}, "spent": {"dollars": 0, "minutes": 0}}},
  {"note": "The same fact, delivered again with its costs: a refused event was not recorded, so it is taken.",
   "event": {"id": "d1", "type": "deadline_passed", "at": {"state": "fetch", "visit": 1}, "payload": {"dollars": 1, "minutes": 10}},
   "expect": {"outcome": "moved", "reason": null, "state": "fetch", "visits": {"fetch": 2}, "spent": {"dollars": 1, "minutes": 10}}},
  {"event": {"id": "d2", "type": "deadline_passed", "at": {"state": "fetch", "visit": 2}, "payload": {"dollars": 1, "minutes": 10}},
   "expect": {"outcome": "moved", "reason": null, "state": "fetch", "visits": {"fetch": 3}, "spent": {"dollars": 2, "minutes": 20}, "remaining": {"dollars": 1, "minutes": 10}}},
  {"note": "Rule 12 before rule 13: the third retry passes the budget; the cap would have stopped it too.",
   "event": {"id": "d3", "type": "deadline_passed", "at": {"state": "fetch", "visit": 3}, "payload": {"dollars": 1.25, "minutes": 5}},
   "expect": {"outcome": "stopped", "reason": "budget_exceeded", "state": "stopped", "visits": {"fetch": 3}, "spent": {"dollars": 3.25, "minutes": 25}, "remaining": {"dollars": 0, "minutes": 5}, "over_budget": true}}]}
