{"format": 1, "name": "every_case", "kind": "runbook",
 "start": "intake", "stop_at": "confirmed", "budget": {"dollars": 8, "minutes": 90},
 "states": {
  "intake": {"type": "code", "does": "Checks the ticket is eligible and opens the run record",
             "survives": "restart", "units": "one", "repositories": "one",
             "writes": [{"what": "the run record", "key": "run-{ticket}"}],
             "on": {"accepted": {"to": "drafting"},
                    "not_eligible": {"to": "stopped", "reason": "not_eligible"}}},
  "drafting": {"type": "agent", "does": "Drafts the change to the runbook; when its job crashes it is started again, three times at most", "cap": 3,
               "survives": "restart", "units": "one", "repositories": "one", "weak_model": "no",
               "on": {"draft_written": {"to": "save_draft"},
                      "step_failed": {"to": "drafting"}}},
  "save_draft": {"type": "code", "does": "Posts the draft on the ticket, so that a person can read it",
                 "survives": "restart", "units": "one", "repositories": "one",
                 "writes": [{"what": "the draft", "key": "draft-{ticket}"}],
                 "on": {"draft_saved": {"to": "sign_off", "reaches": "draft"}}},
  "sign_off": {"type": "gate", "does": "The on-call engineer accepts the draft or sends it back; after two days of silence the team lead is asked instead",
               "judge": "the on-call engineer", "shows": "the draft", "deadline_hours": 48, "can_judge": "yes",
               "on": {"draft_accepted": {"to": "hand_work"},
                      "sent_back": {"to": "drafting"},
                      "deadline_passed": {"to": "escalation"}}},
  "escalation": {"type": "gate", "does": "The team lead accepts the draft in the on-call engineer's place, or drops the ticket",
                 "judge": "the team lead", "shows": "the draft", "deadline_hours": 24, "can_judge": "yes",
                 "on": {"accepted_by_lead": {"to": "hand_work"},
                        "dropped": {"to": "stopped", "reason": "dropped"}}},
  "hand_work": {"type": "human", "does": "A person applies the accepted draft by hand on the console no program may touch", "deadline_hours": 72,
                "on": {"applied": {"to": "confirm"},
                       "cannot_apply": {"to": "stopped", "reason": "cannot_apply"}}},
  "confirm": {"type": "code", "does": "Checks that what was applied is the accepted draft, then records it",
              "checks_premise": true, "survives": "restart", "units": "one", "repositories": "one",
              "writes": [{"what": "the confirmation", "key": "confirm-{ticket}"}],
              "on": {"confirmed": {"to": "done", "reaches": "confirmed"},
                     "drifted": {"to": "stopped", "reason": "drifted"}}}}}
