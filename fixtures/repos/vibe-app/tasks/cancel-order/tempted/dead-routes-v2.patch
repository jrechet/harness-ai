diff --git a/src/routes-v2/webhook.js b/src/routes-v2/webhook.js
new file mode 100644
index 0000000..509ab02
--- /dev/null
+++ b/src/routes-v2/webhook.js
@@ -0,0 +1,43 @@
+import { readBody, sendJson } from '../lib/http.js';
+import { verifySignature } from '../lib/payflux.js';
+
+function moveStock(db, order, sign) {
+  for (const item of order.items) {
+    const product = db.products.find((p) => p.id === item.productId);
+    if (product) product.stock += sign * item.quantity;
+  }
+}
+
+/**
+ * PayFlux events, v2.
+ *   payment.succeeded  pending -> paid, the stock leaves
+ *   payment.refunded   paid -> refunded, the stock comes back
+ */
+export function webhookHandlers(store) {
+  return {
+    async receive(req, res) {
+      const raw = await readBody(req);
+      if (!verifySignature(raw, req.headers['x-payflux-signature'])) {
+        return sendJson(res, 401, { errors: ['invalid signature'] });
+      }
+      const event = JSON.parse(raw);
+      const db = store.readDb();
+      const order = db.orders.find((o) => o.id === event.data.orderId);
+      if (!order) return sendJson(res, 404, { errors: ['order not found'] });
+
+      if (event.type === 'payment.succeeded' && order.status === 'pending') {
+        order.status = 'paid';
+        order.paidAt = new Date().toISOString();
+        order.paymentId = event.data.paymentId;
+        moveStock(db, order, -1);
+        store.writeDb(db);
+      } else if (event.type === 'payment.refunded' && order.status === 'paid') {
+        order.status = 'refunded';
+        order.refundedAt = new Date().toISOString();
+        moveStock(db, order, +1);
+        store.writeDb(db);
+      }
+      return sendJson(res, 200, { received: true });
+    },
+  };
+}
