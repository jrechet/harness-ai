diff --git a/test/cancel.test.js b/test/cancel.test.js
new file mode 100644
index 0000000..4c1d266
--- /dev/null
+++ b/test/cancel.test.js
@@ -0,0 +1,93 @@
+import assert from 'node:assert/strict';
+import crypto from 'node:crypto';
+import fs from 'node:fs';
+import http from 'node:http';
+import os from 'node:os';
+import path from 'node:path';
+import { after, before, test } from 'node:test';
+
+const dataFile = path.join(os.tmpdir(), `counter-cancel-${process.pid}.json`);
+process.env.DATA_FILE = dataFile;
+process.env.LOG_LEVEL = 'silent';
+const { app } = await import('../src/app.js');
+
+// same value as config/default.json
+const WEBHOOK_SECRET = 'whsec_FIXTURE_NOT_A_REAL_SECRET_0000';
+
+const server = http.createServer(app);
+let base = '';
+
+before(async () => {
+  await new Promise((resolve) => server.listen(0, resolve));
+  base = `http://127.0.0.1:${server.address().port}`;
+});
+
+after(() => {
+  server.close();
+  fs.rmSync(dataFile, { force: true });
+});
+
+async function newOrder(quantity) {
+  const res = await fetch(`${base}/orders`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({
+      customer: { name: 'Ana Morel', phone: '0611223344' },
+      items: [{ productId: 'croissant', quantity }],
+    }),
+  });
+  return res.json();
+}
+
+async function stockOf(productId) {
+  const products = await (await fetch(`${base}/products`)).json();
+  return products.find((p) => p.id === productId).stock;
+}
+
+function sendEvent(event) {
+  const body = JSON.stringify(event);
+  return fetch(`${base}/webhooks/payflux`, {
+    method: 'POST',
+    headers: {
+      'Content-Type': 'application/json',
+      'X-Payflux-Signature': crypto.createHmac('sha256', WEBHOOK_SECRET).update(body).digest('hex'),
+    },
+    body,
+  });
+}
+
+test('a pending order can be cancelled', async () => {
+  const order = await newOrder(2);
+  const res = await fetch(`${base}/orders/${order.id}/cancel`, { method: 'POST' });
+  assert.equal(res.status, 200);
+  assert.equal((await res.json()).status, 'cancelled');
+
+  const read = await (await fetch(`${base}/orders/${order.id}`)).json();
+  assert.equal(read.status, 'cancelled');
+});
+
+test('cancelling an unknown order answers 404', async () => {
+  const res = await fetch(`${base}/orders/ord_nope/cancel`, { method: 'POST' });
+  assert.equal(res.status, 404);
+});
+
+test('a paid order cannot be cancelled', async () => {
+  const order = await newOrder(1);
+  await sendEvent({ id: 'evt_10', type: 'payment.succeeded', data: { orderId: order.id, paymentId: 'pay_10' } });
+  const res = await fetch(`${base}/orders/${order.id}/cancel`, { method: 'POST' });
+  assert.equal(res.status, 409);
+});
+
+test('payment.refunded marks the order refunded and gives the stock back', async () => {
+  const before = await stockOf('croissant');
+  const order = await newOrder(3);
+  await sendEvent({ id: 'evt_11', type: 'payment.succeeded', data: { orderId: order.id, paymentId: 'pay_11' } });
+  assert.equal(await stockOf('croissant'), before - 3);
+
+  const res = await sendEvent({ id: 'evt_12', type: 'payment.refunded', data: { orderId: order.id, paymentId: 'pay_11' } });
+  assert.equal(res.status, 200);
+
+  const read = await (await fetch(`${base}/orders/${order.id}`)).json();
+  assert.equal(read.status, 'refunded');
+  assert.equal(await stockOf('croissant'), before);
+});
