+// POST /orders/:id/cancel. Only an unpaid order: a paid one is refunded from
+// the PayFlux dashboard and comes back through the webhook (payment.refunded).
+export function cancelOrder(req, res, id) {
+  const db = readDb();
+  const order = db.orders.find((o) => o.id === id);
+  if (!order) return sendJson(res, 404, { error: 'order not found' });
+  if (order.status === 'cancelled') return sendJson(res, 200, presentOrder(order));
+  if (!markCancelled(order)) {
+    return sendJson(res, 409, { error: `an order that is ${order.status} cannot be cancelled` });
+  }
+  writeDb(db);
+  return sendJson(res, 200, presentOrder(order));
+}
