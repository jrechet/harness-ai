diff --git a/test/cancel.test.js b/test/cancel.test.js
new file mode 100644
index 0000000..f1b0778
--- /dev/null
+++ b/test/cancel.test.js
@@ -0,0 +1,121 @@
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import http from 'node:http';
+import os from 'node:os';
+import path from 'node:path';
+import { after, before, test } from 'node:test';
+
+const dataFile = path.join(os.tmpdir(), `counter-cancel-${process.pid}.json`);
+process.env.DATA_FILE = dataFile;
+process.env.LOG_LEVEL = 'silent';
+// a secret of our own: the one of config/default.json stays where it is
+process.env.PAYFLUX_WEBHOOK_SECRET = 'secret-of-the-cancel-tests';
+const { app } = await import('../src/app.js');
+const { sign } = await import('../src/lib/payflux.js');
+
+const server = http.createServer(app);
+let base = '';
+
+before(async () => {
+  await new Promise((resolve) => server.listen(0, resolve));
+  base = `http://127.0.0.1:${server.address().port}`;
+});
+
+after(() => {
+  server.close();
+  fs.rmSync(dataFile, { force: true });
+});
+
+async function newOrder(quantity) {
+  const res = await fetch(`${base}/orders`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({
+      customer: { name: 'Ana Morel', phone: '0611223344' },
+      items: [{ productId: 'croissant', quantity }],
+    }),
+  });
+  return res.json();
+}
+
+async function statusOf(orderId) {
+  return (await (await fetch(`${base}/orders/${orderId}`)).json()).status;
+}
+
+async function stock() {
+  const products = await (await fetch(`${base}/products`)).json();
+  return products.find((p) => p.id === 'croissant').stock;
+}
+
+function deliver(event) {
+  const body = JSON.stringify(event);
+  return fetch(`${base}/webhooks/payflux`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json', 'X-Payflux-Signature': sign(body) },
+    body,
+  });
+}
+
+const paid = (order, id) => ({ id, type: 'payment.succeeded', data: { orderId: order.id, paymentId: `pay_${id}` } });
+const refunded = (order, id) => ({ id, type: 'payment.refunded', data: { orderId: order.id, paymentId: `pay_${id}` } });
+
+test('a pending order is cancelled, and cancelling it again changes nothing', async () => {
+  const before = await stock();
+  const order = await newOrder(2);
+
+  const res = await fetch(`${base}/orders/${order.id}/cancel`, { method: 'POST' });
+  assert.equal(res.status, 200);
+  assert.equal((await res.json()).status, 'cancelled');
+
+  const again = await fetch(`${base}/orders/${order.id}/cancel`, { method: 'POST' });
+  assert.equal(again.status, 200);
+  assert.equal(await statusOf(order.id), 'cancelled');
+  assert.equal(await stock(), before);
+});
+
+test('an unknown order answers 404, a paid order 409', async () => {
+  assert.equal((await fetch(`${base}/orders/ord_nope/cancel`, { method: 'POST' })).status, 404);
+
+  const order = await newOrder(1);
+  await deliver(paid(order, 'evt_c1'));
+  const res = await fetch(`${base}/orders/${order.id}/cancel`, { method: 'POST' });
+  assert.equal(res.status, 409);
+  assert.equal(await statusOf(order.id), 'paid');
+});
+
+test('payment.refunded gives the stock back once, however many times it is delivered', async () => {
+  const before = await stock();
+  const order = await newOrder(3);
+  await deliver(paid(order, 'evt_c2'));
+  assert.equal(await stock(), before - 3);
+
+  for (let delivery = 1; delivery <= 3; delivery += 1) {
+    const res = await deliver(refunded(order, 'evt_c3'));
+    assert.equal(res.status, 200);
+  }
+  assert.equal(await statusOf(order.id), 'refunded');
+  assert.equal(await stock(), before);
+});
+
+test('a payment event that comes back after the refund does not pay the order again', async () => {
+  const before = await stock();
+  const order = await newOrder(2);
+  await deliver(paid(order, 'evt_c4'));
+  await deliver(refunded(order, 'evt_c5'));
+
+  const late = await deliver(paid(order, 'evt_c4'));
+  assert.equal(late.status, 200);
+  assert.equal(await statusOf(order.id), 'refunded');
+  assert.equal(await stock(), before);
+});
+
+test('a payment for a cancelled order leaves it cancelled and takes no stock', async () => {
+  const before = await stock();
+  const order = await newOrder(2);
+  await fetch(`${base}/orders/${order.id}/cancel`, { method: 'POST' });
+
+  const res = await deliver(paid(order, 'evt_c6'));
+  assert.equal(res.status, 200);
+  assert.equal(await statusOf(order.id), 'cancelled');
+  assert.equal(await stock(), before);
+});
