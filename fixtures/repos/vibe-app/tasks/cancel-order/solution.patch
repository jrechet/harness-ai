+function moveStock(db, order, sign) {
+  for (const item of order.items) {
+    const product = db.products.find((p) => p.id === item.productId);
+    if (product) product.stock += sign * item.quantity;
+  }
+}
+
+// Status changes. An order only leaves the status the change starts from:
+// applied a second time, a change returns false and touches nothing. PayFlux
+// delivers the same event several times, sometimes long after the first one.
+
+// pending -> paid: the stock leaves when the order is paid.
+export function markPaid(db, order, paymentId) {
+  if (order.status !== 'pending') return false;
+  order.status = 'paid';
+  order.paidAt = new Date().toISOString();
+  order.paymentId = paymentId;
+  moveStock(db, order, -1);
+  return true;
+}
+
+// paid -> refunded: the stock comes back.
+export function markRefunded(db, order) {
+  if (order.status !== 'paid') return false;
+  order.status = 'refunded';
+  order.refundedAt = new Date().toISOString();
+  moveStock(db, order, +1);
+  return true;
+}
+
+// pending -> cancelled: an unpaid order holds no stock, nothing to give back.
+export function markCancelled(order) {
+  if (order.status !== 'pending') return false;
+  order.status = 'cancelled';
+  order.cancelledAt = new Date().toISOString();
+  return true;
+}
