+// Cancels an order that is not paid yet. Changes `db` in place; the caller
+// saves it when `changed` is true. An unpaid order holds no stock (the stock
+// leaves at payment), so there is nothing to give back.
+// Returns { status, order, changed } or { status, error }.
+export function cancelOrder(db, id) {
+  const order = db.orders.find((o) => o.id === id);
+  if (!order) return { status: 404, error: 'order not found' };
+  // cancelling twice (double click, retry) is not an error
+  if (order.status === 'cancelled') return { status: 200, order, changed: false };
+  if (order.status !== 'pending') {
+    // paid or refunded: money has moved, the refund goes through PayFlux
+    return { status: 409, error: `order is ${order.status}, it cannot be cancelled` };
+  }
+  order.status = 'cancelled';
+  order.cancelledAt = new Date().toISOString();
+  return { status: 200, order, changed: true };
+}
