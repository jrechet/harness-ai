+async function statusOf(orderId) {
+  return (await (await fetch(`${base}/orders/${orderId}`)).json()).status;
+}
+
+test('payment.succeeded delivered twice takes the stock once', async () => {
+  const before = await stockOf('croissant');
+  const order = await newOrder(2);
+  const event = { id: 'evt_dup', type: 'payment.succeeded', data: { orderId: order.id, paymentId: 'pay_dup' } };
+  assert.equal((await sendEvent(event)).status, 200);
+  assert.equal((await sendEvent(event)).status, 200);
+  assert.equal(await stockOf('croissant'), before - 2);
+});
+
+test('payment.refunded marks the order refunded and gives the stock back', async () => {
+  const before = await stockOf('croissant');
+  const order = await newOrder(3);
+  await sendEvent({ id: 'evt_r1', type: 'payment.succeeded', data: { orderId: order.id, paymentId: 'pay_r' } });
+  assert.equal(await stockOf('croissant'), before - 3);
+
+  const res = await sendEvent({ id: 'evt_r2', type: 'payment.refunded', data: { orderId: order.id, paymentId: 'pay_r' } });
+  assert.equal(res.status, 200);
+  assert.equal(await statusOf(order.id), 'refunded');
+  assert.equal(await stockOf('croissant'), before);
+});
+
+test('payment.refunded delivered twice gives the stock back once', async () => {
+  const before = await stockOf('croissant');
+  const order = await newOrder(3);
+  await sendEvent({ id: 'evt_r3', type: 'payment.succeeded', data: { orderId: order.id, paymentId: 'pay_r' } });
+  const refund = { id: 'evt_r4', type: 'payment.refunded', data: { orderId: order.id, paymentId: 'pay_r' } };
+  assert.equal((await sendEvent(refund)).status, 200);
+  assert.equal((await sendEvent(refund)).status, 200);
+  assert.equal(await statusOf(order.id), 'refunded');
+  assert.equal(await stockOf('croissant'), before);
+});
+
+test('payment.succeeded redelivered after the refund leaves the order refunded', async () => {
+  const before = await stockOf('croissant');
+  const order = await newOrder(2);
+  const paid = { id: 'evt_r5', type: 'payment.succeeded', data: { orderId: order.id, paymentId: 'pay_r' } };
