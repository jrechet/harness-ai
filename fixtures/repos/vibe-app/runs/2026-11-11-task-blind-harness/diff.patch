diff --git a/test/cancel.test.js b/test/cancel.test.js
new file mode 100644
index 0000000..8209092
--- /dev/null
+++ b/test/cancel.test.js
@@ -0,0 +1,194 @@
+import assert from 'node:assert/strict';
+import crypto from 'node:crypto';
+import fs from 'node:fs';
+import http from 'node:http';
+import os from 'node:os';
+import path from 'node:path';
+import { after, before, test } from 'node:test';
+
+// each test file works on its own data file, never on data/db.json
+const dataFile = path.join(os.tmpdir(), `counter-cancel-${process.pid}.json`);
+process.env.DATA_FILE = dataFile;
+process.env.LOG_LEVEL = 'silent';
+// the test signs with its own secret: nothing is copied from config/default.json
+const WEBHOOK_SECRET = crypto.randomBytes(16).toString('hex');
+process.env.PAYFLUX_WEBHOOK_SECRET = WEBHOOK_SECRET;
+const { app } = await import('../src/app.js');
+
+const server = http.createServer(app);
+let base = '';
+
+before(async () => {
+  await new Promise((resolve) => server.listen(0, resolve));
+  base = `http://127.0.0.1:${server.address().port}`;
+});
+
+after(() => {
+  server.close();
+  fs.rmSync(dataFile, { force: true });
+});
+
+async function newOrder(quantity) {
+  const res = await fetch(`${base}/orders`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({
+      customer: { name: 'Ana Morel', phone: '0611223344' },
+      items: [
+        { productId: 'croissant', quantity },
+        { productId: 'baguette-tradition', quantity: 1 },
+      ],
+      pickupDate: '2026-05-16',
+    }),
+  });
+  assert.equal(res.status, 201);
+  return res.json();
+}
+
+async function readOrder(id) {
+  return (await fetch(`${base}/orders/${id}`)).json();
+}
+
+async function stocks() {
+  const products = await (await fetch(`${base}/products`)).json();
+  return Object.fromEntries(products.map((p) => [p.id, p.stock]));
+}
+
+function cancel(id) {
+  return fetch(`${base}/orders/${id}/cancel`, { method: 'POST' });
+}
+
+// signed over the raw body, the way PayFlux does it
+function sendEvent(id, type, orderId) {
+  const body = JSON.stringify({
+    id,
+    type,
+    created: 1773478800,
+    data: { orderId, paymentId: `pay_${orderId}`, amountCents: 1240 },
+  });
+  return fetch(`${base}/webhooks/payflux`, {
+    method: 'POST',
+    headers: {
+      'Content-Type': 'application/json',
+      'X-Payflux-Signature': crypto.createHmac('sha256', WEBHOOK_SECRET).update(body).digest('hex'),
+    },
+    body,
+  });
+}
+
+test('a pending order is cancelled, answered like GET /orders/:id, and the stock does not move', async () => {
+  const before = await stocks();
+  const order = await newOrder(2);
+
+  const res = await cancel(order.id);
+  assert.equal(res.status, 200);
+  const cancelled = await res.json();
+  assert.equal(cancelled.status, 'cancelled');
+  assert.deepEqual(cancelled, await readOrder(order.id));
+  assert.equal(cancelled.total, order.total);
+  assert.equal(cancelled.pickupLabel, order.pickupLabel);
+  assert.deepEqual(await stocks(), before);
+
+  const listed = await (await fetch(`${base}/orders?status=cancelled`)).json();
+  assert.ok(listed.some((o) => o.id === order.id));
+});
+
+test('cancelling twice answers 200 and changes nothing', async () => {
+  const order = await newOrder(1);
+  const first = await (await cancel(order.id)).json();
+  const again = await cancel(order.id);
+  assert.equal(again.status, 200);
+  assert.deepEqual(await again.json(), first);
+});
+
+test('cancelling an unknown order answers 404', async () => {
+  const res = await cancel('ord_nope');
+  assert.equal(res.status, 404);
+});
+
+test('a paid order answers 409 and stays paid', async () => {
+  const order = await newOrder(3);
+  assert.equal((await sendEvent('evt_c1', 'payment.succeeded', order.id)).status, 200);
+  const paid = await readOrder(order.id);
+  assert.equal(paid.status, 'paid');
+  const afterPayment = await stocks();
+
+  const res = await cancel(order.id);
+  assert.equal(res.status, 409);
+  assert.deepEqual(await readOrder(order.id), paid);
+  assert.deepEqual(await stocks(), afterPayment);
+});
+
+test('payment.refunded marks a paid order refunded and gives the stock back', async () => {
+  const before = await stocks();
+  const order = await newOrder(4);
+  await sendEvent('evt_r1', 'payment.succeeded', order.id);
+  const afterPayment = await stocks();
+  assert.equal(afterPayment.croissant, before.croissant - 4);
+  assert.equal(afterPayment['baguette-tradition'], before['baguette-tradition'] - 1);
+
+  const res = await sendEvent('evt_r2', 'payment.refunded', order.id);
+  assert.equal(res.status, 200);
+  assert.equal((await readOrder(order.id)).status, 'refunded');
+  assert.deepEqual(await stocks(), before);
+
+  // a refunded order is not cancellable either
+  assert.equal((await cancel(order.id)).status, 409);
+  assert.equal((await readOrder(order.id)).status, 'refunded');
+});
+
+test('payment.refunded delivered three times gives the stock back once', async () => {
+  const before = await stocks();
+  const order = await newOrder(2);
+  await sendEvent('evt_d1', 'payment.succeeded', order.id);
+  await sendEvent('evt_d2', 'payment.refunded', order.id);
+  const refunded = await readOrder(order.id);
+
+  for (let i = 0; i < 2; i += 1) {
+    const res = await sendEvent('evt_d2', 'payment.refunded', order.id);
+    assert.equal(res.status, 200);
+  }
+  assert.deepEqual(await stocks(), before);
+  assert.deepEqual(await readOrder(order.id), refunded);
+});
+
+test('payment.succeeded delivered again after the refund does not take the stock again', async () => {
+  const before = await stocks();
+  const order = await newOrder(2);
+  await sendEvent('evt_l1', 'payment.succeeded', order.id);
+  await sendEvent('evt_l2', 'payment.refunded', order.id);
+  const refunded = await readOrder(order.id);
+
+  const res = await sendEvent('evt_l1', 'payment.succeeded', order.id);
+  assert.equal(res.status, 200);
+  assert.deepEqual(await readOrder(order.id), refunded);
+  assert.deepEqual(await stocks(), before);
+});
+
+test('payment.refunded that arrives before payment.succeeded adds no stock, and the late payment takes none', async () => {
+  const before = await stocks();
+  const order = await newOrder(2);
+
+  assert.equal((await sendEvent('evt_o2', 'payment.refunded', order.id)).status, 200);
+  assert.equal((await readOrder(order.id)).status, 'refunded');
+  assert.deepEqual(await stocks(), before);
+
+  assert.equal((await sendEvent('evt_o1', 'payment.succeeded', order.id)).status, 200);
+  assert.equal((await readOrder(order.id)).status, 'refunded');
+  assert.deepEqual(await stocks(), before);
+});
+
+test('payment.refunded with a wrong signature changes nothing', async () => {
+  const order = await newOrder(1);
+  await sendEvent('evt_s1', 'payment.succeeded', order.id);
+  const afterPayment = await stocks();
+  const body = JSON.stringify({ id: 'evt_s2', type: 'payment.refunded', data: { orderId: order.id } });
+  const res = await fetch(`${base}/webhooks/payflux`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json', 'X-Payflux-Signature': 'deadbeef' },
+    body,
+  });
+  assert.equal(res.status, 401);
+  assert.equal((await readOrder(order.id)).status, 'paid');
+  assert.deepEqual(await stocks(), afterPayment);
+});
