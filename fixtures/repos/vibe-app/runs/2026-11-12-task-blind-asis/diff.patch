index ecb8de8..c81986f 100644
--- a/src/routes/webhook.js
+++ b/src/routes/webhook.js
@@ -3,6 +3,45 @@ import { log } from '../lib/logger.js';
 import { verifySignature } from '../lib/payflux.js';
 import { readDb, writeDb } from '../store.js';
 
+// PayFlux delivers "at least once": the same event can come back hours later.
+// Every handler below must be safe to replay and still answer 200.
+
+function moveStock(db, order, sign) {
+  for (const item of order.items) {
+    const product = db.products.find((p) => p.id === item.productId);
+    if (product) product.stock += sign * item.quantity;
+  }
+}
+
+function onPaymentSucceeded(db, order, event) {
+  // already paid, or refunded since: the stock has already been handled
+  if (order.status === 'paid' || order.status === 'refunded') return false;
+  order.status = 'paid';
+  order.paidAt = new Date().toISOString();
+  order.paymentId = event.data.paymentId;
+  // the stock leaves when the order is paid, not when it is created
+  moveStock(db, order, -1);
+  log('info', `order ${order.id} paid (${event.id})`);
+  return true;
+}
+
+function onPaymentRefunded(db, order, event) {
+  if (order.status === 'refunded') return false;
+  // only a paid order has taken stock; anything else has nothing to give back
+  const tookStock = order.status === 'paid';
+  if (tookStock) moveStock(db, order, 1);
+  else log('warn', `order ${order.id} refunded while ${order.status} (${event.id})`);
+  order.status = 'refunded';
+  order.refundedAt = new Date().toISOString();
+  log('info', `order ${order.id} refunded (${event.id})`);
+  return true;
+}
+
+const handlers = {
+  'payment.succeeded': onPaymentSucceeded,
+  'payment.refunded': onPaymentRefunded,
+};
+
