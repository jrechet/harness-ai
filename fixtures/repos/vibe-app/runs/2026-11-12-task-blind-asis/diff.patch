+async function newOrder() {
+  const res = await fetch(`${base}/orders`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ customer, items: [{ productId: 'croissant', quantity: 2 }] }),
+  });
+  return res.json();
+}
+
+test('an unpaid order can be cancelled, the stock does not move', async () => {
+  const stockOf = async () => (await (await fetch(`${base}/products`)).json())
+    .find((p) => p.id === 'croissant').stock;
+  const start = await stockOf();
+  const order = await newOrder();
+
