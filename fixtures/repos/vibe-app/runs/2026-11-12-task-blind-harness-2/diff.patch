diff --git a/test/cancel-refund.test.js b/test/cancel-refund.test.js
new file mode 100644
index 0000000..931c3ed
--- /dev/null
+++ b/test/cancel-refund.test.js
@@ -0,0 +1,175 @@
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import http from 'node:http';
+import os from 'node:os';
+import path from 'node:path';
+import { after, before, test } from 'node:test';
+
+// own data file and own webhook secret: nothing from data/db.json or config/default.json
+const dataFile = path.join(os.tmpdir(), `comptoir-cancel-refund-${process.pid}.json`);
+process.env.DATA_FILE = dataFile;
+process.env.LOG_LEVEL = 'silent';
+process.env.PAYFLUX_WEBHOOK_SECRET = `whsec_test_${process.pid}`;
+const { app } = await import('../src/app.js');
+const { sign } = await import('../src/lib/payflux.js');
+
+const server = http.createServer(app);
+let base = '';
+
+before(async () => {
+  await new Promise((resolve) => server.listen(0, resolve));
+  base = `http://127.0.0.1:${server.address().port}`;
+});
+
+after(() => {
+  server.close();
+  fs.rmSync(dataFile, { force: true });
+});
+
+async function newOrder(items) {
+  const res = await fetch(`${base}/orders`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ customer: { name: 'Ana Morel', phone: '0611223344' }, items }),
+  });
+  assert.equal(res.status, 201);
+  return res.json();
+}
+
+async function stock() {
+  const products = await (await fetch(`${base}/products`)).json();
+  return Object.fromEntries(products.map((p) => [p.id, p.stock]));
+}
+
+async function readOrder(id) {
+  return (await fetch(`${base}/orders/${id}`)).json();
+}
+
+function cancel(id) {
+  return fetch(`${base}/orders/${id}/cancel`, { method: 'POST' });
+}
+
+function sendEvent(event) {
+  const body = JSON.stringify({ created: 1773478800, ...event });
+  return fetch(`${base}/webhooks/payflux`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json', 'X-Payflux-Signature': sign(body) },
+    body,
+  });
+}
+
+const pay = (order, n) =>
+  sendEvent({ id: `evt_pay_${n}`, type: 'payment.succeeded', data: { orderId: order.id, paymentId: `pay_${n}`, amountCents: order.totalCents } });
+const refund = (order, n) =>
+  sendEvent({ id: `evt_ref_${n}`, type: 'payment.refunded', data: { orderId: order.id, paymentId: `pay_${n}`, amountCents: order.totalCents } });
+
+test('a pending order cancels: 200, same format as GET, stock untouched', async () => {
+  const before = await stock();
+  const order = await newOrder([{ productId: 'croissant', quantity: 2 }]);
+
+  const res = await cancel(order.id);
+  assert.equal(res.status, 200);
+  const body = await res.json();
+  assert.equal(body.status, 'cancelled');
+  assert.deepEqual(body, await readOrder(order.id));
+  assert.equal(body.total, order.total);
+  assert.deepEqual(await stock(), before);
+});
+
+test('cancelling twice answers 200 and changes nothing', async () => {
+  const order = await newOrder([{ productId: 'croissant', quantity: 1 }]);
+  const first = await (await cancel(order.id)).json();
+  const again = await cancel(order.id);
+  assert.equal(again.status, 200);
+  assert.deepEqual(await again.json(), first);
+});
+
+test('cancelling an unknown order answers 404', async () => {
+  const res = await cancel('ord_nope');
+  assert.equal(res.status, 404);
+});
+
+test('a paid order does not cancel: 409, still paid, stock still taken', async () => {
+  const order = await newOrder([{ productId: 'croissant', quantity: 3 }]);
+  assert.equal((await pay(order, 'c409')).status, 200);
+  const afterPay = await stock();
+
+  const res = await cancel(order.id);
+  assert.equal(res.status, 409);
+  assert.equal((await readOrder(order.id)).status, 'paid');
+  assert.deepEqual(await stock(), afterPay);
+});
+
+test('payment.refunded puts the paid quantities back, once, even when redelivered', async () => {
+  const before = await stock();
+  const order = await newOrder([
+    { productId: 'croissant', quantity: 3 },
+    { productId: 'baguette-tradition', quantity: 2 },
+  ]);
+  await pay(order, 'r1');
+  const paid = await stock();
+  assert.equal(paid.croissant, before.croissant - 3);
+  assert.equal(paid['baguette-tradition'], before['baguette-tradition'] - 2);
+
+  const res = await refund(order, 'r1');
+  assert.equal(res.status, 200);
+  const read = await readOrder(order.id);
+  assert.equal(read.status, 'refunded');
+  assert.deepEqual(await stock(), before);
+
+  // same event delivered again, then again later: still 200, stock unchanged
+  assert.equal((await refund(order, 'r1')).status, 200);
+  assert.equal((await refund(order, 'r1')).status, 200);
+  assert.deepEqual(await stock(), before);
+  assert.equal((await readOrder(order.id)).status, 'refunded');
+});
+
+test('a late redelivery of payment.succeeded does not bring a refunded order back', async () => {
+  const before = await stock();
+  const order = await newOrder([{ productId: 'croissant', quantity: 2 }]);
+  await pay(order, 'late');
+  await refund(order, 'late');
+
+  const res = await pay(order, 'late');
+  assert.equal(res.status, 200);
+  assert.equal((await readOrder(order.id)).status, 'refunded');
+  assert.deepEqual(await stock(), before);
+});
+
+test('a refunded order does not cancel', async () => {
+  const order = await newOrder([{ productId: 'croissant', quantity: 1 }]);
+  await pay(order, 'rc');
+  await refund(order, 'rc');
+  assert.equal((await cancel(order.id)).status, 409);
+  assert.equal((await readOrder(order.id)).status, 'refunded');
+});
+
+test('a cancelled order paid afterwards stays cancelled and takes no stock', async () => {
+  const before = await stock();
+  const order = await newOrder([{ productId: 'croissant', quantity: 2 }]);
+  await cancel(order.id);
+
+  assert.equal((await pay(order, 'pc')).status, 200);
+  const read = await readOrder(order.id);
+  assert.equal(read.status, 'cancelled');
+  assert.equal(read.paymentId, 'pay_pc');
+  assert.deepEqual(await stock(), before);
+
+  // refunded from the dashboard: it took nothing, so nothing comes back
+  assert.equal((await refund(order, 'pc')).status, 200);
+  assert.equal((await readOrder(order.id)).status, 'cancelled');
+  assert.deepEqual(await stock(), before);
+});
+
+test('a refund for a pending order changes nothing', async () => {
+  const before = await stock();
+  const order = await newOrder([{ productId: 'croissant', quantity: 1 }]);
+  assert.equal((await refund(order, 'pend')).status, 200);
+  assert.equal((await readOrder(order.id)).status, 'pending');
+  assert.deepEqual(await stock(), before);
+});
+
+test('a refund for an unknown order answers 404', async () => {
+  const res = await sendEvent({ id: 'evt_ref_x', type: 'payment.refunded', data: { orderId: 'ord_nope', paymentId: 'pay_x' } });
+  assert.equal(res.status, 404);
+});
