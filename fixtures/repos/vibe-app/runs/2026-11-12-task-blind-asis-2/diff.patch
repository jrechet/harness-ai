diff --git a/test/cancel-refund.test.js b/test/cancel-refund.test.js
new file mode 100644
index 0000000..9e780fe
--- /dev/null
+++ b/test/cancel-refund.test.js
@@ -0,0 +1,159 @@
+import assert from 'node:assert/strict';
+import crypto from 'node:crypto';
+import fs from 'node:fs';
+import http from 'node:http';
+import os from 'node:os';
+import path from 'node:path';
+import { after, before, test } from 'node:test';
+
+// own data file, never data/db.json
+const dataFile = path.join(os.tmpdir(), `comptoir-cancel-${process.pid}.json`);
+process.env.DATA_FILE = dataFile;
+process.env.LOG_LEVEL = 'silent';
+const { app } = await import('../src/app.js');
+
+// same value as config/default.json
+const WEBHOOK_SECRET = 'whsec_FIXTURE_NOT_A_REAL_SECRET_0000';
+
+const server = http.createServer(app);
+let base = '';
+
+before(async () => {
+  await new Promise((resolve) => server.listen(0, resolve));
+  base = `http://127.0.0.1:${server.address().port}`;
+});
+
+after(() => {
+  server.close();
+  fs.rmSync(dataFile, { force: true });
+});
+
+async function newOrder(quantity) {
+  const res = await fetch(`${base}/orders`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({
+      customer: { name: 'Ana Morel', phone: '0611223344' },
+      items: [{ productId: 'croissant', quantity }],
+    }),
+  });
+  return res.json();
+}
+
+async function stockOf(productId) {
+  const products = await (await fetch(`${base}/products`)).json();
+  return products.find((p) => p.id === productId).stock;
+}
+
+async function readOrder(id) {
+  return (await fetch(`${base}/orders/${id}`)).json();
+}
+
+function cancel(id) {
+  return fetch(`${base}/orders/${id}/cancel`, { method: 'POST' });
+}
+
+function sendEvent(event) {
+  const body = JSON.stringify(event);
+  return fetch(`${base}/webhooks/payflux`, {
+    method: 'POST',
+    headers: {
+      'Content-Type': 'application/json',
+      'X-Payflux-Signature': crypto.createHmac('sha256', WEBHOOK_SECRET).update(body).digest('hex'),
+    },
+    body,
+  });
+}
+
+function paid(orderId) {
+  return { id: `evt_paid_${orderId}`, type: 'payment.succeeded', data: { orderId, paymentId: 'pay_1' } };
+}
+
+function refunded(orderId) {
+  return { id: `evt_refund_${orderId}`, type: 'payment.refunded', data: { orderId, paymentId: 'pay_1' } };
+}
+
+test('a pending order is cancelled, answered like GET /orders/:id, stock untouched', async () => {
+  const stock = await stockOf('croissant');
+  const order = await newOrder(2);
+
+  const res = await cancel(order.id);
+  assert.equal(res.status, 200);
+  const body = await res.json();
+  assert.equal(body.status, 'cancelled');
+  assert.deepEqual(body, await readOrder(order.id));
+  assert.equal(await stockOf('croissant'), stock);
+});
+
+test('cancelling twice is harmless', async () => {
+  const order = await newOrder(1);
+  assert.equal((await cancel(order.id)).status, 200);
+  const res = await cancel(order.id);
+  assert.equal(res.status, 200);
+  assert.equal((await res.json()).status, 'cancelled');
+});
+
+test('an unknown order answers 404', async () => {
+  assert.equal((await cancel('ord_nope')).status, 404);
+});
+
+test('a paid order answers 409 and stays paid', async () => {
+  const order = await newOrder(1);
+  await sendEvent(paid(order.id));
+  const stock = await stockOf('croissant');
+
+  assert.equal((await cancel(order.id)).status, 409);
+  assert.equal((await readOrder(order.id)).status, 'paid');
+  assert.equal(await stockOf('croissant'), stock);
+});
+
+test('payment.refunded marks the order refunded and gives the stock back', async () => {
+  const stock = await stockOf('croissant');
+  const order = await newOrder(3);
+  await sendEvent(paid(order.id));
+  assert.equal(await stockOf('croissant'), stock - 3);
+
+  const res = await sendEvent(refunded(order.id));
+  assert.equal(res.status, 200);
+  assert.equal((await readOrder(order.id)).status, 'refunded');
+  assert.equal(await stockOf('croissant'), stock);
+});
+
+test('a refund delivered three times gives the stock back once', async () => {
+  const stock = await stockOf('croissant');
+  const order = await newOrder(3);
+  await sendEvent(paid(order.id));
+
+  for (let i = 0; i < 3; i += 1) {
+    assert.equal((await sendEvent(refunded(order.id))).status, 200);
+  }
+  assert.equal(await stockOf('croissant'), stock);
+});
+
+test('a payment redelivered after the refund does not take the stock again', async () => {
+  const stock = await stockOf('croissant');
+  const order = await newOrder(2);
+  await sendEvent(paid(order.id));
+  await sendEvent(refunded(order.id));
+
+  assert.equal((await sendEvent(paid(order.id))).status, 200);
+  assert.equal((await readOrder(order.id)).status, 'refunded');
+  assert.equal(await stockOf('croissant'), stock);
+});
+
+test('a refund for an order never paid changes nothing', async () => {
+  const stock = await stockOf('croissant');
+  const order = await newOrder(2);
+
+  assert.equal((await sendEvent(refunded(order.id))).status, 200);
+  assert.equal((await readOrder(order.id)).status, 'pending');
+  assert.equal(await stockOf('croissant'), stock);
+});
+
+test('a paid order cannot be cancelled once refunded either', async () => {
+  const order = await newOrder(1);
+  await sendEvent(paid(order.id));
+  await sendEvent(refunded(order.id));
+  assert.equal((await cancel(order.id)).status, 409);
+  assert.equal((await readOrder(order.id)).status, 'refunded');
+});
