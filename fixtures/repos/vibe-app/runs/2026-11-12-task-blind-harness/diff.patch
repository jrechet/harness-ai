diff --git a/test/cancel-refund.test.js b/test/cancel-refund.test.js
new file mode 100644
index 0000000..13b8c40
--- /dev/null
+++ b/test/cancel-refund.test.js
@@ -0,0 +1,154 @@
+import assert from 'node:assert/strict';
+import crypto from 'node:crypto';
+import fs from 'node:fs';
+import http from 'node:http';
+import os from 'node:os';
+import path from 'node:path';
+import { after, before, test } from 'node:test';
+
+// own data file and own webhook secret: never data/db.json nor config/default.json
+const dataFile = path.join(os.tmpdir(), `comptoir-cancel-refund-${process.pid}.json`);
+const secret = crypto.randomBytes(16).toString('hex');
+process.env.DATA_FILE = dataFile;
+process.env.PAYFLUX_WEBHOOK_SECRET = secret;
+process.env.LOG_LEVEL = 'silent';
+const { app } = await import('../src/app.js');
+
+const server = http.createServer(app);
+let base = '';
+
+before(async () => {
+  await new Promise((resolve) => server.listen(0, resolve));
+  base = `http://127.0.0.1:${server.address().port}`;
+});
+
+after(() => {
+  server.close();
+  fs.rmSync(dataFile, { force: true });
+});
+
+async function newOrder(items) {
+  const res = await fetch(`${base}/orders`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({ customer: { name: 'Ana Morel', phone: '0611223344' }, items }),
+  });
+  assert.equal(res.status, 201);
+  return res.json();
+}
+
+async function getOrder(id) {
+  return (await fetch(`${base}/orders/${id}`)).json();
+}
+
+async function stocks() {
+  const products = await (await fetch(`${base}/products`)).json();
+  return Object.fromEntries(products.map((p) => [p.id, p.stock]));
+}
+
+function cancel(id) {
+  return fetch(`${base}/orders/${id}/cancel`, { method: 'POST' });
+}
+
+let eventCount = 0;
+function sendEvent(type, orderId, id = `evt_${++eventCount}`) {
+  const body = JSON.stringify({
+    id,
+    type,
+    created: 1773478800,
+    data: { orderId, paymentId: `pay_${orderId}`, amountCents: 100 },
+  });
+  return fetch(`${base}/webhooks/payflux`, {
+    method: 'POST',
+    headers: {
+      'Content-Type': 'application/json',
+      'X-Payflux-Signature': crypto.createHmac('sha256', secret).update(body).digest('hex'),
+    },
+    body,
+  });
+}
+
+test('a pending order is cancelled, answered like GET /orders/:id, and the stock does not move', async () => {
+  const order = await newOrder([{ productId: 'croissant', quantity: 2 }]);
+  const before = await stocks();
+
+  const res = await cancel(order.id);
+  assert.equal(res.status, 200);
+  const body = await res.json();
+  assert.equal(body.status, 'cancelled');
+  assert.deepEqual(body, await getOrder(order.id));
+  assert.equal(body.total, order.total);
+  assert.deepEqual(await stocks(), before);
+
+  // cancelling again changes nothing
+  const again = await cancel(order.id);
+  assert.equal(again.status, 200);
+  assert.deepEqual(await again.json(), body);
+  assert.deepEqual(await stocks(), before);
+});
+
+test('cancelling an unknown order answers 404', async () => {
+  const res = await cancel('ord_nope');
+  assert.equal(res.status, 404);
+});
+
+test('a paid order cannot be cancelled: 409, it stays paid and keeps its stock', async () => {
+  const order = await newOrder([{ productId: 'croissant', quantity: 1 }]);
+  assert.equal((await sendEvent('payment.succeeded', order.id)).status, 200);
+  const before = await stocks();
+
+  const res = await cancel(order.id);
+  assert.equal(res.status, 409);
+  assert.equal((await getOrder(order.id)).status, 'paid');
+  assert.deepEqual(await stocks(), before);
+});
+
+test('payment.refunded marks a paid order refunded and gives its quantities back', async () => {
+  const initial = await stocks();
+  const order = await newOrder([
+    { productId: 'croissant', quantity: 3 },
+    { productId: 'baguette-tradition', quantity: 2 },
+  ]);
+  await sendEvent('payment.succeeded', order.id);
+  const paid = await stocks();
+  assert.equal(paid.croissant, initial.croissant - 3);
+  assert.equal(paid['baguette-tradition'], initial['baguette-tradition'] - 2);
+
+  const res = await sendEvent('payment.refunded', order.id, 'evt_refund_1');
+  assert.equal(res.status, 200);
+  const read = await getOrder(order.id);
+  assert.equal(read.status, 'refunded');
+  assert.deepEqual(await stocks(), initial);
+
+  // the same refund delivered again gives nothing back a second time
+  assert.equal((await sendEvent('payment.refunded', order.id, 'evt_refund_1')).status, 200);
+  assert.deepEqual(await stocks(), initial);
+  assert.deepEqual(await getOrder(order.id), read);
+
+  // and a late redelivery of the payment neither pays it again nor takes the stock
+  assert.equal((await sendEvent('payment.succeeded', order.id)).status, 200);
+  assert.equal((await getOrder(order.id)).status, 'refunded');
+  assert.deepEqual(await stocks(), initial);
+});
+
+test('payment.refunded for an order that was never paid gives nothing back', async () => {
+  const order = await newOrder([{ productId: 'croissant', quantity: 2 }]);
+  const before = await stocks();
+  assert.equal((await sendEvent('payment.refunded', order.id)).status, 200);
+  assert.equal((await getOrder(order.id)).status, 'pending');
+  assert.deepEqual(await stocks(), before);
+});
+
+test('payment.refunded for an unknown order answers 404', async () => {
+  const res = await sendEvent('payment.refunded', 'ord_nope');
+  assert.equal(res.status, 404);
+});
+
+test('a payment arriving after a cancellation does not take the stock', async () => {
+  const order = await newOrder([{ productId: 'croissant', quantity: 1 }]);
+  await cancel(order.id);
+  const before = await stocks();
+  assert.equal((await sendEvent('payment.succeeded', order.id)).status, 200);
+  assert.equal((await getOrder(order.id)).status, 'cancelled');
+  assert.deepEqual(await stocks(), before);
+});
