+// POST /orders/:id/cancel
+// Only an order not paid yet can be cancelled. It has taken no stock (the stock
+// leaves on payment.succeeded), so there is nothing to give back. A paid order is
+// refunded from the PayFlux dashboard instead: see payment.refunded in webhook.js.
+export function cancelOrder(req, res, id) {
+  const db = readDb();
+  const order = db.orders.find((o) => o.id === id);
+  if (!order) return sendJson(res, 404, { error: 'order not found' });
+  // cancelling twice (double tap, retry) changes nothing
+  if (order.status === 'cancelled') return sendJson(res, 200, presentOrder(order));
+  if (order.status !== 'pending') {
+    return sendJson(res, 409, { error: `order is ${order.status}, it cannot be cancelled` });
+  }
+  order.status = 'cancelled';
+  order.cancelledAt = new Date().toISOString();
+  writeDb(db);
+  return sendJson(res, 200, presentOrder(order));
+}
+
