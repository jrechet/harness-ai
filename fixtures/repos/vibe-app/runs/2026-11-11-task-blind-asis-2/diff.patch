diff --git a/src/routes/webhook.js b/src/routes/webhook.js
index ecb8de8..726ed7e 100644
--- a/src/routes/webhook.js
+++ b/src/routes/webhook.js
@@ -3,6 +3,55 @@ import { log } from '../lib/logger.js';
 import { verifySignature } from '../lib/payflux.js';
 import { readDb, writeDb } from '../store.js';
 
+// PayFlux delivers "at least once": the same event can come back up to 24 h
+// later, in any order with other events. Every handler below must be safe to
+// replay and still answer 200 (see NOTES.md, incident of 2026-03-14).
+
+function moveStock(db, order, sign) {
+  for (const item of order.items) {
+    const product = db.products.find((p) => p.id === item.productId);
+    if (product) product.stock += sign * item.quantity;
+  }
+}
+
+function onSucceeded(db, order, event) {
+  // only a pending order becomes paid: a replay on a paid or refunded order
+  // must not take the stock again
+  if (order.status !== 'pending') {
+    if (order.status === 'cancelled') {
+      log('warn', `order ${order.id} was cancelled but has been paid (${event.id}): refund it from PayFlux`);
+    }
+    return false;
+  }
+  order.status = 'paid';
+  order.paidAt = new Date().toISOString();
+  order.paymentId = event.data.paymentId;
+  // the stock leaves when the order is paid, not when it is created
+  moveStock(db, order, -1);
+  log('info', `order ${order.id} paid (${event.id})`);
+  return true;
+}
+
+function onRefunded(db, order, event) {
+  // only a paid order gives its stock back, once
+  if (order.status !== 'paid') {
+    if (order.status !== 'refunded') {
+      log('warn', `refund for order ${order.id} which is ${order.status} (${event.id}): ignored`);
+    }
+    return false;
+  }
+  order.status = 'refunded';
+  order.refundedAt = new Date().toISOString();
+  moveStock(db, order, 1);
+  log('info', `order ${order.id} refunded (${event.id})`);
+  return true;
+}
+
+const handlers = {
+  'payment.succeeded': onSucceeded,
+  'payment.refunded': onRefunded,
+};
+
