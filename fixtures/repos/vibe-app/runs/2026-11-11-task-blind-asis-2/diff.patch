+async function readOrder(id) {
+  return (await fetch(`${base}/orders/${id}`)).json();
+}
+
+function cancel(id) {
+  return fetch(`${base}/orders/${id}/cancel`, { method: 'POST' });
+}
+
+test('a pending order is cancelled, the stock does not move', async () => {
+  const before = await stockOf('croissant');
+  const order = await newOrder(2);
+  const res = await cancel(order.id);
+  assert.equal(res.status, 200);
+  const body = await res.json();
+  assert.equal(body.status, 'cancelled');
+  assert.equal(body.total, order.total);
+  assert.equal((await readOrder(order.id)).status, 'cancelled');
+  assert.equal(await stockOf('croissant'), before);
+});
+
+test('cancelling an unknown order answers 404', async () => {
+  assert.equal((await cancel('ord_nope')).status, 404);
+});
+
+test('a paid order cannot be cancelled and stays paid', async () => {
+  const order = await newOrder(1);
+  await sendEvent({ id: 'evt_c1', type: 'payment.succeeded', data: { orderId: order.id, paymentId: 'pay_c1' } });
+  const stock = await stockOf('croissant');
+  assert.equal((await cancel(order.id)).status, 409);
+  assert.equal((await readOrder(order.id)).status, 'paid');
+  assert.equal(await stockOf('croissant'), stock);
+});
+
+test('payment.refunded gives the stock back once, even when delivered again', async () => {
+  const before = await stockOf('croissant');
+  const order = await newOrder(3);
+  const paid = { id: 'evt_r1', type: 'payment.succeeded', data: { orderId: order.id, paymentId: 'pay_r1' } };
+  const refunded = { id: 'evt_r2', type: 'payment.refunded', data: { orderId: order.id, paymentId: 'pay_r1' } };
+  await sendEvent(paid);
+  assert.equal(await stockOf('croissant'), before - 3);
+
+  for (let i = 0; i < 3; i++) {
+    assert.equal((await sendEvent(refunded)).status, 200);
+  }
+  assert.equal((await readOrder(order.id)).status, 'refunded');
+  assert.equal(await stockOf('croissant'), before);
+
+  // PayFlux may deliver the old payment.succeeded again after the refund
+  assert.equal((await sendEvent(paid)).status, 200);
+  assert.equal((await readOrder(order.id)).status, 'refunded');
+  assert.equal(await stockOf('croissant'), before);
+});
+
+test('payment.refunded on an unpaid order changes nothing', async () => {
+  const before = await stockOf('croissant');
