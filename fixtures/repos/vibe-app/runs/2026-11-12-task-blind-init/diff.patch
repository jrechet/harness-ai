diff --git a/test/webhook.test.js b/test/webhook.test.js
index 97a9e16..ee81b16 100644
--- a/test/webhook.test.js
+++ b/test/webhook.test.js
@@ -85,3 +85,108 @@ test('an event for an unknown order answers 404', async () => {
   const res = await sendEvent({ id: 'evt_2', type: 'payment.succeeded', data: { orderId: 'ord_nope', paymentId: 'pay_3' } });
   assert.equal(res.status, 404);
 });
+
+async function readOrder(id) {
+  return (await fetch(`${base}/orders/${id}`)).json();
+}
+
+function cancel(id) {
+  return fetch(`${base}/orders/${id}/cancel`, { method: 'POST' });
+}
+
+test('payment.succeeded delivered three times takes the stock once (real handler)', async () => {
+  const before = await stockOf('croissant');
+  const order = await newOrder(2);
+  const event = { id: 'evt_dup', type: 'payment.succeeded', data: { orderId: order.id, paymentId: 'pay_dup' } };
+  for (let i = 0; i < 3; i += 1) assert.equal((await sendEvent(event)).status, 200);
+  assert.equal((await readOrder(order.id)).status, 'paid');
+  assert.equal(await stockOf('croissant'), before - 2);
+});
+
+test('a pending order is cancelled, same format as GET, stock untouched', async () => {
+  const before = await stockOf('croissant');
+  const order = await newOrder(3);
+  const res = await cancel(order.id);
+  assert.equal(res.status, 200);
+  const body = await res.json();
+  assert.equal(body.status, 'cancelled');
+  assert.deepEqual(body, await readOrder(order.id));
+  assert.equal(await stockOf('croissant'), before);
+
+  // cancelling again changes nothing
+  const again = await cancel(order.id);
+  assert.equal(again.status, 200);
+  assert.equal((await again.json()).status, 'cancelled');
+});
+
+test('cancelling an unknown order answers 404', async () => {
+  assert.equal((await cancel('ord_nope')).status, 404);
+});
+
+test('a paid order cannot be cancelled: 409, stays paid, stock unchanged', async () => {
+  const order = await newOrder(1);
+  await sendEvent({ id: 'evt_c1', type: 'payment.succeeded', data: { orderId: order.id, paymentId: 'pay_c1' } });
+  const stock = await stockOf('croissant');
+  assert.equal((await cancel(order.id)).status, 409);
+  assert.equal((await readOrder(order.id)).status, 'paid');
+  assert.equal(await stockOf('croissant'), stock);
+});
+
+test('a payment arriving after a cancel does not take the stock nor mark it paid', async () => {
+  const before = await stockOf('croissant');
+  const order = await newOrder(2);
+  await cancel(order.id);
+  const event = { id: 'evt_late', type: 'payment.succeeded', data: { orderId: order.id, paymentId: 'pay_late' } };
+  assert.equal((await sendEvent(event)).status, 200);
+  assert.equal((await sendEvent(event)).status, 200);
+  assert.equal((await readOrder(order.id)).status, 'cancelled');
+  assert.equal(await stockOf('croissant'), before);
+});
+
+test('payment.refunded marks the order refunded and gives the stock back, once', async () => {
+  const before = await stockOf('croissant');
+  const order = await newOrder(5);
+  const paid = { id: 'evt_p5', type: 'payment.succeeded', data: { orderId: order.id, paymentId: 'pay_5' } };
+  await sendEvent(paid);
+  assert.equal(await stockOf('croissant'), before - 5);
+
+  const refund = { id: 'evt_r5', type: 'payment.refunded', data: { orderId: order.id, paymentId: 'pay_5' } };
+  for (let i = 0; i < 3; i += 1) assert.equal((await sendEvent(refund)).status, 200);
+  assert.equal((await readOrder(order.id)).status, 'refunded');
+  assert.equal(await stockOf('croissant'), before);
+
+  // the old payment.succeeded redelivered after the refund changes nothing
+  assert.equal((await sendEvent(paid)).status, 200);
+  assert.equal((await readOrder(order.id)).status, 'refunded');
+  assert.equal(await stockOf('croissant'), before);
+
+  // a refunded order cannot be cancelled
+  assert.equal((await cancel(order.id)).status, 409);
+});
+
+test('payment.refunded on a pending or cancelled order changes nothing', async () => {
+  const before = await stockOf('croissant');
+  const pending = await newOrder(1);
+  const cancelled = await newOrder(1);
+  await cancel(cancelled.id);
+  for (const o of [pending, cancelled]) {
+    const res = await sendEvent({ id: `evt_r_${o.id}`, type: 'payment.refunded', data: { orderId: o.id } });
+    assert.equal(res.status, 200);
+  }
+  assert.equal((await readOrder(pending.id)).status, 'pending');
+  assert.equal((await readOrder(cancelled.id)).status, 'cancelled');
+  assert.equal(await stockOf('croissant'), before);
+});
+
+test('payment.refunded with a wrong signature is refused', async () => {
+  const order = await newOrder(1);
+  await sendEvent({ id: 'evt_s1', type: 'payment.succeeded', data: { orderId: order.id, paymentId: 'pay_s1' } });
+  const res = await sendEvent({ id: 'evt_s2', type: 'payment.refunded', data: { orderId: order.id } }, 'deadbeef');
+  assert.equal(res.status, 401);
+  assert.equal((await readOrder(order.id)).status, 'paid');
+});
+
+test('payment.refunded for an unknown order answers 404', async () => {
+  const res = await sendEvent({ id: 'evt_r404', type: 'payment.refunded', data: { orderId: 'ord_nope' } });
+  assert.equal(res.status, 404);
+});
