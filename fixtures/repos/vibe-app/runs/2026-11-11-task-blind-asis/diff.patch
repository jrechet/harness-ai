index 0000000..eeb67f4
--- /dev/null
+++ b/test/cancel.test.js
@@ -0,0 +1,122 @@
+import assert from 'node:assert/strict';
+import crypto from 'node:crypto';
+import fs from 'node:fs';
+import http from 'node:http';
+import os from 'node:os';
+import path from 'node:path';
+import { after, before, test } from 'node:test';
+
+// each test file works on its own data file, never on data/db.json
+const dataFile = path.join(os.tmpdir(), `counter-cancel-${process.pid}.json`);
+process.env.DATA_FILE = dataFile;
+process.env.LOG_LEVEL = 'silent';
+const { app } = await import('../src/app.js');
+
+// same value as config/default.json
+const WEBHOOK_SECRET = 'whsec_FIXTURE_NOT_A_REAL_SECRET_0000';
+
+const server = http.createServer(app);
+let base = '';
+
+before(async () => {
+  await new Promise((resolve) => server.listen(0, resolve));
+  base = `http://127.0.0.1:${server.address().port}`;
+});
+
+after(() => {
+  server.close();
+  fs.rmSync(dataFile, { force: true });
+});
+
+async function newOrder(quantity) {
+  const res = await fetch(`${base}/orders`, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json' },
+    body: JSON.stringify({
+      customer: { name: 'Ana Morel', phone: '0611223344' },
+      items: [{ productId: 'croissant', quantity }],
+      pickupDate: '2026-05-16',
+    }),
+  });
+  return res.json();
+}
+
+async function readOrder(id) {
+  return (await fetch(`${base}/orders/${id}`)).json();
+}
+
+async function stockOf(productId) {
+  const products = await (await fetch(`${base}/products`)).json();
+  return products.find((p) => p.id === productId).stock;
+}
+
+function cancel(id) {
+  return fetch(`${base}/orders/${id}/cancel`, { method: 'POST' });
+}
+
+function sendEvent(type, order) {
+  const body = JSON.stringify({ id: `evt_${type}_${order.id}`, type, data: { orderId: order.id, paymentId: 'pay_1' } });
+  return fetch(`${base}/webhooks/payflux`, {
+    method: 'POST',
+    headers: {
+      'Content-Type': 'application/json',
+      'X-Payflux-Signature': crypto.createHmac('sha256', WEBHOOK_SECRET).update(body).digest('hex'),
+    },
+    body,
+  });
+}
+
+test('a pending order is cancelled, answered like GET /orders/{id}, stock untouched', async () => {
+  const stock = await stockOf('croissant');
+  const order = await newOrder(2);
+
+  const res = await cancel(order.id);
+  assert.equal(res.status, 200);
+  const cancelled = await res.json();
+  assert.equal(cancelled.status, 'cancelled');
+  assert.deepEqual(cancelled, await readOrder(order.id));
+  assert.equal(cancelled.total, order.total);
+  assert.equal(cancelled.pickupLabel, order.pickupLabel);
+  assert.equal(await stockOf('croissant'), stock);
+});
+
+test('cancelling twice answers 200 and changes nothing', async () => {
+  const order = await newOrder(1);
+  const first = await (await cancel(order.id)).json();
+  const res = await cancel(order.id);
+  assert.equal(res.status, 200);
+  assert.deepEqual(await res.json(), first);
+});
+
+test('cancelling an unknown order answers 404', async () => {
+  const res = await cancel('ord_nope');
+  assert.equal(res.status, 404);
+});
+
+test('a paid order answers 409 and stays paid, with its stock taken', async () => {
+  const stock = await stockOf('croissant');
+  const order = await newOrder(2);
+  await sendEvent('payment.succeeded', order);
+
+  const res = await cancel(order.id);
+  assert.equal(res.status, 409);
+  assert.equal((await readOrder(order.id)).status, 'paid');
+  assert.equal(await stockOf('croissant'), stock - 2);
+});
+
+test('a refunded order answers 409 and stays refunded', async () => {
+  const order = await newOrder(1);
+  await sendEvent('payment.succeeded', order);
+  await sendEvent('payment.refunded', order);
+
+  const res = await cancel(order.id);
+  assert.equal(res.status, 409);
+  assert.equal((await readOrder(order.id)).status, 'refunded');
+});
+
+test('GET on the cancel route does not cancel', async () => {
+  const order = await newOrder(1);
+  const res = await fetch(`${base}/orders/${order.id}/cancel`);
+  assert.equal(res.status, 404);
+  assert.equal((await readOrder(order.id)).status, 'pending');
+});
