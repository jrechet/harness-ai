+// PayFlux delivers "at least once": the same event can come back hours later,
+// even after a 200 (incident of 2026-03-14). Each handler below must leave the
+// database untouched when it is replayed, and the answer is still a 200.
+
+// The stock leaves when the order is paid, not when it is created.
+function moveStock(db, order, direction) {
+  for (const item of order.items) {
+    const product = db.products.find((p) => p.id === item.productId);
+    if (product) product.stock += direction * item.quantity;
+  }
+}
+
+function paymentSucceeded(db, order, event) {
+  // 'refunded' too: a late replay of the payment must not undo the refund
+  if (order.status === 'paid' || order.status === 'refunded') return false;
+  order.status = 'paid';
+  order.paidAt = new Date().toISOString();
+  order.paymentId = event.data.paymentId;
+  moveStock(db, order, -1);
+  return true;
+}
+
+function paymentRefunded(db, order) {
+  if (order.status === 'refunded') return false;
+  // only a paid order took stock: if the refund overtakes the payment event,
+  // there is nothing to give back
+  if (order.status === 'paid') moveStock(db, order, 1);
+  order.status = 'refunded';
+  order.refundedAt = new Date().toISOString();
+  return true;
+}
+
+const handlers = {
+  'payment.succeeded': paymentSucceeded,
+  'payment.refunded': paymentRefunded,
+};
