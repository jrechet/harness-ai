@@ -16,13 +16,27 @@ type Server struct{ svc *app.Service }
 
 func NewServer(svc *app.Service) *Server { return &Server{svc: svc} }
 
+type route struct {
+	pattern string
+	handler http.HandlerFunc
+}
+
+// routes is the single list of endpoints. TestWriteRoutesRequireIdempotencyKey
+// walks it: every non-GET route must reject a request without Idempotency-Key.
+func (s *Server) routes() []route {
+	return []route{
+		{"GET /healthz", func(w http.ResponseWriter, _ *http.Request) { w.WriteHeader(http.StatusNoContent) }},
+		{"POST /accounts", s.openAccount},
+		{"GET /accounts/{id}", s.getAccount},
+		{"POST /transfers", s.createTransfer},
+		{"GET /transfers/quote", s.quote},	}
+}
+
 func (s *Server) Handler() http.Handler {
 	mux := http.NewServeMux()
-	mux.HandleFunc("GET /healthz", func(w http.ResponseWriter, _ *http.Request) { w.WriteHeader(http.StatusNoContent) })
-	mux.HandleFunc("POST /accounts", s.openAccount)
-	mux.HandleFunc("GET /accounts/{id}", s.getAccount)
-	mux.HandleFunc("POST /transfers", s.createTransfer)
-	mux.HandleFunc("GET /transfers/quote", s.quote)
+	for _, r := range s.routes() {
+		mux.HandleFunc(r.pattern, r.handler)
+	}
 	return mux
 }
 
