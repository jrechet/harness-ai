@@ -0,0 +1,84 @@
+package app_test
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"example.test/ledger/internal/app"
+	"example.test/ledger/internal/domain"
+)
+
+func TestDepositCreditsTheAccount(t *testing.T) {
+	svc, _ := newService(t, map[string]int64{"alice": 1000})
+	account, err := svc.Deposit(context.Background(), app.DepositCommand{IdempotencyKey: "d1", Account: "alice", AmountCents: 500, Currency: "EUR"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if account.Balance.Cents() != 1500 || balance(t, svc, "alice") != 1500 {
+		t.Fatalf("returned %d cents, stored %d, want 1500", account.Balance.Cents(), balance(t, svc, "alice"))
+	}
+}
+
+func TestReplayedDepositCreditsOnce(t *testing.T) {
+	svc, _ := newService(t, map[string]int64{"alice": 1000})
+	cmd := app.DepositCommand{IdempotencyKey: "d1", Account: "alice", AmountCents: 500, Currency: "EUR"}
+	for range 2 {
+		account, err := svc.Deposit(context.Background(), cmd)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if account.Balance.Cents() != 1500 {
+			t.Fatalf("returned %d cents, want 1500", account.Balance.Cents())
+		}
+	}
+	if got := balance(t, svc, "alice"); got != 1500 {
+		t.Fatalf("alice has %d cents, want 1500", got)
+	}
+}
+
+func TestDepositIsRejected(t *testing.T) {
+	cases := map[string]struct {
+		cmd  app.DepositCommand
+		want error
+	}{
+		"missing key":     {app.DepositCommand{Account: "alice", AmountCents: 500, Currency: "EUR"}, app.ErrMissingIdempotencyKey},
+		"unknown account": {app.DepositCommand{IdempotencyKey: "d1", Account: "nobody", AmountCents: 500, Currency: "EUR"}, domain.ErrAccountNotFound},
+		"zero amount":     {app.DepositCommand{IdempotencyKey: "d1", Account: "alice", AmountCents: 0, Currency: "EUR"}, domain.ErrZeroAmount},
+		"negative amount": {app.DepositCommand{IdempotencyKey: "d1", Account: "alice", AmountCents: -1, Currency: "EUR"}, domain.ErrNegativeAmount},
+		"other currency":  {app.DepositCommand{IdempotencyKey: "d1", Account: "alice", AmountCents: 500, Currency: "USD"}, domain.ErrCurrencyMismatch},
+	}
+	for name, c := range cases {
+		t.Run(name, func(t *testing.T) {
+			svc, _ := newService(t, map[string]int64{"alice": 1000})
+			if _, err := svc.Deposit(context.Background(), c.cmd); !errors.Is(err, c.want) {
+				t.Fatalf("got %v, want %v", err, c.want)
+			}
+			if got := balance(t, svc, "alice"); got != 1000 {
+				t.Fatalf("a rejected deposit changed the balance to %d", got)
+			}
+		})
+	}
+}
+
+func TestSameDepositKeyWithAnotherRequestIsAConflict(t *testing.T) {
+	svc, _ := newService(t, map[string]int64{"alice": 1000, "bob": 0})
+	cmd := app.DepositCommand{IdempotencyKey: "d1", Account: "alice", AmountCents: 500, Currency: "EUR"}
+	if _, err := svc.Deposit(context.Background(), cmd); err != nil {
+		t.Fatal(err)
+	}
+	others := map[string]app.DepositCommand{
+		"other amount":  {IdempotencyKey: "d1", Account: "alice", AmountCents: 501, Currency: "EUR"},
+		"other account": {IdempotencyKey: "d1", Account: "bob", AmountCents: 500, Currency: "EUR"},
+	}
+	for name, other := range others {
+		t.Run(name, func(t *testing.T) {
+			if _, err := svc.Deposit(context.Background(), other); !errors.Is(err, app.ErrIdempotencyConflict) {
+				t.Fatalf("got %v", err)
+			}
+		})
+	}
+	if balance(t, svc, "alice") != 1500 || balance(t, svc, "bob") != 0 {
+		t.Fatal("a conflicting request changed a balance")
+	}
+}
