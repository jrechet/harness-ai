@@ -0,0 +1,30 @@
+package domain
+
+import "time"
+
+// DepositID identifies a deposit.
+type DepositID string
+
+// Deposit is the record of money that entered the ledger from outside.
+type Deposit struct {
+	ID             DepositID
+	Account        AccountID
+	Amount         Money
+	IdempotencyKey string
+	CreatedAt      time.Time
+}
+
+// ReceiveDeposit credits an account with money coming from outside, or
+// changes nothing. Every check happens before the balance is touched.
+func ReceiveDeposit(to *Account, amount Money) error {
+	if amount.IsZero() {
+		return ErrZeroAmount
+	}
+	if to.Frozen {
+		return ErrAccountFrozen
+	}
+	if amount.Currency() != to.Balance.Currency() {
+		return ErrCurrencyMismatch
+	}
+	return to.Credit(amount)
+}
