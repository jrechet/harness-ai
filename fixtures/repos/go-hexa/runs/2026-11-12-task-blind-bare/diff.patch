+-- Argent entré dans le registre depuis l'extérieur (POST /accounts/{id}/deposits).
+-- Comme pour les virements, la base refuse deux dépôts portant la même clé
+-- (docs/adr/0003-cle-d-idempotence.md).
+CREATE TABLE IF NOT EXISTS deposits (
+    id              TEXT PRIMARY KEY,
+    account_id      TEXT        NOT NULL REFERENCES accounts (id),
+    amount_cents    BIGINT      NOT NULL CHECK (amount_cents > 0),
+    currency        CHAR(3)     NOT NULL,
+    idempotency_key TEXT        NOT NULL,
+    created_at      TIMESTAMPTZ NOT NULL
+);
+CREATE UNIQUE INDEX IF NOT EXISTS deposits_idempotency_key_uniq ON deposits (idempotency_key);
