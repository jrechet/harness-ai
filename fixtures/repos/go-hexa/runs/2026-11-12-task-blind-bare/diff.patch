diff --git a/internal/app/deposit.go b/internal/app/deposit.go
new file mode 100644
index 0000000..1cb85bf
--- /dev/null
+++ b/internal/app/deposit.go
@@ -0,0 +1,74 @@
+package app
+
+import (
+	"context"
+
+	"example.test/ledger/internal/domain"
+)
+
+// DepositCommand is the input of Deposit.
+type DepositCommand struct {
+	IdempotencyKey string
+	Account        string
+	AmountCents    int64
+	Currency       string
+}
+
+// Deposit credits an account with money from outside, once per idempotency
+// key, and returns the account. A replay of the same request credits nothing
+// and returns the account as it is now; the same key with another request is
+// a conflict. See docs/adr/0003-cle-d-idempotence.md.
+func (s *Service) Deposit(ctx context.Context, cmd DepositCommand) (*domain.Account, error) {
+	if cmd.IdempotencyKey == "" {
+		return nil, ErrMissingIdempotencyKey
+	}
+	amount, err := domain.NewMoney(cmd.AmountCents, cmd.Currency)
+	if err != nil {
+		return nil, err
+	}
+	var result *domain.Account
+	err = s.uow.Do(ctx, func(tx Tx) error {
+		// The lookup and the write share one transaction (postmortem 2026-04).
+		previous, err := tx.Deposits().FindByIdempotencyKey(ctx, cmd.IdempotencyKey)
+		if err != nil {
+			return err
+		}
+		if previous != nil && !sameDeposit(previous, cmd, amount) {
+			return ErrIdempotencyConflict
+		}
+		account, err := tx.Accounts().Get(ctx, domain.AccountID(cmd.Account))
+		if err != nil {
+			return err
+		}
+		result = account
+		if previous != nil {
+			return nil
+		}
+		return s.recordDeposit(ctx, tx, account, amount, cmd.IdempotencyKey)
+	})
+	if err != nil {
+		return nil, err
+	}
+	return result, nil
+}
+
+func (s *Service) recordDeposit(ctx context.Context, tx Tx, account *domain.Account, amount domain.Money, key string) error {
+	if err := domain.ReceiveDeposit(account, amount); err != nil {
+		return err
+	}
+	deposit := &domain.Deposit{
+		ID:             domain.DepositID(s.ids.NewID()),
+		Account:        account.ID,
+		Amount:         amount,
+		IdempotencyKey: key,
+		CreatedAt:      s.clock.Now(),
+	}
+	if err := tx.Accounts().Save(ctx, account); err != nil {
+		return err
+	}
+	return tx.Deposits().Save(ctx, deposit)
+}
+
+func sameDeposit(d *domain.Deposit, cmd DepositCommand, amount domain.Money) bool {
+	return string(d.Account) == cmd.Account && d.Amount == amount
+}
