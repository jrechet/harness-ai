+++ b/internal/domain/deposit.go
@@ -0,0 +1,23 @@
+package domain
+
+import "time"
+
+// DepositID identifies a deposit.
+type DepositID string
+
+// Deposit is the record of money that entered an account from outside the ledger.
+type Deposit struct {
+	ID             DepositID
+	Account        AccountID
+	Amount         Money
+	IdempotencyKey string
+	CreatedAt      time.Time
+}
+
+// Receive credits an account with money coming from outside, or changes nothing.
+func Receive(account *Account, amount Money) error {
+	if amount.IsZero() {
+		return ErrZeroAmount
+	}
+	return account.Credit(amount)
+}
