index 0000000..d48732d
--- /dev/null
+++ b/internal/app/deposit.go
@@ -0,0 +1,68 @@
+package app
+
+import (
+	"context"
+
+	"example.test/ledger/internal/domain"
+)
+
+// DepositCommand is the input of Deposit.
+type DepositCommand struct {
+	IdempotencyKey string
+	Account        string
+	AmountCents    int64
+	Currency       string
+}
+
+// Deposit credits an account from outside the ledger, once per idempotency key.
+// A replay of the same request credits nothing and returns the account as it
+// is now; the same key with another request is a conflict.
+func (s *Service) Deposit(ctx context.Context, cmd DepositCommand) (*domain.Account, error) {
+	if cmd.IdempotencyKey == "" {
+		return nil, ErrMissingIdempotencyKey
+	}
+	amount, err := domain.NewMoney(cmd.AmountCents, cmd.Currency)
+	if err != nil {
+		return nil, err
+	}
+	var result *domain.Account
+	err = s.uow.Do(ctx, func(tx Tx) error {
+		// Same transaction for the lookup and the write: ADR 0003.
+		previous, err := tx.Deposits().FindByIdempotencyKey(ctx, cmd.IdempotencyKey)
+		if err != nil {
+			return err
+		}
+		if previous != nil && !sameDeposit(previous, cmd, amount) {
+			return ErrIdempotencyConflict
+		}
+		account, err := tx.Accounts().Get(ctx, domain.AccountID(cmd.Account))
+		if err != nil {
+			return err
+		}
+		result = account
+		if previous != nil {
+			return nil
+		}
+		if err := domain.Receive(account, amount); err != nil {
+			return err
+		}
+		if err := tx.Accounts().Save(ctx, account); err != nil {
+			return err
+		}
+		return tx.Deposits().Save(ctx, &domain.Deposit{
+			ID:             domain.DepositID(s.ids.NewID()),
+			Account:        account.ID,
+			Amount:         amount,
+			IdempotencyKey: cmd.IdempotencyKey,
+			CreatedAt:      s.clock.Now(),
+		})
+	})
+	if err != nil {
+		return nil, err
+	}
+	return result, nil
+}
+
+func sameDeposit(d *domain.Deposit, cmd DepositCommand, amount domain.Money) bool {
+	return string(d.Account) == cmd.Account && d.Amount == amount
+}
