 ## Base de données
 - `make migrate` applique tous les fichiers de `migrations/` sur la base désignée par `DATABASE_URL`.
-- `make reset-db` **supprime tout le schéma** de la base désignée par `DATABASE_URL`, puis rejoue les migrations. La cible ne regarde pas de quelle base il s'agit. Le 3 février 2026, elle a été lancée avec l'URL de staging restée dans un terminal : deux jours de jeux de données QA perdus.
+- `make reset-db` **supprime tout le schéma** de la base désignée par `DATABASE_URL`, puis rejoue les migrations. Le 3 février 2026, elle a été lancée avec l'URL de staging restée dans un terminal : deux jours de jeux de données QA perdus.
+- Depuis novembre 2026, `make migrate` et `make reset-db` appellent d'abord `tools/localdb` : ils refusent (exit 1, sans appeler `psql`) toute base dont l'hôte n'est pas `localhost`, une adresse de loopback ou un socket Unix (`PGHOST` compris). Il n'y a pas d'échappatoire : staging et production passent par `deploy.yml`.
 - Une migration appliquée en staging ou en production ne se modifie plus. On ajoute un fichier, numéro suivant.
 - En staging et en production, seules les migrations passées par `deploy.yml` sont appliquées. Personne ne lance `make migrate` à la main sur ces bases.
 
diff --git a/tools/localdb/main.go b/tools/localdb/main.go
new file mode 100644
index 0000000..91151f0
--- /dev/null
+++ b/tools/localdb/main.go
@@ -0,0 +1,107 @@
+// Command localdb fails unless DATABASE_URL designates the developer's own
+// local PostgreSQL. `make migrate` and `make reset-db` call it before psql:
+// reset-db drops the whole schema without looking at the target, and on
+// 2026-02-03 it ran against staging and destroyed two days of QA data
+// (docs/exploitation.md). Staging and production are only migrated by
+// deploy.yml, which calls psql directly, so there is no override.
+//
+//	go run ./tools/localdb   # exit 0, or 1 with the offending host
+//
+// Local means: localhost, 127.0.0.1 (any 127.x), ::1, or a Unix socket
+// (empty host, or a host starting with "/"). An empty host falls back to
+// PGHOST / PGHOSTADDR, as psql does.
+package main
+
+import (
+	"fmt"
+	"net"
+	"net/url"
+	"os"
+	"strings"
+)
+
+// Check returns nil when every host targeted by dsn is local. getenv supplies
+// PGHOST and PGHOSTADDR, which psql uses when the DSN names no host.
+func Check(dsn string, getenv func(string) string) error {
+	dsn = strings.TrimSpace(dsn)
+	if dsn == "" {
+		return fmt.Errorf("DATABASE_URL is empty")
+	}
+	hosts, err := targets(dsn)
+	if err != nil {
+		return err
+	}
+	if len(hosts) == 0 {
+		for _, k := range []string{"PGHOSTADDR", "PGHOST"} {
+			if v := getenv(k); v != "" {
+				hosts = splitHosts(v)
+				break
+			}
+		}
+	}
+	for _, h := range hosts {
+		if !isLocal(h) {
+			return fmt.Errorf("host %q is not local", h)
+		}
+	}
+	return nil
+}
+
+// targets lists the hosts named by a URL or a keyword/value connection string.
+func targets(dsn string) ([]string, error) {
+	if strings.HasPrefix(dsn, "postgres://") || strings.HasPrefix(dsn, "postgresql://") {
+		u, err := url.Parse(dsn)
+		if err != nil {
+			return nil, fmt.Errorf("cannot parse DATABASE_URL: %v", err)
+		}
+		q := u.Query()
+		// Query parameters take precedence over the authority, as in libpq.
+		for _, k := range []string{"hostaddr", "host"} {
+			if v := q.Get(k); v != "" {
+				return splitHosts(v), nil
+			}
+		}
+		return splitHosts(u.Host), nil
+	}
+	if strings.Contains(dsn, "=") {
+		var hosts []string
+		for _, f := range strings.Fields(dsn) {
+			k, v, ok := strings.Cut(f, "=")
+			if ok && (k == "host" || k == "hostaddr") {
+				hosts = append(hosts, splitHosts(strings.Trim(v, "'"))...)
+			}
+		}
+		return hosts, nil
+	}
+	return nil, fmt.Errorf("DATABASE_URL is neither a postgres:// URL nor a key=value string")
+}
+
+func splitHosts(s string) []string {
+	var hosts []string
+	for _, h := range strings.Split(s, ",") {
+		h = strings.TrimSpace(h)
+		if h == "" {
+			continue
+		}
+		if hh, _, err := net.SplitHostPort(h); err == nil {
+			h = hh
+		}
+		hosts = append(hosts, strings.Trim(h, "[]"))
+	}
+	return hosts
+}
+
+func isLocal(h string) bool {
+	if strings.HasPrefix(h, "/") || strings.EqualFold(h, "localhost") {
+		return true
+	}
+	ip := net.ParseIP(h)
+	return ip != nil && ip.IsLoopback()
+}
+
+func main() {
+	if err := Check(os.Getenv("DATABASE_URL"), os.Getenv); err != nil {
+		fmt.Fprintf(os.Stderr, "localdb: %v; make migrate and make reset-db only run on your own local database (docs/exploitation.md)\n", err)
+		os.Exit(1)
+	}
+}
