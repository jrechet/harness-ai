+package domain
+
+import (
+	"errors"
+	"math"
+	"testing"
+)
+
+func TestReceiveCreditsTheAccount(t *testing.T) {
+	a := account(t, "a", 1000, "EUR")
+	amount, _ := NewMoney(500, "EUR")
+	if err := Receive(a, amount); err != nil {
+		t.Fatal(err)
+	}
+	if a.Balance.Cents() != 1500 {
+		t.Fatalf("balance: %s", a.Balance)
+	}
+}
+
+func TestReceiveChangesNothingWhenItFails(t *testing.T) {
+	money := func(cents int64, currency string) Money {
+		m, err := NewMoney(cents, currency)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return m
+	}
+	frozen := account(t, "f", 1000, "EUR")
+	frozen.Frozen = true
+	cases := map[string]struct {
+		account *Account
+		amount  Money
+		want    error
+	}{
+		"zero amount":      {account(t, "a", 1000, "EUR"), money(0, "EUR"), ErrZeroAmount},
+		"other currency":   {account(t, "a", 1000, "EUR"), money(500, "USD"), ErrCurrencyMismatch},
+		"frozen account":   {frozen, money(500, "EUR"), ErrAccountFrozen},
+		"balance overflow": {account(t, "a", math.MaxInt64, "EUR"), money(1, "EUR"), ErrAmountTooLarge},
+	}
+	for name, c := range cases {
+		t.Run(name, func(t *testing.T) {
+			before := c.account.Balance
+			if err := Receive(c.account, c.amount); !errors.Is(err, c.want) {
+				t.Fatalf("got %v, want %v", err, c.want)
+			}
+			if c.account.Balance != before {
+				t.Fatal("a failed deposit changed the balance")
+			}
+		})
+	}
+}
