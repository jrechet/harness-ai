+		found = d
+		return err
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if found == nil || found.Account != a.ID || found.Amount != amount {
+		t.Fatalf("got %+v", found)
+	}
+	// migrations/0004: the database refuses a second deposit with the same key.
+	err = store.Do(ctx, func(tx app.Tx) error {
