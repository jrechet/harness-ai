+	// FindByIdempotencyKey returns nil, nil when no deposit carries the key.
+	FindByIdempotencyKey(ctx context.Context, key string) (*domain.Deposit, error)
+	Save(ctx context.Context, d *domain.Deposit) error
+}
+
 // Tx gives access to the repositories of one transaction.
 type Tx interface {
 	Accounts() AccountRepository
 	Transfers() TransferRepository
+	Deposits() DepositRepository
 }
 
 // UnitOfWork runs fn in one transaction: everything it wrote is committed
diff --git a/internal/domain/deposit.go b/internal/domain/deposit.go
new file mode 100644
index 0000000..12fee93
--- /dev/null
+++ b/internal/domain/deposit.go
@@ -0,0 +1,30 @@
+package domain
+
+import "time"
+
+// DepositID identifies a deposit.
+type DepositID string
+
+// Deposit is the record of money that entered an account from outside the ledger.
+type Deposit struct {
+	ID             DepositID
+	Account        AccountID
+	Amount         Money
+	IdempotencyKey string
+	CreatedAt      time.Time
+}
+
+// ReceiveDeposit credits account with amount, or changes nothing.
+// Every check happens before the balance is touched.
+func ReceiveDeposit(account *Account, amount Money) error {
+	if amount.IsZero() {
+		return ErrZeroAmount
+	}
+	if account.Frozen {
+		return ErrAccountFrozen
+	}
+	if amount.Currency() != account.Balance.Currency() {
+		return ErrCurrencyMismatch
+	}
+	return account.Credit(amount)
+}
diff --git a/internal/domain/deposit_test.go b/internal/domain/deposit_test.go
new file mode 100644
