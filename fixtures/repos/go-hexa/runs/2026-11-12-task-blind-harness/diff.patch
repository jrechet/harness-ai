@@ -0,0 +1,101 @@
+package app_test
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"example.test/ledger/internal/app"
+	"example.test/ledger/internal/domain"
+)
+
+func TestDepositRequiresAnIdempotencyKey(t *testing.T) {
+	svc, _ := newService(t, map[string]int64{"alice": 0})
+	_, err := svc.Deposit(context.Background(), app.DepositCommand{Account: "alice", AmountCents: 500, Currency: "EUR"})
+	if !errors.Is(err, app.ErrMissingIdempotencyKey) {
+		t.Fatalf("got %v", err)
+	}
+}
+
+func TestDepositCreditsTheAccount(t *testing.T) {
+	svc, _ := newService(t, map[string]int64{"alice": 100})
+	cmd := app.DepositCommand{IdempotencyKey: "k1", Account: "alice", AmountCents: 500, Currency: "EUR"}
+	result, err := svc.Deposit(context.Background(), cmd)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if result.Replayed || result.Account.Balance.Cents() != 600 {
+		t.Fatalf("got replayed=%v balance=%s", result.Replayed, result.Account.Balance)
+	}
+	if got := balance(t, svc, "alice"); got != 600 {
+		t.Fatalf("alice has %d cents, want 600", got)
+	}
+}
+
+func TestReplayedDepositCreditsOnce(t *testing.T) {
+	svc, _ := newService(t, map[string]int64{"alice": 100})
+	cmd := app.DepositCommand{IdempotencyKey: "k1", Account: "alice", AmountCents: 500, Currency: "EUR"}
+	if _, err := svc.Deposit(context.Background(), cmd); err != nil {
+		t.Fatal(err)
+	}
+	second, err := svc.Deposit(context.Background(), cmd)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !second.Replayed {
+		t.Fatal("the replay was not flagged as such")
+	}
+	if got := balance(t, svc, "alice"); got != 600 {
+		t.Fatalf("alice has %d cents, want 600", got)
+	}
+}
+
+func TestDepositSameKeyWithAnotherRequestIsAConflict(t *testing.T) {
+	cases := map[string]app.DepositCommand{
+		"other amount":  {IdempotencyKey: "k1", Account: "alice", AmountCents: 501, Currency: "EUR"},
+		"other account": {IdempotencyKey: "k1", Account: "bob", AmountCents: 500, Currency: "EUR"},
+	}
+	for name, replay := range cases {
+		t.Run(name, func(t *testing.T) {
+			svc, _ := newService(t, map[string]int64{"alice": 0, "bob": 0})
+			first := app.DepositCommand{IdempotencyKey: "k1", Account: "alice", AmountCents: 500, Currency: "EUR"}
+			if _, err := svc.Deposit(context.Background(), first); err != nil {
+				t.Fatal(err)
+			}
+			if _, err := svc.Deposit(context.Background(), replay); !errors.Is(err, app.ErrIdempotencyConflict) {
+				t.Fatalf("got %v", err)
+			}
+			if balance(t, svc, "alice") != 500 || balance(t, svc, "bob") != 0 {
+				t.Fatal("a conflicting deposit changed a balance")
+			}
+		})
+	}
+}
+
+func TestRejectedDepositLeavesTheBalanceUntouched(t *testing.T) {
+	cases := map[string]struct {
+		cmd  app.DepositCommand
+		want error
+	}{
+		"unknown account": {app.DepositCommand{IdempotencyKey: "k1", Account: "nobody", AmountCents: 500, Currency: "EUR"}, domain.ErrAccountNotFound},
+		"zero amount":     {app.DepositCommand{IdempotencyKey: "k1", Account: "alice", AmountCents: 0, Currency: "EUR"}, domain.ErrZeroAmount},
+		"other currency":  {app.DepositCommand{IdempotencyKey: "k1", Account: "alice", AmountCents: 500, Currency: "USD"}, domain.ErrCurrencyMismatch},
+		"negative amount": {app.DepositCommand{IdempotencyKey: "k1", Account: "alice", AmountCents: -500, Currency: "EUR"}, domain.ErrNegativeAmount},
+	}
+	for name, c := range cases {
+		t.Run(name, func(t *testing.T) {
+			svc, _ := newService(t, map[string]int64{"alice": 100})
+			if _, err := svc.Deposit(context.Background(), c.cmd); !errors.Is(err, c.want) {
+				t.Fatalf("got %v, want %v", err, c.want)
+			}
+			if got := balance(t, svc, "alice"); got != 100 {
+				t.Fatalf("alice has %d cents, want 100", got)
+			}
+			// A rejected request leaves its key free for a corrected one.
+			fixed := app.DepositCommand{IdempotencyKey: "k1", Account: "alice", AmountCents: 1, Currency: "EUR"}
+			if _, err := svc.Deposit(context.Background(), fixed); err != nil {
+				t.Fatalf("the key was burnt by a rejected request: %v", err)
+			}
+		})
+	}
+}
