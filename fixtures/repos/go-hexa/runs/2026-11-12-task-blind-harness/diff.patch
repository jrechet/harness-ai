+type depositRepo struct{ sql *sql.Tx }
+
+func (r depositRepo) FindByIdempotencyKey(ctx context.Context, key string) (*domain.Deposit, error) {
+	var (
+		d         domain.Deposit
+		id        string
+		accountID string
+		cents     int64
+		currency  string
+	)
+	row := r.sql.QueryRowContext(ctx,
+		`SELECT id, account_id, amount_cents, currency, created_at
+		 FROM deposits WHERE idempotency_key = $1`, key)
+	if err := row.Scan(&id, &accountID, &cents, &currency, &d.CreatedAt); err != nil {
+		if errors.Is(err, sql.ErrNoRows) {
+			return nil, nil
+		}
+		return nil, err
+	}
+	amount, err := domain.NewMoney(cents, currency)
+	if err != nil {
+		return nil, err
+	}
+	d.ID, d.Account, d.Amount, d.IdempotencyKey = domain.DepositID(id), domain.AccountID(accountID), amount, key
+	return &d, nil
+}
+
+func (r depositRepo) Save(ctx context.Context, d *domain.Deposit) error {
+	_, err := r.sql.ExecContext(ctx,
+		`INSERT INTO deposits (id, account_id, amount_cents, currency, idempotency_key, created_at)
+		 VALUES ($1, $2, $3, $4, $5, $6)`,
+		string(d.ID), string(d.Account), d.Amount.Cents(), d.Amount.Currency(), d.IdempotencyKey, d.CreatedAt)
+	return err
+}
