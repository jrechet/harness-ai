diff --git a/internal/app/deposit.go b/internal/app/deposit.go
new file mode 100644
index 0000000..b4df0d3
--- /dev/null
+++ b/internal/app/deposit.go
@@ -0,0 +1,77 @@
+package app
+
+import (
+	"context"
+
+	"example.test/ledger/internal/domain"
+)
+
+// DepositCommand is the input of Deposit.
+type DepositCommand struct {
+	IdempotencyKey string
+	Account        string
+	AmountCents    int64
+	Currency       string
+}
+
+// DepositResult is the account after the deposit. Replayed is true when the
+// idempotency key had already been used for this same request: nothing was
+// credited this time and Account is the account as it stands now.
+type DepositResult struct {
+	Account  *domain.Account
+	Replayed bool
+}
+
+// Deposit credits an account from outside the ledger, once per idempotency key.
+// The same key with another request is a conflict.
+func (s *Service) Deposit(ctx context.Context, cmd DepositCommand) (*DepositResult, error) {
+	if cmd.IdempotencyKey == "" {
+		return nil, ErrMissingIdempotencyKey
+	}
+	amount, err := domain.NewMoney(cmd.AmountCents, cmd.Currency)
+	if err != nil {
+		return nil, err
+	}
+	var result *DepositResult
+	err = s.uow.Do(ctx, func(tx Tx) error {
+		// The lookup and the write share one transaction, see
+		// docs/postmortems/2026-04-double-debit.md.
+		previous, err := tx.Deposits().FindByIdempotencyKey(ctx, cmd.IdempotencyKey)
+		if err != nil {
+			return err
+		}
+		if previous != nil && (string(previous.Account) != cmd.Account || previous.Amount != amount) {
+			return ErrIdempotencyConflict
+		}
+		account, err := tx.Accounts().Get(ctx, domain.AccountID(cmd.Account))
+		if err != nil {
+			return err
+		}
+		if previous != nil {
+			result = &DepositResult{Account: account, Replayed: true}
+			return nil
+		}
+		if err := domain.ReceiveDeposit(account, amount); err != nil {
+			return err
+		}
+		deposit := &domain.Deposit{
+			ID:             domain.DepositID(s.ids.NewID()),
+			Account:        account.ID,
+			Amount:         amount,
+			IdempotencyKey: cmd.IdempotencyKey,
+			CreatedAt:      s.clock.Now(),
+		}
+		if err := tx.Accounts().Save(ctx, account); err != nil {
+			return err
+		}
+		if err := tx.Deposits().Save(ctx, deposit); err != nil {
+			return err
+		}
+		result = &DepositResult{Account: account}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return result, nil
+}
