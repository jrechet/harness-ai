@@ -0,0 +1,47 @@
+package domain
+
+import (
+	"errors"
+	"testing"
+)
+
+func TestReceiveDepositCreditsTheAccount(t *testing.T) {
+	a := account(t, "a", 100, "EUR")
+	amount, _ := NewMoney(500, "EUR")
+	if err := ReceiveDeposit(a, amount); err != nil {
+		t.Fatal(err)
+	}
+	if a.Balance.Cents() != 600 {
+		t.Fatalf("balance: %s", a.Balance)
+	}
+}
+
+func TestReceiveDepositChangesNothingWhenItFails(t *testing.T) {
+	frozen := account(t, "f", 100, "EUR")
+	frozen.Frozen = true
+	cases := map[string]struct {
+		account  *Account
+		cents    int64
+		currency string
+		want     error
+	}{
+		"zero amount":    {account(t, "a", 100, "EUR"), 0, "EUR", ErrZeroAmount},
+		"other currency": {account(t, "a", 100, "EUR"), 500, "USD", ErrCurrencyMismatch},
+		"frozen account": {frozen, 500, "EUR", ErrAccountFrozen},
+	}
+	for name, c := range cases {
+		t.Run(name, func(t *testing.T) {
+			amount, err := NewMoney(c.cents, c.currency)
+			if err != nil {
+				t.Fatal(err)
+			}
+			before := c.account.Balance
+			if err := ReceiveDeposit(c.account, amount); !errors.Is(err, c.want) {
+				t.Fatalf("got %v, want %v", err, c.want)
+			}
+			if c.account.Balance != before {
+				t.Fatal("a failed deposit changed the balance")
+			}
+		})
+	}
+}
