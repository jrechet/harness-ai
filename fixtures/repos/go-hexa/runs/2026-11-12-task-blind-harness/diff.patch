+	a, _ := domain.OpenAccount("it-deposit-1", "integration", "EUR")
+	amount, _ := domain.NewMoney(500, "EUR")
+	key := "it-deposit-key-" + time.Now().Format(time.RFC3339Nano)
+	deposit := &domain.Deposit{ID: domain.DepositID(key), Account: a.ID, Amount: amount, IdempotencyKey: key, CreatedAt: time.Now().UTC()}
+	err = store.Do(ctx, func(tx app.Tx) error {
+		if err := tx.Accounts().Save(ctx, a); err != nil {
