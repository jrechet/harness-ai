+	var body struct {
+		AmountCents int64  `json:"amount_cents"`
+		Currency    string `json:"currency"`
+	}
+	if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+		writeError(w, http.StatusBadRequest, "invalid_body", "amount_cents must be an integer")
+		return
+	}
+	account, replayed, err := s.svc.Deposit(r.Context(), app.DepositCommand{
+		IdempotencyKey: r.Header.Get("Idempotency-Key"),
+		Account:        r.PathValue("id"),
+		AmountCents:    body.AmountCents,
+		Currency:       body.Currency,
+	})
+	if err != nil {
+		writeDomainError(w, err)
+		return
+	}
+	if replayed {
+		// The mobile app reads this header so as not to show a confirmation twice.
+		w.Header().Set("Idempotency-Replayed", "true")
+	}
+	writeJSON(w, http.StatusCreated, toAccountBody(account))
+}
