@@ -0,0 +1,15 @@
+package domain
+
+import "time"
+
+// DepositID identifies a deposit.
+type DepositID string
+
+// Deposit is the record of money that entered an account from outside the ledger.
+type Deposit struct {
+	ID             DepositID
+	Account        AccountID
+	Amount         Money
+	IdempotencyKey string
+	CreatedAt      time.Time
+}
