+type depositRepo struct{ sql *sql.Tx }
+
+func (r depositRepo) FindByIdempotencyKey(ctx context.Context, key string) (*domain.Deposit, error) {
+	var (
+		d           domain.Deposit
+		id, account string
+		cents       int64
+		currency    string
+	)
+	row := r.sql.QueryRowContext(ctx,
+		`SELECT id, account, amount_cents, currency, created_at FROM deposits WHERE idempotency_key = $1`, key)
+	if err := row.Scan(&id, &account, &cents, &currency, &d.CreatedAt); err != nil {
+		if errors.Is(err, sql.ErrNoRows) {
+			return nil, nil
+		}
+		return nil, err
+	}
+	amount, err := domain.NewMoney(cents, currency)
+	if err != nil {
+		return nil, err
+	}
+	d.ID, d.Account, d.Amount, d.IdempotencyKey = domain.DepositID(id), domain.AccountID(account), amount, key
+	return &d, nil
+}
+
+func (r depositRepo) Save(ctx context.Context, d *domain.Deposit) error {
+	_, err := r.sql.ExecContext(ctx,
+		`INSERT INTO deposits (id, account, amount_cents, currency, idempotency_key, created_at)
+		 VALUES ($1, $2, $3, $4, $5, $6)`,
+		string(d.ID), string(d.Account), d.Amount.Cents(), d.Amount.Currency(), d.IdempotencyKey, d.CreatedAt)
+	return err
+}
diff --git a/internal/app/deposit.go b/internal/app/deposit.go
new file mode 100644
index 0000000..0cc08e3
--- /dev/null
+++ b/internal/app/deposit.go
@@ -0,0 +1,67 @@
+package app
+
+import (
+	"context"
+
+	"example.test/ledger/internal/domain"
+)
+
+// DepositCommand is the input of Deposit.
+type DepositCommand struct {
+	IdempotencyKey string
+	Account        string
+	AmountCents    int64
+	Currency       string
+}
+
+// Deposit credits an account once per idempotency key. A replay of the same
+// request returns the account as it is, and says so; the same key with another
+// request is a conflict. The key is looked up in the transaction that writes.
+func (s *Service) Deposit(ctx context.Context, cmd DepositCommand) (account *domain.Account, replayed bool, err error) {
+	if cmd.IdempotencyKey == "" {
+		return nil, false, ErrMissingIdempotencyKey
+	}
+	amount, err := domain.NewMoney(cmd.AmountCents, cmd.Currency)
+	if err != nil {
+		return nil, false, err
+	}
+	if amount.IsZero() {
+		return nil, false, domain.ErrZeroAmount
+	}
+	var result *domain.Account
+	err = s.uow.Do(ctx, func(tx Tx) error {
+		found, err := tx.Accounts().Get(ctx, domain.AccountID(cmd.Account))
+		if err != nil {
+			return err
+		}
+		previous, err := tx.Deposits().FindByIdempotencyKey(ctx, cmd.IdempotencyKey)
+		if err != nil {
+			return err
+		}
+		if previous != nil {
+			if previous.Account != found.ID || previous.Amount != amount {
+				return ErrIdempotencyConflict
+			}
+			result, replayed = found, true
+			return nil
+		}
+		if err := found.Credit(amount); err != nil {
+			return err
+		}
+		if err := tx.Accounts().Save(ctx, found); err != nil {
+			return err
+		}
+		result = found
+		return tx.Deposits().Save(ctx, &domain.Deposit{
+			ID:             domain.DepositID(s.ids.NewID()),
+			Account:        found.ID,
+			Amount:         amount,
+			IdempotencyKey: cmd.IdempotencyKey,
+			CreatedAt:      s.clock.Now(),
+		})
+	})
+	if err != nil {
+		return nil, false, err
+	}
+	return result, replayed, nil
+}
diff --git a/internal/app/deposit_test.go b/internal/app/deposit_test.go
new file mode 100644
index 0000000..660e66b
--- /dev/null
+++ b/internal/app/deposit_test.go
@@ -0,0 +1,59 @@
+package app_test
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"example.test/ledger/internal/app"
+	"example.test/ledger/internal/domain"
+)
+
+func TestDepositRequiresAnIdempotencyKey(t *testing.T) {
+	svc, _ := newService(t, map[string]int64{"alice": 0})
+	_, _, err := svc.Deposit(context.Background(), app.DepositCommand{Account: "alice", AmountCents: 500, Currency: "EUR"})
+	if !errors.Is(err, app.ErrMissingIdempotencyKey) {
+		t.Fatalf("got %v", err)
+	}
+}
+
+func TestReplayedDepositCreditsOnce(t *testing.T) {
+	svc, _ := newService(t, map[string]int64{"alice": 100})
+	cmd := app.DepositCommand{IdempotencyKey: "d1", Account: "alice", AmountCents: 500, Currency: "EUR"}
+	for attempt, want := range []bool{false, true} {
+		_, replayed, err := svc.Deposit(context.Background(), cmd)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if replayed != want {
+			t.Fatalf("attempt %d: replayed is %v, want %v", attempt+1, replayed, want)
+		}
+	}
+	if got := balance(t, svc, "alice"); got != 600 {
+		t.Fatalf("alice has %d cents, want 600", got)
+	}
+}
+
+func TestDepositKeyReusedForAnotherAmountIsAConflict(t *testing.T) {
+	svc, _ := newService(t, map[string]int64{"alice": 0})
+	cmd := app.DepositCommand{IdempotencyKey: "d1", Account: "alice", AmountCents: 500, Currency: "EUR"}
+	if _, _, err := svc.Deposit(context.Background(), cmd); err != nil {
+		t.Fatal(err)
+	}
+	cmd.AmountCents = 501
+	if _, _, err := svc.Deposit(context.Background(), cmd); !errors.Is(err, app.ErrIdempotencyConflict) {
+		t.Fatalf("got %v", err)
+	}
+}
+
+func TestDepositRejectsZeroAndForeignCurrency(t *testing.T) {
+	svc, _ := newService(t, map[string]int64{"alice": 0})
+	zero := app.DepositCommand{IdempotencyKey: "d1", Account: "alice", AmountCents: 0, Currency: "EUR"}
+	if _, _, err := svc.Deposit(context.Background(), zero); !errors.Is(err, domain.ErrZeroAmount) {
+		t.Fatalf("got %v", err)
+	}
+	usd := app.DepositCommand{IdempotencyKey: "d2", Account: "alice", AmountCents: 5, Currency: "USD"}
+	if _, _, err := svc.Deposit(context.Background(), usd); !errors.Is(err, domain.ErrCurrencyMismatch) {
+		t.Fatalf("got %v", err)
+	}
+}
