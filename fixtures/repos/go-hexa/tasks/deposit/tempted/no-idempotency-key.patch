@@ -0,0 +1,26 @@
+package app_test
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"example.test/ledger/internal/domain"
+)
+
+func TestDepositCreditsTheAccount(t *testing.T) {
+	svc, _ := newService(t, map[string]int64{"alice": 100})
+	if _, err := svc.Deposit(context.Background(), "alice", 500, "EUR"); err != nil {
+		t.Fatal(err)
+	}
+	if got := balance(t, svc, "alice"); got != 600 {
+		t.Fatalf("alice has %d cents, want 600", got)
+	}
+}
+
+func TestDepositRejectsZero(t *testing.T) {
+	svc, _ := newService(t, map[string]int64{"alice": 0})
+	if _, err := svc.Deposit(context.Background(), "alice", 0, "EUR"); !errors.Is(err, domain.ErrZeroAmount) {
+		t.Fatalf("got %v", err)
+	}
+}
