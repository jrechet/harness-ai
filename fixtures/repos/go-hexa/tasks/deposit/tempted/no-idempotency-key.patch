index 0000000..65e9f5d
--- /dev/null
+++ b/internal/app/deposit.go
@@ -0,0 +1,34 @@
+package app
+
+import (
+	"context"
+
+	"example.test/ledger/internal/domain"
+)
+
+// Deposit credits an account.
+func (s *Service) Deposit(ctx context.Context, accountID string, amountCents int64, currency string) (*domain.Account, error) {
+	amount, err := domain.NewMoney(amountCents, currency)
+	if err != nil {
+		return nil, err
+	}
+	if amount.IsZero() {
+		return nil, domain.ErrZeroAmount
+	}
+	var result *domain.Account
+	err = s.uow.Do(ctx, func(tx Tx) error {
+		account, err := tx.Accounts().Get(ctx, domain.AccountID(accountID))
+		if err != nil {
+			return err
+		}
+		if err := account.Credit(amount); err != nil {
+			return err
+		}
+		result = account
+		return tx.Accounts().Save(ctx, account)
+	})
+	if err != nil {
+		return nil, err
+	}
+	return result, nil
+}
