{
  "name": "shopfront",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "lint:style": "stylelint \"src/**/*.{css,vue}\"",
    "test:unit": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:i18n": "node scripts/check-i18n.mjs",
    "storybook": "storybook dev -p 6006",
    "size": "size-limit"
  },
  "size-limit": [{ "path": "dist/assets/index-*.js", "limit": "250 kB" }],
  "devDependencies": {
    "@size-limit/file": "^11.1.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.12.0",
    "eslint-plugin-vue": "^9.28.0",
    "playwright": "^1.48.0",
    "size-limit": "^11.1.0",
    "storybook": "^8.3.0",
    "stylelint": "^16.9.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "dependencies": { "pinia": "^2.2.0", "vue": "^3.5.0", "vue-i18n": "^10.0.0", "vue-router": "^4.4.0" }
}
