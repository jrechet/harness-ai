+{% extends "base.html" %}
+
+{% block title %}Import people: {{ session.course.title }}{% endblock %}
+
+{% block content %}
+<h1>Import people: {{ session.course.title }}</h1>
+<p>{{ session.starts_at|date:"l j F Y, H:i" }}, {{ session.location }}, {{ session.capacity }} seats.</p>
+
+{% if result %}
+<section class="import-result">
+  <h2>Import summary</h2>
+  <ul>
+    <li>{{ result.enrolled }} row{{ result.enrolled|pluralize }} enrolled{% if result.waitlisted %}, {{ result.waitlisted }} of them on the waiting list{% endif %}.</li>
+    <li>{{ result.skipped }} row{{ result.skipped|pluralize }} skipped: address already enrolled in this session.</li>
+  </ul>
+  <p>No e-mail was sent to the imported people.</p>
+</section>
+{% endif %}
+
+<p>
+  UTF-8 CSV file, first line <code>email,full_name</code>, then one person per line.
+  An address already enrolled is skipped. At most {{ max_rows }} rows; one line in error and nothing is imported.
+  No e-mail is sent.
+</p>
+<form method="post" enctype="multipart/form-data">
+  {% csrf_token %}
+  {{ form.as_p }}
+  <button type="submit">Import</button>
+</form>
+
+<p><a href="{% url 'enrollments:roster' session.pk %}">Roster</a></p>
+{% endblock %}
