+@staff_member_required
+def import_enrollments(request, pk: int):
+    """Enrolls the people listed in a CSV file sent by a client company. No e-mail leaves."""
+    session = get_object_or_404(Session.objects.select_related("course"), pk=pk)
+    result = None
+    if request.method == "POST":
+        form = EnrollmentImportForm(request.POST, request.FILES)
+        if form.is_valid():
+            try:
+                result = services.import_enrollments(session, form.cleaned_data["file"], imported_by=request.user)
+            except services.SessionClosed:
+                form.add_error(None, "Les inscriptions à cette session sont closes : rien n'a été importé.")
+            except services.TooManyRows as exc:
+                form.add_error("file", f"Le fichier dépasse {exc.limit} lignes : rien n'a été importé.")
+            else:
+                form = EnrollmentImportForm()
+    else:
+        form = EnrollmentImportForm()
+    return render(
+        request,
+        "enrollments/import.html",
+        {"session": session, "form": form, "result": result, "max_rows": settings.CURSUS_IMPORT_MAX_ROWS},
+    )
 
 
