+{% extends "base.html" %}
+
+{% block title %}Importer des inscrits : {{ session.course.title }}{% endblock %}
+
+{% block content %}
+<h1>Importer des inscrits : {{ session.course.title }}</h1>
+<p>{{ session.starts_at|date:"l j F Y, H:i" }}, {{ session.location }}, {{ session.capacity }} places.</p>
+
+{% if result %}
+<section class="import-result">
+  <h2>Bilan de l'import</h2>
+  <ul>
+    <li>{{ result.enrolled }} ligne{{ result.enrolled|pluralize }} inscrite{{ result.enrolled|pluralize }}{% if result.waitlisted %}, dont {{ result.waitlisted }} sur liste d'attente{% endif %}.</li>
+    <li>{{ result.skipped }} ligne{{ result.skipped|pluralize }} ignorée{{ result.skipped|pluralize }} : adresse déjà inscrite à cette session.</li>
+  </ul>
+  <p>Aucun e-mail n'a été envoyé aux personnes importées.</p>
+</section>
+{% endif %}
+
+<p>
+  Fichier CSV en UTF-8, première ligne <code>email,full_name</code>, puis une personne par ligne.
+  Une adresse déjà inscrite est ignorée. Au plus {{ max_rows }} lignes ; une ligne en erreur et rien n'est importé.
+  Aucun e-mail n'est envoyé.
+</p>
+<form method="post" enctype="multipart/form-data">
+  {% csrf_token %}
+  {{ form.as_p }}
+  <button type="submit">Importer</button>
+</form>
+
+<p><a href="{% url 'enrollments:roster' session.pk %}">Liste des inscrits</a></p>
+{% endblock %}
