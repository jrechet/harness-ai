+import codecs
+import csv
+
 from django import forms
+from django.conf import settings
+from django.core.exceptions import ValidationError
+from django.core.validators import validate_email
+
+from .services import ImportRow
+
+IMPORT_HEADER = ["email", "full_name"]
+FULL_NAME_MAX_LENGTH = 200
+MAX_REPORTED_ERRORS = 10
 
 
 class EnrollmentForm(forms.Form):
-    full_name = forms.CharField(label="Nom et prénom", max_length=200)
+    full_name = forms.CharField(label="Nom et prénom", max_length=FULL_NAME_MAX_LENGTH)
     email = forms.EmailField(label="Adresse e-mail")
+
+
+class EnrollmentImportForm(forms.Form):
+    """Reads a UTF-8 CSV file with the header `email,full_name`. The file is accepted whole or
+    refused whole: one bad line, or more lines than `settings.CURSUS_IMPORT_MAX_ROWS`, and nothing
+    is imported. `cleaned_data["file"]` is the list of `ImportRow`."""
+
+    file = forms.FileField(label="Fichier CSV (UTF-8, en-tête email,full_name)")
+
+    def clean_file(self) -> list[ImportRow]:
+        limit = settings.CURSUS_IMPORT_MAX_ROWS
+        # utf-8-sig also reads the byte order mark that spreadsheet programs put in front.
+        lines = codecs.iterdecode(self.cleaned_data["file"], "utf-8-sig")
+        reader = csv.reader(lines)
+        rows, errors, count = [], [], 0
+        try:
+            header = next(reader, None)
+            if header is None or [cell.strip().lower() for cell in header] != IMPORT_HEADER:
+                raise ValidationError("La première ligne doit être l'en-tête « email,full_name ».")
+            for cells in reader:
+                if not any(cell.strip() for cell in cells):
+                    continue
+                count += 1
+                if count > limit:
+                    raise ValidationError(
+                        f"Le fichier dépasse {limit} lignes : rien n'a été importé. Découpez-le en plusieurs fichiers."
+                    )
+                if error := self._check(cells):
+                    errors.append(f"Ligne {reader.line_num} : {error}")
+                    continue
+                rows.append(ImportRow(email=cells[0].strip(), full_name=cells[1].strip()))
+        except UnicodeDecodeError:
+            raise ValidationError("Le fichier n'est pas en UTF-8.")
+        except csv.Error as exc:
+            raise ValidationError(f"Ligne {reader.line_num} : le fichier n'est pas un CSV lisible ({exc}).")
+        if errors:
+            shown = errors[:MAX_REPORTED_ERRORS]
+            if len(errors) > MAX_REPORTED_ERRORS:
+                shown.append(f"… et {len(errors) - MAX_REPORTED_ERRORS} autre(s) ligne(s) en erreur.")
+            raise ValidationError(["Rien n'a été importé."] + shown)
+        if not rows:
+            raise ValidationError("Le fichier ne contient aucune ligne à importer.")
+        return rows
+
+    @staticmethod
+    def _check(cells: list[str]) -> str | None:
+        if len(cells) != len(IMPORT_HEADER):
+            return f"{len(IMPORT_HEADER)} colonnes attendues, {len(cells)} trouvées."
+        email, full_name = (cell.strip() for cell in cells)
+        try:
+            validate_email(email)
+        except ValidationError:
+            return f"adresse e-mail invalide « {email} »."
+        if not full_name:
+            return "nom manquant."
+        if len(full_name) > FULL_NAME_MAX_LENGTH:
+            return f"nom de plus de {FULL_NAME_MAX_LENGTH} caractères."
+        return None
