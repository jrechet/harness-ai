 """The business rules of an enrollment: seats, waiting list, cancellation. Views and admin actions
 call these functions; they hold no rule of their own (docs/adr/0001)."""
+from collections.abc import Iterable
+from dataclasses import dataclass
 from functools import partial
 
+from django.conf import settings
 from django.db import transaction
 from django.utils import timezone
 
@@ -23,6 +26,26 @@ class SessionClosed(EnrollmentError):
     pass
 
 
+class TooManyRows(EnrollmentError):
+    def __init__(self, count: int, limit: int):
+        super().__init__(count, limit)
+        self.count = count
+        self.limit = limit
+
+
+@dataclass(frozen=True)
+class ImportRow:
+    email: str
+    full_name: str
+
+
+@dataclass(frozen=True)
+class ImportResult:
+    enrolled: int  # rows that created an enrollment, the waitlisted ones included
+    waitlisted: int  # of those, the ones past the last seat
+    skipped: int  # rows whose address was already enrolled, before or earlier in the file
+
+
 def enroll(session: Session, *, email: str, full_name: str) -> Enrollment:
     """Enrolls one person: confirmed while a seat is left, on the waiting list after that.
     The e-mail leaves once the transaction has committed."""
@@ -44,6 +67,53 @@ def enroll(session: Session, *, email: str, full_name: str) -> Enrollment:
     return enrollment
 
 
+def import_enrollments(session: Session, rows: Iterable[ImportRow], *, imported_by) -> ImportResult:
+    """Enrolls a list of people at once, as sent by a client company, and records who imported them.
+
+    Seats go in file order, confirmed while one is left, on the waiting list after that. An address
+    already enrolled in the session, or met earlier in the file, is skipped. All or nothing: one
+    transaction, the session locked once, and more than `settings.CURSUS_IMPORT_MAX_ROWS` rows are
+    refused before anything is written.
+
+    Sends no e-mail: bulk work never sends one per row (docs/postmortems/2024-03-bulk-confirmations.md).
+    If the people must be told, the training department does it itself, in one go."""
+    rows = list(rows)
+    limit = settings.CURSUS_IMPORT_MAX_ROWS
+    if len(rows) > limit:
+        raise TooManyRows(len(rows), limit)
+    now = timezone.now()
+    enrolled = waitlisted = 0
+    with transaction.atomic():
+        # Same lock as enroll(): a web enrollment arriving during the import waits for it.
+        locked = Session.objects.select_for_update().get(pk=session.pk)
+        if locked.has_started:
+            raise SessionClosed(locked.pk)
+        active = locked.enrollments.exclude(status=Enrollment.Status.CANCELLED)
+        known = set(active.values_list("email", flat=True))
+        seats_taken = active.filter(status=Enrollment.Status.CONFIRMED).count()
+        for row in rows:
+            email = row.email.strip().lower()
+            if email in known:
+                continue
+            known.add(email)
+            if seats_taken < locked.capacity:
+                status = Enrollment.Status.CONFIRMED
+                seats_taken += 1
+            else:
+                status = Enrollment.Status.WAITLISTED
+                waitlisted += 1
+            Enrollment.objects.create(
+                session=locked,
+                email=email,
+                full_name=row.full_name.strip(),
+                status=status,
+                imported_by=imported_by,
+                imported_at=now,
+            )
+            enrolled += 1
+    return ImportResult(enrolled=enrolled, waitlisted=waitlisted, skipped=len(rows) - enrolled)
+
+
 def cancel(enrollment: Enrollment) -> Enrollment | None:
     """Cancels an enrollment. A freed seat goes to the head of the waiting list: the promoted
     enrollment is returned, None when nobody was waiting."""
