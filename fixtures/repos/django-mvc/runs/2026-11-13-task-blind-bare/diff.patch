@@ -0,0 +1,35 @@
+{% extends "base.html" %}
+
+{% block title %}Import enrollments: {{ session.course.title }}{% endblock %}
+
+{% block content %}
+<h1>Import enrollments: {{ session.course.title }}</h1>
+<p>{{ session.starts_at|date:"l j F Y, H:i" }}, {{ session.location }}, {{ session.capacity }} seats.</p>
+
+{% if report %}
+<section class="report">
+  <h2>Import summary</h2>
+  <ul>
+    <li>{{ report.enrolled|length }} row{{ report.enrolled|length|pluralize }} enrolled{% if report.waitlisted %}, {{ report.waitlisted }} of them on the waiting list{% endif %}.</li>
+    <li>{{ report.skipped|length }} row{{ report.skipped|length|pluralize }} skipped (address already enrolled){% if report.skipped %}: {{ report.skipped|join:", " }}{% endif %}.</li>
+  </ul>
+  <p>No e-mail was sent to the imported people.</p>
+</section>
+{% endif %}
+
+{% if errors %}
+<section class="errors">
+  <h2>File refused, nothing was imported</h2>
+  <ul>{% for error in errors %}<li>{{ error }}</li>{% endfor %}</ul>
+</section>
+{% endif %}
+
+<form method="post" enctype="multipart/form-data">
+  {% csrf_token %}
+  {{ form.as_p }}
+  <p>One line per person, for example <code>ana.morel@example.com,Ana Morel</code>. An address already enrolled in the session is skipped. Beyond the seats, people go on the waiting list. No e-mail is sent.</p>
+  <button type="submit">Import</button>
+</form>
+
+<p><a href="{% url 'enrollments:roster' session.pk %}">Roster</a></p>
+{% endblock %}
