@@ -0,0 +1,35 @@
+{% extends "base.html" %}
+
+{% block title %}Importer des inscriptions : {{ session.course.title }}{% endblock %}
+
+{% block content %}
+<h1>Importer des inscriptions : {{ session.course.title }}</h1>
+<p>{{ session.starts_at|date:"l j F Y, H:i" }}, {{ session.location }}, {{ session.capacity }} places.</p>
+
+{% if report %}
+<section class="report">
+  <h2>Bilan de l'import</h2>
+  <ul>
+    <li>{{ report.enrolled|length }} ligne{{ report.enrolled|length|pluralize }} inscrite{{ report.enrolled|length|pluralize }}{% if report.waitlisted %}, dont {{ report.waitlisted }} sur liste d'attente{% endif %}.</li>
+    <li>{{ report.skipped|length }} ligne{{ report.skipped|length|pluralize }} ignorée{{ report.skipped|length|pluralize }} (adresse déjà inscrite){% if report.skipped %} : {{ report.skipped|join:", " }}{% endif %}.</li>
+  </ul>
+  <p>Aucun e-mail n'a été envoyé aux personnes importées.</p>
+</section>
+{% endif %}
+
+{% if errors %}
+<section class="errors">
+  <h2>Fichier refusé, rien n'a été importé</h2>
+  <ul>{% for error in errors %}<li>{{ error }}</li>{% endfor %}</ul>
+</section>
+{% endif %}
+
+<form method="post" enctype="multipart/form-data">
+  {% csrf_token %}
+  {{ form.as_p }}
+  <p>Une ligne par personne, par exemple <code>ana.morel@example.com,Ana Morel</code>. Une adresse déjà inscrite à la session est ignorée. Au-delà des places, les personnes vont sur liste d'attente. Aucun e-mail n'est envoyé.</p>
+  <button type="submit">Importer</button>
+</form>
+
+<p><a href="{% url 'enrollments:roster' session.pk %}">Liste des inscrits</a></p>
+{% endblock %}
