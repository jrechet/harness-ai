+IMPORT_HEADER = ["email", "full_name"]
+
+
+class InvalidImportFile(EnrollmentError):
+    """The file cannot be imported as it is; `errors` says why, line by line where it can."""
+
+    def __init__(self, errors: list[str]):
+        super().__init__(errors)
+        self.errors = errors
+
+
+@dataclass
+class ImportReport:
+    enrolled: list[Enrollment] = field(default_factory=list)
+    skipped: list[str] = field(default_factory=list)  # the addresses already enrolled
+
+    @property
+    def waitlisted(self) -> int:
+        return sum(e.status == Enrollment.Status.WAITLISTED for e in self.enrolled)
+
+
+def parse_import_file(data: bytes) -> list[tuple[str, str]]:
+    """Reads a UTF-8 CSV headed `email,full_name` into (email, full_name) pairs. Every line is
+    checked before anything is written: one bad line refuses the whole file."""
+    try:
+        text = data.decode("utf-8-sig")  # a spreadsheet often starts the file with a BOM
+    except UnicodeDecodeError:
+        raise InvalidImportFile(["Le fichier n'est pas encodé en UTF-8."])
+    reader = csv.reader(io.StringIO(text, newline=""))
+    try:
+        header = next(reader, None)
+        if header is None or [column.strip().lower() for column in header] != IMPORT_HEADER:
+            raise InvalidImportFile(["La première ligne doit être l'en-tête « email,full_name »."])
+        rows, errors = [], []
+        max_name = Enrollment._meta.get_field("full_name").max_length
+        for row in reader:
+            line = reader.line_num
+            if not any(cell.strip() for cell in row):
+                continue
+            if len(row) != 2:
+                errors.append(f"Ligne {line} : deux colonnes attendues, {len(row)} trouvée(s).")
+                continue
+            email, full_name = (cell.strip() for cell in row)
+            try:
+                validate_email(email)
+            except ValidationError:
+                errors.append(f"Ligne {line} : adresse e-mail invalide « {email} ».")
+                continue
+            if not full_name:
+                errors.append(f"Ligne {line} : nom manquant.")
+            elif len(full_name) > max_name:
+                errors.append(f"Ligne {line} : nom de plus de {max_name} caractères.")
+            else:
+                rows.append((email, full_name))
+    except csv.Error as error:
+        raise InvalidImportFile([f"Ligne {reader.line_num} : CSV illisible ({error})."])
+    if errors:
+        raise InvalidImportFile(errors)
+    if not rows:
+        raise InvalidImportFile(["Le fichier ne contient aucune inscription."])
+    return rows
+
+
+def import_enrollments(session: Session, rows: list[tuple[str, str]], *, imported_by) -> ImportReport:
+    """Enrolls every row through `enroll()`, so seats and waiting list follow the usual rules.
+    An address already enrolled, before the import or earlier in the file, is skipped.
+    Nobody is e-mailed. All or nothing: the whole file goes in one transaction."""
+    report = ImportReport()
+    with transaction.atomic():
+        for email, full_name in rows:
+            try:
+                enrollment = enroll(session, email=email, full_name=full_name, notify=False, imported_by=imported_by)
+            except AlreadyEnrolled:
+                report.skipped.append(email.lower())
+            else:
+                report.enrolled.append(enrollment)
+    return report
