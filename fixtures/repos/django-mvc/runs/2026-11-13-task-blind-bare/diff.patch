@@ -0,0 +1,176 @@
+from django.contrib.auth import get_user_model
+from django.core import mail
+from django.core.files.uploadedfile import SimpleUploadedFile
+from django.test import TestCase
+from django.urls import reverse
+
+from catalog.tests.test_pages import fill, make_session
+from enrollments import services
+from enrollments.models import Enrollment
+
+
+def csv_bytes(*lines, header="email,full_name"):
+    return "\n".join([header, *lines]).encode("utf-8")
+
+
+class ParseImportFileTests(TestCase):
+    def test_reads_the_rows(self):
+        rows = services.parse_import_file(csv_bytes("ana@example.test,Ana Morel", " bob@example.test , Bob Lenoir "))
+        self.assertEqual(rows, [("ana@example.test", "Ana Morel"), ("bob@example.test", "Bob Lenoir")])
+
+    def test_accepts_a_byte_order_mark_and_accents(self):
+        data = "﻿email,full_name\nzoe@example.test,Zoé Bérénice\n".encode("utf-8")
+        self.assertEqual(services.parse_import_file(data), [("zoe@example.test", "Zoé Bérénice")])
+
+    def test_accepts_quoted_names_with_a_comma(self):
+        rows = services.parse_import_file(csv_bytes('ana@example.test,"Morel, Ana"'))
+        self.assertEqual(rows, [("ana@example.test", "Morel, Ana")])
+
+    def test_skips_blank_lines(self):
+        self.assertEqual(len(services.parse_import_file(csv_bytes("ana@example.test,Ana", "", "  , "))), 1)
+
+    def assertRefused(self, data, fragment):
+        with self.assertRaises(services.InvalidImportFile) as raised:
+            services.parse_import_file(data)
+        self.assertTrue(any(fragment in error for error in raised.exception.errors), raised.exception.errors)
+
+    def test_refuses_another_encoding(self):
+        self.assertRefused("email,full_name\nzoe@example.test,Zoé\n".encode("latin-1"), "UTF-8")
+
+    def test_refuses_a_missing_or_wrong_header(self):
+        self.assertRefused(b"", "en-tête")
+        self.assertRefused(csv_bytes("ana@example.test,Ana", header="mail,nom"), "en-tête")
+
+    def test_every_bad_line_is_reported_with_its_number(self):
+        with self.assertRaises(services.InvalidImportFile) as raised:
+            services.parse_import_file(
+                csv_bytes("ana@example.test,Ana", "not-an-address,Bob", "cleo@example.test,", "dan@example.test")
+            )
+        self.assertEqual(
+            raised.exception.errors,
+            [
+                "Ligne 3 : adresse e-mail invalide « not-an-address ».",
+                "Ligne 4 : nom manquant.",
+                "Ligne 5 : deux colonnes attendues, 1 trouvée(s).",
+            ],
+        )
+
+    def test_refuses_a_file_without_rows(self):
+        self.assertRefused(csv_bytes(), "aucune inscription")
+
+
+class ImportEnrollmentsTests(TestCase):
+    def setUp(self):
+        self.staff = get_user_model().objects.create_user("lea", is_staff=True)
+
+    def test_enrolls_each_row_and_keeps_the_trace(self):
+        session = make_session()
+        report = services.import_enrollments(session, [("Ana@Example.test", "Ana")], imported_by=self.staff)
+        enrollment = Enrollment.objects.get()
+        self.assertEqual(report.enrolled, [enrollment])
+        self.assertEqual((enrollment.email, enrollment.status), ("ana@example.test", "confirmed"))
+        self.assertEqual(enrollment.imported_by, self.staff)
+        self.assertIsNotNone(enrollment.imported_at)
+
+    def test_skips_an_address_already_enrolled_or_repeated_in_the_file(self):
+        session = make_session()
+        fill(session, confirmed=1)  # c0@example.test
+        report = services.import_enrollments(
+            session,
+            [("c0@example.test", "Déjà là"), ("ana@example.test", "Ana"), ("ANA@example.test", "Ana bis")],
+            imported_by=self.staff,
+        )
+        self.assertEqual(len(report.enrolled), 1)
+        self.assertEqual(report.skipped, ["c0@example.test", "ana@example.test"])
+        self.assertEqual(session.enrollments.count(), 2)
+
+    def test_a_cancelled_address_is_enrolled_again(self):
+        session = make_session()
+        services.cancel(services.enroll(session, email="ana@example.test", full_name="Ana"))
+        report = services.import_enrollments(session, [("ana@example.test", "Ana")], imported_by=self.staff)
+        self.assertEqual((len(report.enrolled), report.skipped), (1, []))
+
+    def test_past_the_capacity_the_rows_go_to_the_waiting_list(self):
+        session = make_session(capacity=1)
+        rows = [("ana@example.test", "Ana"), ("bob@example.test", "Bob"), ("cleo@example.test", "Cleo")]
+        report = services.import_enrollments(session, rows, imported_by=self.staff)
+        self.assertEqual([e.status for e in report.enrolled], ["confirmed", "waitlisted", "waitlisted"])
+        self.assertEqual(report.waitlisted, 2)
+
+    def test_nobody_is_emailed(self):
+        session = make_session()
+        rows = [(f"p{n}@example.test", f"P{n}") for n in range(5)]
+        with self.captureOnCommitCallbacks(execute=True) as callbacks:
+            services.import_enrollments(session, rows, imported_by=self.staff)
+        self.assertEqual(callbacks, [])
+        self.assertEqual(mail.outbox, [])
+
+    def test_a_started_session_takes_nothing(self):
+        with self.assertRaises(services.SessionClosed):
+            services.import_enrollments(make_session(days=-1), [("ana@example.test", "Ana")], imported_by=self.staff)
+        self.assertFalse(Enrollment.objects.exists())
+
+    def test_an_enrollment_made_online_has_no_import_trace(self):
+        enrollment = services.enroll(make_session(), email="ana@example.test", full_name="Ana")
+        self.assertEqual((enrollment.imported_by, enrollment.imported_at), (None, None))
+
+
+class ImportViewTests(TestCase):
+    def setUp(self):
+        self.session = make_session(capacity=2)
+        self.url = reverse("enrollments:import", args=[self.session.pk])
+        self.staff = get_user_model().objects.create_user("lea", is_staff=True)
+
+    def upload(self, data, name="inscrits.csv"):
+        with self.captureOnCommitCallbacks(execute=True):
+            return self.client.post(self.url, {"file": SimpleUploadedFile(name, data, content_type="text/csv")})
+
+    def test_the_page_is_for_staff_only(self):
+        self.assertEqual(self.client.get(self.url).status_code, 302)
+        self.client.force_login(get_user_model().objects.create_user("visitor"))
+        self.assertEqual(self.client.get(self.url).status_code, 302)
+        self.assertEqual(self.upload(csv_bytes("ana@example.test,Ana")).status_code, 302)
+        self.assertFalse(Enrollment.objects.exists())
+
+    def test_get_shows_the_upload_form(self):
+        self.client.force_login(self.staff)
+        response = self.client.get(self.url)
+        self.assertContains(response, 'enctype="multipart/form-data"')
+        self.assertContains(response, 'name="file"')
+
+    def test_post_imports_and_shows_the_report(self):
+        fill(self.session, confirmed=1)
+        self.client.force_login(self.staff)
+        response = self.upload(
+            csv_bytes("c0@example.test,Déjà là", "ana@example.test,Ana", "bob@example.test,Bob", "ana@example.test,Ana")
+        )
+        self.assertContains(response, "2 lignes inscrites, dont 1 sur liste d'attente.")
+        self.assertContains(response, "2 lignes ignorées")
+        self.assertEqual(self.session.enrollments.filter(imported_by=self.staff).count(), 2)
+        self.assertEqual(mail.outbox, [])
+
+    def test_a_bad_file_imports_nothing_and_says_why(self):
+        self.client.force_login(self.staff)
+        response = self.upload(csv_bytes("ana@example.test,Ana", "nope,Bob"))
+        self.assertContains(response, "rien n'a été importé")
+        self.assertContains(response, "Ligne 3 : adresse e-mail invalide")
+        self.assertFalse(Enrollment.objects.exists())
+
+    def test_a_started_session_is_refused(self):
