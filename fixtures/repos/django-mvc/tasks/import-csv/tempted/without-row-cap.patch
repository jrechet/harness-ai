+{% extends "base.html" %}
+
+{% block title %}Import enrollments: {{ session.course.title }}{% endblock %}
+
+{% block content %}
+<h1>Import enrollments: {{ session.course.title }}</h1>
+<p>{{ session.starts_at|date:"l j F Y, H:i" }}, {{ session.location }}, {{ session.capacity }} seats.</p>
+
+{% if report %}
+<ul class="report">
+  <li>{{ report.enrolled }} row{{ report.enrolled|pluralize }} enrolled,
+    {{ report.waitlisted }} of them on the waiting list.</li>
+  <li>{{ report.skipped|length }} row{{ report.skipped|length|pluralize }} skipped
+    (address already enrolled){% if report.skipped %}: {{ report.skipped|join:", " }}{% endif %}.</li>
+</ul>
+<p>No e-mail was sent to the imported people.</p>
+{% endif %}
+
+<form method="post" enctype="multipart/form-data">
+  {% csrf_token %}
+  {{ form.as_p }}
+  <p>UTF-8 CSV file, header <code>email,full_name</code>.</p>
+  <button type="submit">Import</button>
+</form>
+
+<p><a href="{% url 'enrollments:roster' session.pk %}">Roster</a></p>
+{% endblock %}
