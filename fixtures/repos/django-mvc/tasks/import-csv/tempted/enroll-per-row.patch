+@staff_member_required
+def import_csv(request, pk: int):
+    session = get_object_or_404(Session.objects.select_related("course"), pk=pk)
+    form = ImportForm(request.POST or None, request.FILES or None)
+    report = None
+    if request.method == "POST" and form.is_valid():
+        report = {"enrolled": 0, "waitlisted": 0, "skipped": 0}
+        for row in form.cleaned_data["file"]:
+            try:
+                enrollment = services.enroll(session, email=row["email"], full_name=row["full_name"])
+            except services.AlreadyEnrolled:
+                report["skipped"] += 1
+                continue
+            enrollment.imported_by = request.user
+            enrollment.imported_at = timezone.now()
+            enrollment.save(update_fields=["imported_by", "imported_at"])
+            report["enrolled"] += 1
+            if enrollment.status == Enrollment.Status.WAITLISTED:
+                report["waitlisted"] += 1
+    return render(request, "enrollments/import.html", {"session": session, "form": form, "report": report})
+
