diff --git a/enrollments/tests/test_import.py b/enrollments/tests/test_import.py
new file mode 100644
index 0000000..58f3e44
--- /dev/null
+++ b/enrollments/tests/test_import.py
@@ -0,0 +1,48 @@
+from django.contrib.auth import get_user_model
+from django.core.files.uploadedfile import SimpleUploadedFile
+from django.test import TestCase
+from django.urls import reverse
+
+from catalog.tests.test_pages import fill, make_session
+from enrollments.models import Enrollment
+
+
+class ImportViewTests(TestCase):
+    def setUp(self):
+        self.session = make_session(capacity=2)
+        self.url = reverse("enrollments:import", args=[self.session.pk])
+        self.staff = get_user_model().objects.create_user("lea", is_staff=True)
+        self.client.force_login(self.staff)
+
+    def post(self, content):
+        upload = SimpleUploadedFile("inscrits.csv", content.encode(), content_type="text/csv")
+        return self.client.post(self.url, {"file": upload})
+
+    def test_import_page_is_for_staff_only(self):
+        self.client.logout()
+        self.assertEqual(self.client.get(self.url).status_code, 302)
+        self.assertEqual(self.post("email,full_name\nana@example.test,Ana\n").status_code, 302)
+        self.assertFalse(Enrollment.objects.exists())
+
+    def test_import_enrolls_each_row_and_fills_the_waiting_list(self):
+        response = self.post("email,full_name\nana@example.test,Ana\nbob@example.test,Bob\ncleo@example.test,Cleo\n")
+        self.assertContains(response, "3 lignes inscrites")
+        statuses = list(self.session.enrollments.values_list("status", flat=True))
+        self.assertEqual(statuses, ["confirmed", "confirmed", "waitlisted"])
+
+    def test_import_skips_an_address_already_enrolled_or_repeated(self):
+        fill(self.session, confirmed=1)
+        response = self.post("email,full_name\nc0@example.test,Ana\nbob@example.test,Bob\nbob@example.test,Bob\n")
+        self.assertContains(response, "2 lignes ignorées")
+        self.assertEqual(self.session.enrollments.count(), 2)
+
+    def test_import_refuses_a_file_without_the_header(self):
+        self.assertContains(self.post("ana@example.test,Ana\n"), "en-tête attendu")
+        self.assertFalse(Enrollment.objects.exists())
+
+    def test_import_records_who_and_when_and_the_roster_shows_it(self):
+        self.post("email,full_name\nana@example.test,Ana\n")
+        enrollment = self.session.enrollments.get()
+        self.assertEqual(enrollment.imported_by, self.staff)
+        self.assertIsNotNone(enrollment.imported_at)
+        self.assertContains(self.client.get(reverse("enrollments:roster", args=[self.session.pk])), "importé par lea")
