+import csv
+import io
+
 from django import forms
 
 
 class EnrollmentForm(forms.Form):
     full_name = forms.CharField(label="Full name", max_length=200)
     email = forms.EmailField(label="E-mail address")
+
+
+class ImportForm(forms.Form):
+    file = forms.FileField(label="CSV file")
+
+    def clean_file(self):
+        try:
+            text = self.cleaned_data["file"].read().decode("utf-8-sig")
+        except UnicodeDecodeError:
+            raise forms.ValidationError("The file must be encoded in UTF-8.")
+        reader = csv.DictReader(io.StringIO(text))
+        if not {"email", "full_name"} <= set(reader.fieldnames or []):
+            raise forms.ValidationError("The expected header is “email,full_name”.")
+        return [
+            {"email": (line["email"] or "").strip().lower(), "full_name": (line["full_name"] or "").strip()}
+            for line in reader
+        ]
