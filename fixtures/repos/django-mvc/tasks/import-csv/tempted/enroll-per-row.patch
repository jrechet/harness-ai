+import csv
+import io
+
 from django import forms
 
 
 class EnrollmentForm(forms.Form):
     full_name = forms.CharField(label="Nom et prénom", max_length=200)
     email = forms.EmailField(label="Adresse e-mail")
+
+
+class ImportForm(forms.Form):
+    file = forms.FileField(label="Fichier CSV")
+
+    def clean_file(self):
+        try:
+            text = self.cleaned_data["file"].read().decode("utf-8-sig")
+        except UnicodeDecodeError:
+            raise forms.ValidationError("Le fichier doit être encodé en UTF-8.")
+        reader = csv.DictReader(io.StringIO(text))
+        if not {"email", "full_name"} <= set(reader.fieldnames or []):
+            raise forms.ValidationError("L'en-tête attendu est « email,full_name ».")
+        return [
+            {"email": (line["email"] or "").strip().lower(), "full_name": (line["full_name"] or "").strip()}
+            for line in reader
+        ]
