+import csv
+import io
+
 from django import forms
+from django.core.exceptions import ValidationError
+from django.core.validators import validate_email
 
 
 class EnrollmentForm(forms.Form):
     full_name = forms.CharField(label="Nom et prénom", max_length=200)
     email = forms.EmailField(label="Adresse e-mail")
+
+
+class ImportForm(forms.Form):
+    """A CSV file with the header `email,full_name`. The cleaned value is the list of its rows."""
+
+    file = forms.FileField(label="Fichier CSV")
+
+    def clean_file(self) -> list[dict[str, str]]:
+        try:
+            text = self.cleaned_data["file"].read().decode("utf-8-sig")
+        except UnicodeDecodeError:
+            raise ValidationError("Le fichier doit être encodé en UTF-8.")
+        reader = csv.DictReader(io.StringIO(text))
+        if not {"email", "full_name"} <= set(reader.fieldnames or []):
+            raise ValidationError("L'en-tête attendu est « email,full_name ».")
+        rows = []
+        for number, line in enumerate(reader, start=2):
+            row = {"email": (line["email"] or "").strip().lower(), "full_name": (line["full_name"] or "").strip()}
+            try:
+                validate_email(row["email"])
+            except ValidationError:
+                raise ValidationError(f"Ligne {number} : adresse e-mail invalide.")
+            if not row["full_name"]:
+                raise ValidationError(f"Ligne {number} : le nom manque.")
+            rows.append(row)
+        return rows
