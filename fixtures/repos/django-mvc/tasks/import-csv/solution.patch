+{% extends "base.html" %}
+
+{% block title %}Importer des inscriptions : {{ session.course.title }}{% endblock %}
+
+{% block content %}
+<h1>Importer des inscriptions : {{ session.course.title }}</h1>
+<p>{{ session.starts_at|date:"l j F Y, H:i" }}, {{ session.location }}, {{ session.capacity }} places.</p>
+
+{% if report %}
+<ul class="report">
+  <li>{{ report.enrolled }} ligne{{ report.enrolled|pluralize }} inscrite{{ report.enrolled|pluralize }},
+    dont {{ report.waitlisted }} en liste d'attente.</li>
+  <li>{{ report.skipped|length }} ligne{{ report.skipped|length|pluralize }} ignorée{{ report.skipped|length|pluralize }}
+    (adresse déjà inscrite){% if report.skipped %} : {{ report.skipped|join:", " }}{% endif %}.</li>
+</ul>
+<p>Aucun e-mail n'a été envoyé aux personnes importées.</p>
+{% endif %}
+
+<form method="post" enctype="multipart/form-data">
+  {% csrf_token %}
+  {{ form.as_p }}
+  <p>Fichier CSV en UTF-8, en-tête <code>email,full_name</code>.</p>
+  <button type="submit">Importer</button>
+</form>
+
+<p><a href="{% url 'enrollments:roster' session.pk %}">Liste des inscrits</a></p>
+{% endblock %}
