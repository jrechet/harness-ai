--- /dev/null
+++ b/enrollments/tests/test_import.py
@@ -0,0 +1,95 @@
+from django.contrib.auth import get_user_model
+from django.core import mail
+from django.core.files.uploadedfile import SimpleUploadedFile
+from django.test import TestCase
+from django.urls import reverse
+
+from catalog.tests.test_pages import fill, make_session
+from enrollments import services
+from enrollments.models import Enrollment
+
+
+def rows(*names):
+    return [{"email": f"{name}@example.test", "full_name": name.title()} for name in names]
+
+
+class ImportEnrollmentsTests(TestCase):
+    def setUp(self):
+        self.staff = get_user_model().objects.create_user("lea", is_staff=True)
+
+    def test_import_fills_the_seats_then_the_waiting_list(self):
+        session = make_session(capacity=3)
+        fill(session, confirmed=2)
+        report = services.import_enrollments(session, rows("ana", "bob", "cleo"), imported_by=self.staff)
+        self.assertEqual((report.confirmed, report.waitlisted, report.skipped), (1, 2, []))
+        self.assertEqual(session.enrollments.filter(status="confirmed").count(), 3)
+
+    def test_import_skips_an_address_already_enrolled_or_repeated(self):
+        session = make_session()
+        services.enroll(session, email="ana@example.test", full_name="Ana")
+        report = services.import_enrollments(session, rows("ana", "bob", "bob"), imported_by=self.staff)
+        self.assertEqual(report.skipped, ["ana@example.test", "bob@example.test"])
+        self.assertEqual(session.enrollments.count(), 2)
+
+    def test_import_sends_no_email(self):
+        session = make_session(capacity=2)
+        with self.captureOnCommitCallbacks(execute=True):
+            services.import_enrollments(session, rows("ana", "bob", "cleo"), imported_by=self.staff)
+        self.assertEqual(mail.outbox, [])
+
+    def test_import_records_who_and_when(self):
+        session = make_session()
+        services.import_enrollments(session, rows("ana"), imported_by=self.staff)
+        enrollment = session.enrollments.get()
+        self.assertEqual(enrollment.imported_by, self.staff)
+        self.assertIsNotNone(enrollment.imported_at)
+
+    def test_import_into_a_started_session_enrolls_nobody(self):
+        session = make_session(days=-1)
+        with self.assertRaises(services.SessionClosed):
+            services.import_enrollments(session, rows("ana"), imported_by=self.staff)
+        self.assertFalse(Enrollment.objects.exists())
+
+    def test_import_over_the_row_cap_enrolls_nobody(self):
+        session = make_session(capacity=10)
+        with self.settings(CURSUS_IMPORT_MAX_ROWS=2):
+            with self.assertRaises(services.TooManyRows):
+                services.import_enrollments(session, rows("ana", "bob", "cleo"), imported_by=self.staff)
+            self.assertFalse(Enrollment.objects.filter(session=session).exists())
+            services.import_enrollments(session, rows("ana", "bob"), imported_by=self.staff)
+        self.assertEqual(Enrollment.objects.filter(session=session).count(), 2)
+
+
+class ImportViewTests(TestCase):
+    def setUp(self):
+        self.session = make_session(capacity=2)
+        self.url = reverse("enrollments:import", args=[self.session.pk])
+        self.client.force_login(get_user_model().objects.create_user("lea", is_staff=True))
+
+    def post(self, content):
+        upload = SimpleUploadedFile("inscrits.csv", content.encode(), content_type="text/csv")
+        return self.client.post(self.url, {"file": upload})
+
+    def test_import_page_is_for_staff_only(self):
+        self.client.logout()
+        self.assertEqual(self.client.get(self.url).status_code, 302)
+        self.assertEqual(self.post("email,full_name\nana@example.test,Ana\n").status_code, 302)
+        self.assertFalse(Enrollment.objects.exists())
+
+    def test_import_page_shows_the_report(self):
+        response = self.post("email,full_name\nana@example.test,Ana\nbob@example.test,Bob\ncleo@example.test,Cleo\nana@example.test,Ana\n")
+        self.assertContains(response, "3 lignes inscrites")
+        self.assertContains(response, "dont 1 en liste d'attente")
+        self.assertContains(response, "1 ligne ignorée")
+
+    def test_import_refuses_a_file_without_the_header(self):
+        self.assertContains(self.post("ana@example.test,Ana\n"), "en-tête attendu")
+        self.assertFalse(Enrollment.objects.exists())
+
+    def test_import_refuses_the_whole_file_on_an_invalid_address(self):
+        self.assertContains(self.post("email,full_name\nana@example.test,Ana\nnot-an-address,Bob\n"), "Ligne 3")
+        self.assertFalse(Enrollment.objects.exists())
+
+    def test_roster_tells_who_imported(self):
+        self.post("email,full_name\nana@example.test,Ana\n")
+        self.assertContains(self.client.get(reverse("enrollments:roster", args=[self.session.pk])), "importé par lea")
