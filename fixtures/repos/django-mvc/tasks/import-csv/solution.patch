+@dataclass
+class ImportReport:
+    confirmed: int = 0
+    waitlisted: int = 0
+    skipped: list[str] = field(default_factory=list)
+
+    @property
+    def enrolled(self) -> int:
+        return self.confirmed + self.waitlisted
+
+
+def import_enrollments(session: Session, rows: list[dict[str, str]], *, imported_by) -> ImportReport:
+    """Enrolls every row of a file, or none of them. Each row goes through enroll(): the seat lock
+    and the waiting list apply as they do on the site. No e-mail leaves: a bulk job never sends one
+    message per row (docs/postmortems/2024-03-confirmations-en-masse.md)."""
+    if len(rows) > settings.CURSUS_IMPORT_MAX_ROWS:
+        raise TooManyRows(len(rows))
+    report = ImportReport()
+    with transaction.atomic():
+        for row in rows:
+            try:
+                enrollment = enroll(
+                    session, email=row["email"], full_name=row["full_name"], notify=False, imported_by=imported_by
+                )
+            except AlreadyEnrolled:
+                report.skipped.append(row["email"])
+                continue
+            if enrollment.status == Enrollment.Status.CONFIRMED:
+                report.confirmed += 1
+            else:
+                report.waitlisted += 1
+    return report
+
