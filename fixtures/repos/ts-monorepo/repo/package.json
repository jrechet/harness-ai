{
  "name": "deskly",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test:shared": "node --test \"packages/shared/**/*.test.ts\"",
    "test:api": "node --test \"apps/api/**/*.test.ts\"",
    "test:web": "node --test \"apps/web/**/*.test.ts\"",
    "typecheck:shared": "tsc --noEmit -p packages/shared",
    "typecheck:api": "tsc --noEmit -p apps/api",
    "typecheck:web": "tsc --noEmit -p apps/web",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "dev:api": "node --watch apps/api/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.0"
  }
}
