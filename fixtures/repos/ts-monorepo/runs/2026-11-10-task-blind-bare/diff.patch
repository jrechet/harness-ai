diff --git a/apps/api/src/tickets/service.test.ts b/apps/api/src/tickets/service.test.ts
index e38e744..31f6c3d 100644
--- a/apps/api/src/tickets/service.test.ts
+++ b/apps/api/src/tickets/service.test.ts
@@ -33,6 +33,23 @@ test("the allowed path open, in_progress, waiting, in_progress, resolved, closed
   }
 });
 
+test("the escalation path in_progress, escalated, in_progress, escalated, resolved", () => {
+  const tickets = service();
+  const { id } = tickets.create({ title: "Printer down", requester: "ana@example.test", priority: "high" });
+  for (const status of ["in_progress", "escalated", "in_progress", "escalated", "resolved"] as const) {
+    assert.equal(tickets.changeStatus(id, status).status, status);
+  }
+});
+
+test("an escalated ticket cannot be closed without being resolved", () => {
+  const tickets = service();
+  const { id } = tickets.create({ title: "Printer down", requester: "ana@example.test", priority: "high" });
+  tickets.changeStatus(id, "in_progress");
+  tickets.changeStatus(id, "escalated");
+  assert.throws(() => tickets.changeStatus(id, "closed"), TransitionRefused);
+  assert.equal(tickets.list()[0]?.status, "escalated");
+});
+
 test("an unknown ticket", () => {
   assert.throws(() => service().changeStatus("nope", "closed"), TicketNotFound);
 });
