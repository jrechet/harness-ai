 });
 
+test("a ticket in progress can be escalated, and an escalated one goes back to work or resolves", () => {
+  const offered = (status: Ticket["status"]) =>
+    [...renderTicketList([ticket({ status })]).matchAll(/data-status="(\w+)"/g)].map((m) => m[1]).sort();
+  assert.deepEqual(offered("in_progress"), ["escalated", "resolved", "waiting"]);
+  assert.deepEqual(offered("escalated"), ["in_progress", "resolved"]);
+});
+
+test("escalated reads Escaladé, on the ticket and on the button that escalates", () => {
+  assert.match(renderTicketList([ticket({ status: "escalated" })]), /<span class="status">Escaladé<\/span>/);
+  assert.match(renderTicketList([ticket({ status: "in_progress" })]), /<button data-ticket="t1" data-status="escalated">Escaladé<\/button>/);
+});
+
 test("an empty list says so", () => {
   assert.match(renderTicketList([]), /Aucun ticket/);
 });
