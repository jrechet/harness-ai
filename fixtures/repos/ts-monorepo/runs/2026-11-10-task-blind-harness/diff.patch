+
+test("escalated is a known status: 409 from open, 200 from in_progress", async () => {
+  const created = await fetch(`${base}/tickets`, json("POST", { title: "VPN", requester: "cy@example.test" }));
+  const { id } = (await created.json()) as { id: string };
+  assert.equal((await fetch(`${base}/tickets/${id}`, json("PATCH", { status: "escalated" }))).status, 409);
+  assert.equal((await fetch(`${base}/tickets/${id}`, json("PATCH", { status: "in_progress" }))).status, 200);
+  const escalated = await fetch(`${base}/tickets/${id}`, json("PATCH", { status: "escalated" }));
+  assert.equal(escalated.status, 200);
+  assert.equal(((await escalated.json()) as { status: string }).status, "escalated");
+});
diff --git a/apps/api/src/tickets/service.test.ts b/apps/api/src/tickets/service.test.ts
index e38e744..341cc34 100644
--- a/apps/api/src/tickets/service.test.ts
+++ b/apps/api/src/tickets/service.test.ts
@@ -33,6 +33,17 @@ test("the allowed path open, in_progress, waiting, in_progress, resolved, closed
   }
 });
 
+test("escalation: only from in_progress, then back to in_progress or on to resolved", () => {
+  const tickets = service();
+  const { id } = tickets.create({ title: "Printer down", requester: "ana@example.test", priority: "high" });
+  assert.throws(() => tickets.changeStatus(id, "escalated"), TransitionRefused);
+  for (const status of ["in_progress", "escalated", "in_progress", "escalated"] as const) {
+    assert.equal(tickets.changeStatus(id, status).status, status);
+  }
+  assert.throws(() => tickets.changeStatus(id, "closed"), TransitionRefused);
+  assert.equal(tickets.changeStatus(id, "resolved").status, "resolved");
+});
+
 test("an unknown ticket", () => {
   assert.throws(() => service().changeStatus("nope", "closed"), TicketNotFound);
 });
