{
  "format": 1,
  "name": "bug",
  "kind": "bug",
  "start": "triage",
  "stop_at": "root_cause",
  "budget": {
    "dollars": 10,
    "minutes": 120
  },
  "states": {
    "triage": {
      "type": "code",
      "does": "Removes duplicates against open tickets and pull requests, checks the ticket is eligible and opens the run record",
      "survives": "restart",
      "units": "one",
      "repositories": "one",
      "writes": [
        {
          "what": "the run record",
          "key": "run-{ticket}"
        }
      ],
      "on": {
        "ticket_ready": {
          "to": "premise"
        },
        "duplicate_found": {
          "to": "done",
          "reason": "duplicate"
        },
        "not_eligible": {
          "to": "stopped",
          "reason": "not_eligible"
        }
      }
    },
    "premise": {
      "type": "agent",
      "does": "Checks the bug still reproduces on the current head and that no fix exists yet",
      "checks_premise": true,
      "survives": "restart",
      "units": "one",
      "repositories": "one",
      "weak_model": "no",
      "on": {
        "still_fails": {
          "to": "root_cause"
        },
        "already_fixed": {
          "to": "done",
          "reason": "already_fixed"
        },
        "cannot_reproduce": {
          "to": "stopped",
          "reason": "cannot_reproduce"
        }
      }
    },
    "root_cause": {
      "type": "agent",
      "does": "Finds the root cause, with its evidence and a confidence",
      "cap": 5,
      "survives": "restart",
      "units": "one",
      "repositories": "one",
      "weak_model": "no",
      "on": {
        "cause_written": {
          "to": "notify"
        }
      }
    },
    "notify": {
      "type": "code",
      "does": "Writes the root cause on the ticket and notifies the owner; stops when the confidence is low",
      "survives": "restart",
      "units": "one",
      "repositories": "one",
      "writes": [
        {
          "what": "the root cause note",
          "key": "cause-{ticket}"
        }
      ],
      "on": {
        "confident": {
          "to": "repro",
          "reaches": "root_cause"
        },
        "low_confidence": {
          "to": "stopped",
          "reason": "low_confidence"
        }
      }
    },
    "repro": {
      "type": "agent",
      "does": "Writes a failing test that reproduces the bug, then a fix plan",
      "survives": "restart",
      "units": "one",
      "repositories": "one",
      "weak_model": "no",
      "on": {
        "repro_written": {
          "to": "fix",
          "reaches": "plan"
        }
      }
    },
    "fix": {
      "type": "agent",
      "does": "Writes the smallest fix that makes the test pass",
      "survives": "restart",
      "units": "one",
      "repositories": "one",
      "weak_model": "no",
      "on": {
        "fix_written": {
          "to": "verify"
        }
      }
    },
    "verify": {
      "type": "code",
      "does": "Runs the reproducing test, many times if it is flaky, then lint, build and the suite",
      "survives": "restart",
      "units": "one",
      "repositories": "one",
      "on": {
        "verified": {
          "to": "draft_pr"
        },
        "verify_failed": {
          "to": "root_cause"
        }
      }
    },
    "draft_pr": {
      "type": "code",
      "does": "Pushes the branch and opens a draft pull request with the cause, the evidence, the test and what was tried",
      "survives": "restart",
      "units": "one",
      "repositories": "one",
      "writes": [
        {
          "what": "the branch",
          "key": "flow/{ticket}"
        },
        {
          "what": "the pull request",
          "key": "pr-{ticket}"
        }
      ],
      "on": {
        "pr_opened": {
          "to": "ci_wait",
          "reaches": "draft_pr"
        }
      }
    },
    "ci_wait": {
      "type": "wait",
      "does": "Waits for CI on the pushed commit",
      "cap": 4,
      "deadline_hours": 6,
      "on": {
        "ci_finished": {
          "to": "ci_check"
        }
      }
    },
    "ci_check": {
      "type": "code",
      "does": "Checks the CI result is for the current commit and reads it",
      "checks_premise": true,
      "survives": "restart",
      "units": "one",
      "repositories": "one",
      "on": {
        "ci_green": {
          "to": "human_review",
          "reaches": "ready_pr"
        },
        "ci_red": {
          "to": "ci_fix"
        },
        "ci_stale": {
          "to": "ci_wait"
        }
      }
    },
    "ci_fix": {
      "type": "agent",
      "does": "Fixes the CI failures and pushes the fix",
      "cap": 2,
      "survives": "restart",
      "units": "one",
      "repositories": "one",
      "weak_model": "no",
      "writes": [
        {
          "what": "the branch",
          "key": "flow/{ticket}"
        }
      ],
      "on": {
        "fix_pushed": {
          "to": "ci_wait"
        }
      }
    },
    "human_review": {
      "type": "gate",
      "does": "A maintainer reads the pull request, then merges it or closes it with one line of reason",
      "judge": "a maintainer of the repository",
      "shows": "the pull request",
      "deadline_hours": 72,
      "can_judge": "yes",
      "on": {
        "merged_by_human": {
          "to": "closure_wait",
          "reaches": "merged"
        },
        "closed_with_reason": {
          "to": "done",
          "reason": "rejected"
        }
      }
    },
    "closure_wait": {
      "type": "wait",
      "does": "Waits some days after the merge before looking at the signal again",
      "deadline_hours": 168,
      "on": {
        "closure_due": {
          "to": "closure_check"
        }
      }
    },
    "closure_check": {
      "type": "code",
      "does": "Checks the fix is the one that was merged, then looks whether the signal has stopped and records the outcome and the cost",
      "checks_premise": true,
      "survives": "restart",
      "units": "one",
      "repositories": "one",
      "writes": [
        {
          "what": "the closing note",
          "key": "close-{ticket}"
        }
      ],
      "on": {
        "signal_stopped": {
          "to": "done",
          "reason": "fixed"
        },
        "signal_continues": {
          "to": "stopped",
          "reason": "not_fixed"
        }
      }
    }
  }
}
