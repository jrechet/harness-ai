{
  "override_dir": "docs/agents",
  "budget_lines": 40,
  "plans_dir": "docs/plans",
  "qa": {"runs": 3, "diff_coverage": 80},
  "sizes": {"XS": {"files": 2, "lines": 10}, "S-M": {"files": 20, "lines": 400}},
  "phases": {
    "ticket": {"min_level": 1},
    "dev": {"min_level": 1},
    "review": {"min_level": 1},
    "qa": {"min_level": 3},
    "secu": {"min_level": 1},
    "ship": {"min_level": 3},
    "run": {"min_level": 2}
  },
  "points": {
    "definition-of-ready": {"read_by": ["ticket"], "replaceable": true, "branch": "current", "default": "points/definition-of-ready.md"},
    "definition-of-done": {"read_by": ["dev", "review"], "replaceable": true, "branch": "base", "default": "points/definition-of-done.md"},
    "review": {"read_by": ["review"], "replaceable": false, "branch": "base", "default": "points/review.md"},
    "qa": {"read_by": ["qa"], "replaceable": true, "branch": "base", "default": "points/qa.md"},
    "security": {"read_by": ["secu", "review"], "replaceable": false, "branch": "base", "default": "points/security.md"},
    "sensitive-zones": {"read_by": ["dev", "review"], "replaceable": false, "branch": "base", "default": "points/sensitive-zones.md"},
    "delivery": {"read_by": ["ship"], "replaceable": true, "branch": "base", "default": "points/delivery.md"},
    "operations": {"read_by": ["run"], "replaceable": false, "branch": "base", "default": "points/operations.md"}
  }
}
