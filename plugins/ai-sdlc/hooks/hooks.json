{
  "description": "An agent does not deliver: refuses, before they run, the commands that tag, publish or deploy.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/cli/guard_hook.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
